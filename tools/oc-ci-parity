#!/usr/bin/env bash
# oc-ci-parity — verify .github/workflows on fork main stay byte-identical to upstream.
#
# Why: fork-local CI lives ONLY on ci/* carrier branches (never main) so it can
# never ride a PR diff. Therefore anything differing under .github/workflows on
# main is either an upstream change we have not merged or fork-local leakage —
# both are findings. Run after every upstream merge/port (tools/archive/compiler.md Step 7,
# SKILL.md §Upstream relations "carrier namespace").
#
# Usage:
#   oc-ci-parity                      live compare fork <-> upstream (needs gh + net)
#   oc-ci-parity --selftest           offline canned checks (no network)
#   oc-ci-parity --maps FORK.tsv UP.tsv   compare two "path<TAB>blobsha" maps (tests)
# Env overrides: OC_FORK_REPO, OC_UPSTREAM_REPO, OC_BRANCH (default main)
# Exit: 0 identical - 4 DRIFT (listing printed) - 5 usage/input - 6 gh/api failure
set -u
_OC_LIB="$(cd "$(dirname "$0")" && pwd)/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-ci-parity" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT   # early exits — cleanup traps below supersede but also log
FORK="${OC_FORK_REPO:-leshchenko1979/opencrabs}"
UP="${OC_UPSTREAM_REPO:-adolfousier/opencrabs}"
BRANCH="${OC_BRANCH:-main}"
WF=".github/workflows/"
PROG="$(basename "$0")"

usage_rc5() {
  cat >&2 <<EOS
Usage: $PROG [--selftest | --maps FORK.tsv UP.tsv]
  (no args)      live blob comparison of $WF between
                 $FORK@$BRANCH and $UP@$BRANCH
Exit: 0 identical / 4 drift (lines prefixed DRIFT:) / 5 usage / 6 api failure
EOS
  exit 5
}

diff_maps() { # $1=fork tsv $2=upstream tsv ; prints DRIFT lines ; rc 0/4/5
  [ -r "$1" ] && [ -r "$2" ] || return 5
  awk 'NR==FNR{ if(NF>=2) f[$1]=$2; next } { if(NF>=2) u[$1]=$2 }
    END{rc=0
        for(p in u){ if(!(p in f)){printf "DRIFT: only-in-upstream %s\n",p; rc=4}
                     else if(f[p]!=u[p]){printf "DRIFT: differs           %s (%s != %s)\n",p,f[p],u[p]; rc=4} }
        for(p in f){ if(!(p in u)){printf "DRIFT: only-in-fork      %s\n",p; rc=4} }
        exit rc}' "$1" "$2"
}

fetch_map() { # $1=repo -> tsv on stdout ; rc 6 on failure
  gh api "repos/$1/git/trees/$BRANCH?recursive=1" \
     --jq ".tree[] | select(.type==\"blob\") | select(.path | startswith(\"$WF\")) | \"\(.path)\t\(.sha)\"" \
     2>/dev/null || return 6
}

do_live() {
  command -v gh >/dev/null 2>&1 || { echo "$PROG: gh not found" >&2; exit 6; }
  TMPF="$(mktemp)"; TMPU="$(mktemp)"
  trap '_rc=$?; rm -f "$TMPF" "$TMPU"; oc_log_finish "$_rc"' EXIT
  fetch_map "$FORK" >"$TMPF" || { echo "$PROG: failed to list $FORK@$BRANCH tree" >&2; exit 6; }
  fetch_map "$UP"   >"$TMPU" || { echo "$PROG: failed to list $UP@$BRANCH tree" >&2; exit 6; }
  [ -s "$TMPF" ] || { echo "$PROG: empty fork workflow map — aborting (api shape changed?)" >&2; exit 6; }
  diff_maps "$TMPF" "$TMPU"; rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "PARITY OK: $WF identical between $FORK@$BRANCH and $UP@$BRANCH ($(wc -l <"$TMPF") files)"
  fi
  exit "$rc"
}

do_selftest() {
  D="$(mktemp -d)"; trap '_rc=$?; rm -rf "$D"; oc_log_finish "$_rc"' EXIT
  printf '%s\n' ".github/workflows/a.yml	111" ".github/workflows/b.yml	222" >"$D/f1"
  printf '%s\n' ".github/workflows/a.yml	111" ".github/workflows/b.yml	222" >"$D/u1"
  printf '%s\n' ".github/workflows/a.yml	999" ".github/workflows/new.yml	777" >"$D/u2"
  pass=0; fail=0
  diff_maps "$D/f1" "$D/u1" >/dev/null 2>&1 && { pass=$((pass+1)); echo "selftest: identical maps -> 0  OK"; } || { fail=$((fail+1)); echo "selftest: identical maps FAIL"; }
  out="$(diff_maps "$D/f1" "$D/u2" 2>&1)"; rc=$?
  [ "$rc" -eq 4 ] && { pass=$((pass+1)); echo "selftest: drift maps -> 4  OK"; } || { fail=$((fail+1)); echo "selftest: drift maps FAIL (rc=$rc)"; }
  printf '%s\n' "$out" | grep -q "only-in-upstream .github/workflows/new.yml" && { pass=$((pass+1)); echo "selftest: only-in-upstream listed  OK"; } || { fail=$((fail+1)); echo "selftest: only-in-upstream FAIL"; }
  printf '%s\n' "$out" | grep -q "differs.*a.yml" && { pass=$((pass+1)); echo "selftest: differs listed  OK"; } || { fail=$((fail+1)); echo "selftest: differs FAIL"; }
  diff_maps "$D/nonexistent" "$D/u1" >/dev/null 2>&1; [ $? -eq 5 ] && { pass=$((pass+1)); echo "selftest: unreadable input -> 5  OK"; } || { fail=$((fail+1)); echo "selftest: unreadable FAIL"; }
  echo "selftest: $pass/$((pass+fail)) passed"
  [ "$fail" -eq 0 ]
}

case "${1:-}" in
  "")          do_live ;;
  --selftest)  do_selftest ;;
  --maps)      [ $# -eq 3 ] || usage_rc5; diff_maps "$2" "$3"; exit $? ;;
  *)           usage_rc5 ;;
esac
