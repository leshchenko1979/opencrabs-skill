#!/usr/bin/env bash
# =============================================================================
# oc-contributors — extract Session-Id / Issue-Ref trailers over a commit
# range and emit the DEDUPED contributor set.
#
# Replaces the Compiler's hand-rolled per-cycle ritual (extract contributors
# over <prev-swapped-sha>..<verified-headSha>, then notify each contributing
# editor). Deterministic: sorted by session, one row per distinct trailer
# value; unsigned commits are NEVER silently dropped — they aggregate under
# the literal session "(unsigned)".
#
# Usage:
#   ./tools/oc-contributors --repo <path> --range <A..B> [--json]
#   ./tools/oc-contributors --selftest
#
# Exit codes: 0 ok · 2 usage / bad range syntax · 3 git failure · 4 empty range
# Output (TSV, sorted): session <TAB> n_commits <TAB> issue_refs(CSV) <TAB> sha7s(CSV)
#         (--json wraps the same rows as [{session,commits,issues,shas}])
# =============================================================================
set -u

usage() { echo "usage: $0 --repo <path> --range <A..B> [--json] | --selftest" >&2; exit 2; }

SELFTEST=0; JSON=0; REPO="."; RANGE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="${2:-}"; shift 2 ;;
    --range) RANGE="${2:-}"; shift 2 ;;
    --json) JSON=1; shift ;;
    --selftest) SELFTEST=1; shift ;;
    *) usage ;;
  esac
done

# ---------- selftest ----------
if [ "$SELFTEST" -eq 1 ]; then
  d="$(mktemp -d)" || exit 3
  trap 'rm -rf "$d"' EXIT
  git -C "$d" init -q -b main || exit 3
  git -C "$d" config user.email t@t; git -C "$d" config user.name t
  mk() { # mk <file-content> <full-message>
    printf '%s' "$1" > "$d/f.txt"; git -C "$d" add f.txt
    printf '%s' "$2" > "$d/.msg"; git -C "$d" commit -q -F "$d/.msg"
  }
  M1='#111 fix wiring

Session-Id: aaaaaaaa-1111-2222-3333-444444444444
Issue-Ref: #100'
  M2='doc tweak, same editor

Session-Id: aaaaaaaa-1111-2222-3333-444444444444'
  M3='other lane lands too

Session-Id: bbbbbbbb-9999-8888-7777-666666666666
Issue-Ref: #101'
  mk c1 "$M1"; mk c2 "$M2"; mk c3 "$M3"
  OUT="$("$0" --repo "$d" --range main)"
  [ $? -eq 0 ] || { echo "selftest: nonzero exit" >&2; exit 1; }
  echo "$OUT" | grep -q '^aaaaaaaa-1111-2222-3333-444444444444	2	#100	' \
    || { echo "selftest: dup-session not merged" >&2; exit 1; }
  echo "$OUT" | grep -q '^bbbbbbbb-9999-8888-7777-666666666666	1	#101	' \
    || { echo "selftest: second session missing" >&2; exit 1; }
  echo "$OUT" | wc -l | grep -qx 2 \
    || { echo "selftest: unexpected row count (unsigned leak?)" >&2; exit 1; }
  echo "selftest OK"; exit 0
fi

# ---------- argument validation ----------
[ -n "$RANGE" ] || usage
case "$RANGE" in
  *..*) : ;;          # explicit A..B
  *) : ;;             # bare ref == that tip's whole history (git native); allow
esac
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $REPO" >&2; exit 3; }

N=$(git -C "$REPO" rev-list --count "$RANGE" 2>/dev/null)
rc=$?
[ $rc -eq 0 ] || { echo "bad range: $RANGE" >&2; exit 3; }
[ "$N" -gt 0 ] || { echo "empty range: $RANGE" >&2; exit 4; }

# ---------- extract ----------
TMP="$(mktemp)" || exit 3
trap 'rm -f "$TMP"' EXIT
for sha in $(git -C "$REPO" rev-list --reverse "$RANGE"); do
  body="$(git -C "$REPO" show -s --format=%B "$sha")" || exit 3
  sess="$(printf '%s\n' "$body" | sed -n 's/^Session-Id:[[:space:]]*//p' | tail -1)"
  [ -n "$sess" ] || sess="(unsigned)"
  iss="$(printf '%s\n' "$body" | sed -n 's/^Issue-Ref:[[:space:]]*//p' | tail -1 | tr -d ' ')"
  short="$(printf '%s' "$sha" | cut -c1-7)"
  printf '%s\t%s\t%s\n' "$sess" "$iss" "$short" >> "$TMP"
done

# ---------- dedup + sort ----------
DEDUP="$(awk -F'\t' '
  {
    if (!($1 in seen)) { seen[$1]=1; order[++k]=$1 }
    cnt[$1]++
    if ($2 != "" && !index(is[$1], $2)) is[$1] = is[$1] (is[$1]=="" ? "" : ",") $2
    if (!index(hs[$1], $3)) hs[$1] = hs[$1] (hs[$1]=="" ? "" : ",") $3
  }
  END { for (i=1;i<=k;i++) printf "%s\t%d\t%s\t%s\n", order[i], cnt[order[i]], is[order[i]], hs[order[i]] }
' "$TMP" | LC_ALL=C sort)"

if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$DEDUP" | jq -Rn '
    [ inputs | select(length>0) | split("\t")
    | { session: .[0]
      , commits: (.[1] | tonumber)
      , issues:  (.[2] | split(",") | map(select(length > 0)))
      , shas:    (.[3] | split(",")) } ]'
else
  printf '%s\n' "$DEDUP"
fi
exit 0
