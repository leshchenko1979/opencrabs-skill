#!/usr/bin/env bash
# =============================================================================
# oc-smoke-evidence — mechanical identity + presence evidence for a smoke verdict
# =============================================================================
# Duty-6 lens C1 (2026-08-31, incident-backed: 15+ hand-assembled evidence
# lines in state smoke-verdicts.log). Prints the boilerplate every Phase 6b
# smoke verdict needs: running daemon identity (MainPID, exe path, sha256)
# compared against the deployed markers (deployed.sha + deployed.meta.json
# artifact sha), optional strings markers, optional negative control.
#
# BEHAVIORAL JUDGMENT STAYS HUMAN — this tool produces IDENTITY evidence only.
#
# Usage: oc-smoke-evidence [--unit opencrabs-ops] [--markers m1,m2]
#                          [--negative-control <backup-binary>] [--selftest]
#                          [--append-log [<path>]]
#   --append-log [<path>] (defect #13, lane c10cd97b, 2026-09-12): appends the
#   evidence block to <path> NEWLINE-SAFELY — if the log was last written
#   without a trailing newline, that row is terminated first, so rows can
#   never glue. Appends on rc 0/1 (verdict rows are evidence either way);
#   usage/infra failures (rc 2/3) write nothing. This is the sanctioned
#   append path — a plain shell >> is what glued c10cd97b's verdict rows.
#   M2-2 (2026-09-12): <path> is OPTIONAL and defaults to the canonical ABSOLUTE
#   log ($STATE_DIR/smoke-verdicts.log). A RELATIVE path resolves against
#   STATE_DIR, never the caller's CWD — a bare `smoke-verdicts.log` used to be
#   written to whatever directory the caller happened to be in, a decoy holding
#   none of the evidence (2 rows lost). A divergent ABSOLUTE path is honoured but
#   announced LOUDLY on stderr, naming the canonical one.
#   --markers is canonical (matches oc-artifact-verify); --strings is a
#   deprecated alias kept for back-compat (E2 finding 6, v0.4.72).
# Exit:  0 IDENTITY-MATCH / 1 MISMATCH / 2 usage / 3 unit-or-proc-fail
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
_OC_LIB="$(cd "$(dirname "$0")" && pwd)/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-smoke-evidence" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

usage() { echo "usage: $0 [--unit <systemd-user-unit>] [--markers m1,m2] [--negative-control <binary>] | --selftest" >&2; exit 2; }
die() { echo "oc-smoke-evidence: $2" >&2; exit "$1"; }

append_log() { # newline-safe append (defect #13): a log left unterminated by a
               # previous writer must not glue the next row onto its last line
  local f="$1" c="$2"
  [ -n "$f" ] || return 2
  if [ -s "$f" ] && [ -n "$(tail -c 1 "$f" 2>/dev/null)" ]; then
    printf '\n' >> "$f"   # terminate the previous writer's unterminated row
  fi
  printf '%s\n' "$c" >> "$f"
}

STATE_DIR="${OC_DEPLOY_STATE_DIR:-/root/.opencrabs/profiles/ops/opencrabs-dev}"
CANON_LOG="$STATE_DIR/smoke-verdicts.log"   # M2-2: the ONLY sanctioned target
UNIT="opencrabs-ops"; MARKERS=""; NEGCTRL=""; APPEND_LOG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --unit) UNIT="${2:-}"; shift 2 ;;
    --markers|--strings) MARKERS="${2:-}"; shift 2 ;;   # --strings = deprecated alias
    --negative-control) NEGCTRL="${2:-}"; shift 2 ;;
    --append-log)
      # M2-2 (2026-09-12): a WRONG path must be unrepresentable. The canonical
      # log is absolute; a bare `smoke-verdicts.log` used to land in the CALLER'S
      # CWD -- a decoy that looks right and holds none of the evidence (2 rows
      # lost). Relative now resolves against STATE_DIR, and a bare flag means
      # "the canonical log".
      shift
      case "${1:-}" in
        ''|--*|-h) APPEND_LOG="$CANON_LOG" ;;            # bare -> canonical
        /*) APPEND_LOG="$1"; shift ;;                    # absolute -> honoured
        *)  APPEND_LOG="$STATE_DIR/$1"; shift ;;         # relative -> STATE_DIR, never CWD
      esac ;;
    --selftest)
      d="$(mktemp -d)"
      printf 'x%.0s' {1..100} > "$d/a"; cp "$d/a" "$d/b"; printf 'x%.0s' {1..100} > "$d/c"; printf 'y' >> "$d/c"
      h1="$(sha256sum "$d/a" | cut -d' ' -f1)"; h2="$(sha256sum "$d/b" | cut -d' ' -f1)"; h3="$(sha256sum "$d/c" | cut -d' ' -f1)"
      [ "$h1" = "$h2" ] && [ "$h1" != "$h3" ] || { echo "selftest: hash discrimination broken" >&2; exit 1; }
      # marker leg (v0.4.85): early marker inside a >1MB strings stream — the
      # exact shape that false-MISSING under the old strings|grep -q pipeline
      # (grep exits on match, strings eats SIGPIPE, pipefail poisons the branch)
      { printf 'OC_MARKER_PAST_PIPEBUF\n'; head -c 1048576 /dev/zero | tr '\0' 'x'; } > "$d/m"
      SB="$(strings "$d/m" 2>/dev/null)"
      grep -qF -- 'OC_MARKER_PAST_PIPEBUF' <<< "$SB" || { echo "selftest: buffered marker check failed (drain regression?)" >&2; exit 1; }
      # defect #13 (lane c10cd97b): newline-safe append. A log left WITHOUT a
      # trailing newline must not glue the next row onto its last line, and a
      # second probe keeps the same intact-line shape.
      printf 'row1-unterminated' > "$d/v.log"
      append_log "$d/v.log" "E1" && append_log "$d/v.log" "E2"
      [ "$(wc -l < "$d/v.log")" = 3 ] || { echo "selftest: append-log line count broken" >&2; exit 1; }
      grep -qF 'row1-unterminatedE1' "$d/v.log" && { echo "selftest: append glued rows" >&2; exit 1; }
      grep -qx 'row1-unterminated' "$d/v.log" || { echo "selftest: append glued row1" >&2; exit 1; }
      grep -qx 'E1' "$d/v.log" || { echo "selftest: append lost E1" >&2; exit 1; }
      grep -qx 'E2' "$d/v.log" || { echo "selftest: append lost E2" >&2; exit 1; }
      append_log "$d/v.log" "E3"
      [ "$(wc -l < "$d/v.log")" = 4 ] || { echo "selftest: second probe broke shape" >&2; exit 1; }
      grep -qF 'E2E3' "$d/v.log" && { echo "selftest: second probe glued" >&2; exit 1; }
      echo "selftest OK"; exit 0 ;;
    -h|--help) (usage); exit 0 ;;   # F-L1 (v0.4.77): --help = 0 (subshell absorbs usage's exit 2)
    *) usage ;;
  esac
done

# M2-2: never let a divergent target pass silently -- name the canonical one.
if [ -n "$APPEND_LOG" ] && [ "$APPEND_LOG" != "$CANON_LOG" ]; then
  echo "oc-smoke-evidence: NOTE -- appending to $APPEND_LOG, NOT the canonical $CANON_LOG" >&2
fi

emit_evidence() {
[ -f "$STATE_DIR/deployed.meta.json" ] || die 3 "deployed.meta.json missing in $STATE_DIR"
PID="$(systemctl --user show "$UNIT" -p MainPID --value 2>/dev/null)" || die 3 "systemctl --user show $UNIT failed"
case "$PID" in ''|0) die 3 "unit $UNIT not running (MainPID=$PID)" ;; esac
EXE="$(readlink -f "/proc/$PID/exe" 2>/dev/null)" || die 3 "cannot resolve /proc/$PID/exe"
[ -x "$EXE" ] || die 3 "exe not accessible: $EXE"

EXE_SHA="$(sha256sum "$EXE" | cut -d' ' -f1)"
SRC_SHA="$(jq -r '.sha // ""' "$STATE_DIR/deployed.meta.json")"
ART_SHA="$(jq -r '.artifact_sha256 // ""' "$STATE_DIR/deployed.meta.json")"
RUN_ID="$(jq -r '.run_id // ""' "$STATE_DIR/deployed.meta.json")"
SWAP_AT="$(jq -r '.swapped_at // ""' "$STATE_DIR/deployed.meta.json")"
DEPLOYED_SHA="$(head -1 "$STATE_DIR/deployed.sha" 2>/dev/null || echo '')"

# TSV evidence block
echo -e "pid\t$PID"
echo -e "exe_path\t$EXE"
echo -e "exe_sha256\t$EXE_SHA"
echo -e "artifact_sha256\t$ART_SHA"
echo -e "source_sha\t$SRC_SHA"
echo -e "deployed.sha\t$DEPLOYED_SHA"
echo -e "run_id\t$RUN_ID"
echo -e "swapped_at\t$SWAP_AT"

rc=0
if [ -n "$ART_SHA" ]; then
  if [ "$EXE_SHA" = "$ART_SHA" ]; then
    echo -e "identity\tMATCH (running exe == run $RUN_ID artifact)"
  else
    echo -e "identity\tMISMATCH (running exe != deployed artifact sha)"; rc=1
  fi
else
  echo -e "identity\tNO-ARTIFACT-SHA (deployed.meta.json lacks artifact_sha256)"; rc=1
fi
[ "$SRC_SHA" = "$DEPLOYED_SHA" ] || { echo -e "deployed.sha\tMISMATCH (meta vs marker)"; rc=1; }

# feature-presence markers (strings on the live binary)
if [ -n "$MARKERS" ]; then
  IFS=',' read -ra MS <<< "$MARKERS"
  # Drain strings output ONCE into a buffer. grep -q in a pipeline exits on
  # first match; strings then dies on SIGPIPE (141) under pipefail and a
  # FOUND marker flips to a false MISSING. Buffering removes the pipe and
  # avoids re-running strings (837k lines) per marker.
  # Found live 2026-09-04: markers at line ~1635/837007 → RC=141 repro.
  STRINGS_BUF="$(strings "$EXE" 2>/dev/null)"
  for m in "${MS[@]}"; do
    if grep -qF -- "$m" <<< "$STRINGS_BUF"; then
      echo -e "marker:$m\tFOUND"
    else
      echo -e "marker:$m\tMISSING"; rc=1
    fi
  done
fi

# negative control: a DIFFERENT binary must hash different — proves the hash discriminates
if [ -n "$NEGCTRL" ]; then
  [ -f "$NEGCTRL" ] || die 3 "negative-control file missing: $NEGCTRL"
  NC_SHA="$(sha256sum "$NEGCTRL" | cut -d' ' -f1)"
  if [ "$NC_SHA" != "$EXE_SHA" ]; then
    echo -e "negative-control\tOK (differs from live exe)"
  else
    echo -e "negative-control\tSUSPECT (identical to live exe — control is not a control)"; rc=1
  fi
fi

if [ "$rc" -eq 0 ]; then echo "VERDICT: IDENTITY-MATCH — binary identity + feature presence on live $UNIT"; else echo "VERDICT: MISMATCH — see rows above"; fi
exit "$rc"
}

if [ -n "$APPEND_LOG" ]; then
  RC=0
  OUT="$( { trap - EXIT; emit_evidence; } )" || RC=$?
  printf '%s\n' "$OUT"
  if [ "$RC" = 0 ] || [ "$RC" = 1 ]; then
    append_log "$APPEND_LOG" "$OUT" || die 3 "append-log failed: $APPEND_LOG"
  fi
  exit "$RC"
fi
emit_evidence
