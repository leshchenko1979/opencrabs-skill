  # to the placeholder — the guard at 244 is the only thing standing between a
  # typo'd path and another empty-brief wave.
  OC_NOTIFY_BIN="$T/fake-notify" bash "$0" --title T --no-stamp \
    --text-file "$T/does-not-exist.md" >/dev/null 2>&1 && rc_mf=0 || rc_mf=$?
  [ "$rc_mf" = 2 ] && chk 0 text-file-missing-rc2 || chk 1 "text-file-missing-rc2 (got rc=$rc_mf)"

  # LAW 10 (defect #5, 2026-09-12): partial delivery surfaced + per-send bound.
  # 10a. --verify diffs the per-attempt manifest against .sent receipts:
  #      partial wave -> rc 8 naming each unreached uuid; complete -> rc 0;
      # unknown wave -> rc 3.
  mkdir -p "$T/verify-run"
  V1=aaaabbbb-1111-4111-8111-111111111111; V2=aaaabbbb-2222-4222-8222-222222222222; V3=aaaabbbb-3333-4333-8333-333333333333
  printf '%s\n' "$V1" "$V2" "$V3" > "$T/verify-run/wave-deadbeef0001.targets"
  printf '%s\n' "$V1" > "$T/verify-run/wave-deadbeef0001.sent"
  OC_FANOUT_RUN_DIR="$T/verify-run" bash "$0" --verify deadbeef0001 >/dev/null 2>"$T/vp.err" && vrc=0 || vrc=$?
  [ "$vrc" = 8 ] && chk 0 verify-partial-rc8 || chk 1 "verify-partial-rc8 (got $vrc)"
  grep -q "$V2" "$T/vp.err" && chk 0 verify-names-unreached-2 || chk 1 verify-names-unreached-2
  grep -q "$V3" "$T/vp.err" && chk 0 verify-names-unreached-3 || chk 1 verify-names-unreached-3
  printf '%s\n' "$V2" "$V3" >> "$T/verify-run/wave-deadbeef0001.sent"
  OC_FANOUT_RUN_DIR="$T/verify-run" bash "$0" --verify deadbeef0001 >/dev/null 2>&1 && vrc=0 || vrc=$?
  [ "$vrc" = 0 ] && chk 0 verify-complete-rc0 || chk 1 "verify-complete-rc0 (got $vrc)"
  OC_FANOUT_RUN_DIR="$T/verify-run" bash "$0" --verify nosuchwave00 >/dev/null 2>&1 && vrc=0 || vrc=$?
  [ "$vrc" = 3 ] && chk 0 verify-nomanifest-rc3 || chk 1 "verify-nomanifest-rc3 (got $vrc)"
  # 10b. per-send timeout bounds a hung lane; the wave CONTINUES past it and
  # reports PARTIAL DELIVERY (exit 4) — one slow lane cannot starve a wave.
  cat > "$T/fake-notify-slow" <<'SLOWEOF'
