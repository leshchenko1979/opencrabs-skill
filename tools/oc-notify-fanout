for a in "$@"; do case "$a" in 77777777-*) sleep 30 ;; esac; done
echo "notification id 88888888-8888-4888-8888-888888888888"
exit 0
SLOWEOF
  chmod +x "$T/fake-notify-slow"
  jq '.workers += [{"uuid":"'"$L7"'","role":"editor","topic_id":1,"state":"ACTIVE"}]' "$LEDG" > "$T/ledg2.json"
  tout="$(OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify-slow" OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" \
    OC_FANOUT_LEDGER="$T/ledg2.json" OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_SEND_TIMEOUT=2 \
    OC_FANOUT_RUN_DIR="$T/run-timeout" FAKE_NOTIFY_LOG="$T/fns.log" \
    bash "$0" --title "TTO" --text "brief {{UUID}}" --no-stamp 2>&1; echo "RC=$?")"
  echo "$tout" | grep -q "FAIL $L7 .*rc=124" && chk 0 timeout-bounds-hung-send || chk 1 timeout-bounds-hung-send
  echo "$tout" | grep -q "SENT $L1" && chk 0 wave-continues-past-hung-lane || chk 1 wave-continues-past-hung-lane
  echo "$tout" | grep -q "PARTIAL DELIVERY" && chk 0 partial-delivery-named || chk 1 partial-delivery-named
  echo "$tout" | grep -q "RC=4" && chk 0 partial-wave-exit-4 || chk 1 partial-wave-exit-4
  # 10c. the manifest itself: one row per attempted lane, retired rows never.
  ls "$T"/run-default/wave-*.targets >/dev/null 2>&1 && chk 0 manifest-written || chk 1 manifest-written
  grep -qxF "$L1" "$T"/run-default/wave-*.targets && chk 0 manifest-has-attempted-lane || chk 1 manifest-has-attempted-lane
  grep -qxF "$L6" "$T"/run-default/wave-*.targets && chk 1 manifest-never-retired || chk 0 manifest-never-retired
  # LAW 15 (defect #15, 2026-09-12): a wave inherits the cgroup of its launcher.
  # When the launcher is a session hosted by the unit a swap bounces, the swap's
  # restart tears that cgroup down and SIGKILLs the wave mid-flight — the lanes
  # already reached got their briefs, the rest never heard, and nothing said so.
  # The wave must re-exec OUTSIDE the unit before it takes its lock.
  cat > "$T/fake-detach" <<'DEOF'
#!/usr/bin/env bash
echo "DETACH-CALLED" >> "$DETACH_LOG"
env OC_FANOUT_DETACHED=1 "$@"
DEOF
  chmod +x "$T/fake-detach"
  # 15a. inside the unit cgroup -> the detach path fires ONCE and the re-exec
  #      replays the original argv, so the wave still completes.
  : > "$T/detach.log"
  tout="$(DETACH_LOG="$T/detach.log" OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" \
    OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" OC_FANOUT_LEDGER="$LEDG" \
    OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_IN_UNIT_CGROUP=1 OC_FANOUT_DETACH_CMD="$T/fake-detach" \
    OC_FANOUT_RUN_DIR="$T/run-detach" FAKE_NOTIFY_LOG="$T/fn-detach.log" \
    bash "$0" --title TD --text "brief {{UUID}}" --no-stamp 2>&1; echo "RC=$?")"
  echo "$tout" | grep -q "RC=0" && chk 0 detach-reexec-rc0 || chk 1 detach-reexec-rc0
  chk "$([ "$(grep -c DETACH-CALLED "$T/detach.log" 2>/dev/null)" = 1 ] && echo 0 || echo 1)" detach-called-once
  echo "$tout" | grep -q "INSIDE opencrabs-ops.service" && chk 0 detach-names-unit || chk 1 detach-names-unit
  grep -q "$L1" "$T/fn-detach.log" 2>/dev/null && chk 0 detach-wave-delivered || chk 1 detach-wave-delivered
  # 15b. loop guard: a re-entered wave (OC_FANOUT_DETACHED=1) must NOT re-exec
  #      again — otherwise the detach recurses.
  : > "$T/detach.log"
  OC_FANOUT_IN_UNIT_CGROUP=1 OC_FANOUT_DETACHED=1 OC_FANOUT_DETACH_CMD="$T/fake-detach" \
    OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" \
    OC_FANOUT_LEDGER="$LEDG" OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_RUN_DIR="$T/run-guard" \
    FAKE_NOTIFY_LOG="$T/fn-guard.log" DETACH_LOG="$T/detach.log" \
    bash "$0" --title TG --text "brief {{UUID}}" --no-stamp >/dev/null 2>&1
  chk "$([ "$(grep -c DETACH-CALLED "$T/detach.log" 2>/dev/null)" = 0 ] && echo 0 || echo 1)" detach-loop-guard
  # 15c. outside the cgroup -> no detach at all (the common case: no re-exec tax).
  : > "$T/detach.log"
  OC_FANOUT_IN_UNIT_CGROUP=0 OC_FANOUT_DETACH_CMD="$T/fake-detach" \
    OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" \
    OC_FANOUT_LEDGER="$LEDG" OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_RUN_DIR="$T/run-outside" \
    FAKE_NOTIFY_LOG="$T/fn-outside.log" DETACH_LOG="$T/detach.log" \
    bash "$0" --title TO --text "brief {{UUID}}" --no-stamp >/dev/null 2>&1
  chk "$([ "$(grep -c DETACH-CALLED "$T/detach.log" 2>/dev/null)" = 0 ] && echo 0 || echo 1)" detach-skipped-outside
  # 15d. SURVIVAL (acceptance criterion): the launcher sits in its OWN process
  #      group; SIGKILLing that whole group — exactly what a swap's cgroup
  #      teardown does to every process still inside it — must NOT truncate a
  #      DETACHED wave. The notify is gated so the kill provably lands
  #      MID-WAVE, and the second send only happens if the wave survived.
  cat > "$T/fake-notify-gated" <<'GEOF'
#!/usr/bin/env bash
echo "sent: $*" >> "$FAKE_NOTIFY_LOG"
i=0
while [ ! -f "$GATE" ] && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
echo "notification id 99999999-9999-4999-8999-999999999999"
exit 0
GEOF
  chmod +x "$T/fake-notify-gated"
  cat > "$T/surv-launch.sh" <<'LEOF'
#!/usr/bin/env bash
echo "$$" > "$SURV_PGID"
exec env OC_NOTIFY_DB="$SURV_DB" OC_NOTIFY_BIN="$SURV_BIN" OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" \
  OC_FANOUT_LEDGER="$SURV_LEDG" OC_FANOUT_FORUM_CHAT="$SURV_FORUM" OC_FANOUT_IN_UNIT_CGROUP=1 \
  OC_FANOUT_DETACH_CMD="$SURV_DETACH" OC_FANOUT_RUN_DIR="$SURV_RUN" FAKE_NOTIFY_LOG="$SURV_LOG" \
  GATE="$SURV_GATE" bash "$SURV_SELF" --title TS --text "brief {{UUID}}" --no-stamp
LEOF
  chmod +x "$T/surv-launch.sh"
  # The kill/launch choreography runs in a DRIVER so the shell's own "Killed"
  # job notification lands in the driver's stderr (captured below) instead of
  # the selftest's — the SIGKILL is INTENTIONAL, and an alarming line in a green
  # selftest trains the reader to ignore it.
  cat > "$T/surv-drive.sh" <<'DREOF'
#!/usr/bin/env bash
: > "$SURV_LOG"; rm -f "$SURV_GATE" "$SURV_PGID_FILE"
SURV_PGID="$SURV_PGID_FILE" SURV_DB="$SURV_DB" SURV_BIN="$SURV_BIN" SURV_LEDG="$SURV_LEDG" \
SURV_FORUM="$SURV_FORUM" SURV_DETACH="setsid -w" SURV_RUN="$SURV_RUN" SURV_LOG="$SURV_LOG" \
SURV_GATE="$SURV_GATE" SURV_SELF="$SURV_SELF" \
  setsid "$SURV_LAUNCH" >"$SURV_OUT" 2>&1 &
i=0
while [ ! -s "$SURV_LOG" ] && [ "$i" -lt 60 ]; do sleep 0.1; i=$((i+1)); done
SPG="$(cat "$SURV_PGID_FILE" 2>/dev/null || echo 0)"
[ -n "$SPG" ] && [ "$SPG" != 0 ] && kill -9 -"$SPG" 2>/dev/null
sleep 0.3
: > "$SURV_GATE"                      # release the gated notify
i=0
while [ "$(grep -c '^sent:' "$SURV_LOG" 2>/dev/null)" -lt 2 ] && [ "$i" -lt 60 ]; do sleep 0.1; i=$((i+1)); done
echo "SENT=$(grep -c '^sent:' "$SURV_LOG" 2>/dev/null)"
wait 2>/dev/null
exit 0
DREOF
  chmod +x "$T/surv-drive.sh"
  drv_out="$(SURV_PGID_FILE="$T/surv.pgid" SURV_DB="$T/db.sqlite" SURV_BIN="$T/fake-notify-gated" \
    SURV_LEDG="$T/ledg2.json" SURV_FORUM="$FORUM" SURV_RUN="$T/run-surv" SURV_LOG="$T/fn-surv.log" \
    SURV_GATE="$T/gate" SURV_SELF="$(readlink -f "$0")" SURV_LAUNCH="$T/surv-launch.sh" \
    SURV_OUT="$T/surv.out" bash "$T/surv-drive.sh" 2>"$T/surv-drive.err")"
  n_surv="$(printf '%s\n' "$drv_out" | sed -n 's/^SENT=//p' | head -1)"
  [ -n "$n_surv" ] || n_surv=0
  [ "$n_surv" -ge 2 ] && chk 0 detach-survives-pgkill || chk 1 "detach-survives-pgkill (sent=$n_surv)"
  grep -q "INSIDE opencrabs-ops.service" "$T/surv.out" 2>/dev/null && chk 0 detach-surv-fired || chk 1 detach-surv-fired

  echo "oc-notify-fanout selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]
  exit $?
fi

title="" text="" text_file="" roles="" excludes="" dry=0 stamp=1 include_self=0 verify_id=""
forum_chat="${OC_FANOUT_FORUM_CHAT:--1003936827469}"
while [ $# -gt 0 ]; do case "$1" in
  --title) title="${2:-}"; shift 2 ;;
  --text) text="${2:-}"; shift 2 ;;
  --text-file) text_file="${2:-}"; shift 2 ;;
  --roles) roles="${2:-}"; shift 2 ;;
  --exclude) excludes="${2:-}"; shift 2 ;;
  --forum-chat) forum_chat="${2:-}"; shift 2 ;;
  --dry-run) dry=1; shift ;;
  --no-stamp) stamp=0; shift ;;
  --include-self) include_self=1; shift ;;
  --verify) verify_id="${2:-}"; shift 2 ;;
  --help|-h) sed -n '2,40p' "$0"; exit 0 ;;
  *) die "unknown flag '$1' (see --help)" ;;
esac; done

# LAW 10 — partial-delivery verdict (defect #5, 2026-09-12). Dispatched
# BEFORE the version/title/ledger checks: --verify touches only the run dir.
if [ -n "$verify_id" ]; then
  [ -n "$verify_id" ] || die "verify: --verify needs a wave id" 2
  VRUN="${OC_FANOUT_RUN_DIR:-$SKILL_DIR/run}"
  VT="$VRUN/wave-${verify_id}.targets"; VS="$VRUN/wave-${verify_id}.sent"
  if [ ! -f "$VT" ]; then
    die "verify: no targets manifest for wave ${verify_id} in ${VRUN} — wave never attempted a send (or predates the manifest)" 3
  fi
  owed="$(sort -u "$VT" | grep -c . || true)"
  sentn=0
  if [ -f "$VS" ]; then sentn="$(sort -u "$VS" | grep -c . || true)"; fi
  unreached="$(comm -23 <(sort -u "$VT") <(sort -u "${VS:-/dev/null}") || true)"
  if [ -z "$unreached" ]; then
    echo "wave ${verify_id}: COMPLETE — ${sentn}/${owed} targets all have receipts"
    exit 0
  fi
  n_unreached="$(printf '%s\n' "$unreached" | grep -c . || true)"
  {
    echo "wave ${verify_id}: PARTIAL — ${sentn}/${owed} sent, ${n_unreached} unreached:"
    printf '%s\n' "$unreached"
    echo "resume: re-run the original fanout command (duplicates skip cleanly, law 8)"
  } >&2
  exit 8
fi
# LAW 15: detach BEFORE the version/title/ledger checks and the wave lock, so a
# re-entry can never deadlock on a lock this same invocation already holds.
# --verify returned above (read-only, no lock), so it never detaches.
fanout_ensure_detached

version="$(sed -n 's/^version:[[:space:]]*//p' "$SKILL_DIR/SKILL.md" | head -1)"
[ -n "$version" ] || die "cannot read version from SKILL.md"
[ -n "$title" ] || die "usage: --title required"
[ -f "$LEDGER" ] || die 3 "roster missing: $LEDGER"
bin="$(oc_notify_resolve_bin)" || die "notify binary unresolvable (set OC_NOTIFY_BIN)"

# LAW 7/8 — wave-id + lock + sent-ledger. wave-id derives from title+brief so
# the same wave re-run (retry, resume) hashes identically while any content
# change forks a new wave. Locks/receipts live in <skill-repo>/run/ (gitignored).
RUN_DIR="${OC_FANOUT_RUN_DIR:-$SKILL_DIR/run}"
mkdir -p "$RUN_DIR" 2>/dev/null || die 3 "cannot create run dir: $RUN_DIR"
if [ -n "$text_file" ]; then [ -f "$text_file" ] || die "--text-file missing: $text_file"; fi
wave_text="${title}|$( [ -n "$text_file" ] && cat "$text_file" || echo "${text:-}" )"
wave_id="$(printf '%s' "$wave_text" | sha256sum | cut -c1-12)"
LOCK_FILE="$RUN_DIR/wave-${wave_id}.lock"
SENT_FILE="$RUN_DIR/wave-${wave_id}.sent"
TARGETS_FILE="$RUN_DIR/wave-${wave_id}.targets"   # law 10: one uuid per send ATTEMPT

# Live = holder pid alive AND lock < 900s old. Stale = cleared with receipt.
lock_live() { # $1=lockfile -> 0 if live
  local pid ts age
  read -r pid ts _ < "$1" 2>/dev/null || return 1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  age=$(( $(date +%s) - ${ts:-0} ))
  [ "$age" -lt 900 ]
}
if [ "$dry" = 0 ]; then
  exec 9>>"$LOCK_FILE"
  if ! flock -n 9; then
    if lock_live "$LOCK_FILE"; then
      read -r LPID LTS _ < "$LOCK_FILE"
      die "wave ${wave_id} already in progress (holder pid ${LPID:-?} since ${LTS:-?} epoch); concurrent run refused (law 7)" 7
    fi
    printf 'LOCK clear stale wave-%s lock (pid dead or >15min)\n' "$wave_id" >&2
    rm -f "$LOCK_FILE"
    exec 9>>"$LOCK_FILE"
    flock -n 9 || die "wave ${wave_id} lock contention unresolved" 7
  fi
  # flock acquired — but a live holder may have stamped the lockfile in the
  # race window before its own flock (or be holding it via another fd). The
  # lockfile CONTENT is the authority for the refuse verdict (law 7).
  if [ -s "$LOCK_FILE" ]; then
    read -r LPID LTS _ < "$LOCK_FILE" || true
    if [ "${LPID:-}" != "$$" ] && lock_live "$LOCK_FILE"; then
      die "wave ${wave_id} already in progress (holder pid ${LPID:-?} since ${LTS:-?} epoch); concurrent run refused (law 7)" 7
    fi
    printf 'LOCK clear stale wave-%s lock (pid dead or >15min)\n' "$wave_id" >&2
  fi
  printf '%s %s %s\n' "$$" "$(date +%s)" "$wave_id" > "$LOCK_FILE"
fi

LIVE_SESSIONS="$(mktemp /tmp/fanout-sessions.XXXXXX)"
IN_SCOPE_SESSIONS="$(mktemp /tmp/fanout-scope.XXXXXX)"
# FULL-ID roster from the profile session DB (READ-ONLY, ~0s) — v0.4.129:
# session list prints only 8-char prefixes and session get costs ~37s/call;
# the DB is the canonical full-id source (CLI list ≡ archived_at IS NULL AND
# title NOT LIKE 'subagent:%', set-equality verified 2026-09-09). OC_NOTIFY_DB
# overrides the path for selftests.
sqlite3 "file:${OC_NOTIFY_DB:-$HOME/.opencrabs/profiles/${PROFILE}/opencrabs.db}?mode=ro" \
  "SELECT id FROM sessions WHERE archived_at IS NULL AND (title IS NULL OR title NOT LIKE 'subagent:%');" \
  > "$LIVE_SESSIONS" 2>/dev/null || die 3 "session DB unreadable — cannot validate targets"
# FORUM-SCOPE roster (law 6): sessions bound to the opencrabs-dev forum chat.
# One query, same read-only DB; empty roster = nothing is sendable (safe).
sqlite3 "file:${OC_NOTIFY_DB:-$HOME/.opencrabs/profiles/${PROFILE}/opencrabs.db}?mode=ro" \
  "SELECT b.session_id FROM session_bindings b JOIN sessions s ON s.id = b.session_id
   WHERE s.archived_at IS NULL AND b.chat_id = '$forum_chat';" \
  > "$IN_SCOPE_SESSIONS" 2>/dev/null || die 3 "session DB unreadable — cannot resolve forum scope"

# --text-file is loaded HERE, not merely hashed. The first cut validated the
# file (244), hashed its content into the wave-id (245) — and then never read
# it into `text`, so EVERY --text-file wave shipped the "(see title)"
# placeholder plus the auto-appended RELOAD line and NOTHING ELSE (silent-
# failure defect, fixed 2026-09-11 on HQ report d72bd52d). The receipts looked
# plausible — brief-ok(136 chars) — which is precisely why it survived a
# 2078-char brief; only the character count gave it away, and the selftest had
# no --text-file assertion to notice. Loaded into `text` (not just into the
# brief assembly) so every downstream consumer sees the file content, with
# --text remaining the fallback when no file is given. A file that exists but
# is EMPTY still falls through to the placeholder below, exactly as an empty
# --text does — the two paths stay symmetric.
if [ -n "$text_file" ]; then text="$(cat "$text_file")"; fi

[ -n "$text" ] || text="(see title)"

canon_role() { # ontology fold 2026-09-11 (c586e61f): the HQ role string was
  # `hq-supervisor`, now `hq`. Legacy selectors must keep resolving, or a wave
  # dispatched with `--roles hq-supervisor` silently reaches nobody. Twin of the
  # alias in oc-ledger cmd_roster; both carry a selftest assertion.
  case "$1" in hq-supervisor|HQ-SUPERVISOR) printf 'hq' ;; *) printf '%s' "$1" ;; esac
}
want_role() { # $1=role -> 0 if selected by --roles filter
  [ -z "$roles" ] && return 0
  # Exact comma-delimited match, as before — but canonicalised on BOTH sides so
  # the legacy `hq-supervisor` selector and the new `hq` selector each match the
  # row whichever spelling the row happens to carry.
  local r s IFS=','
  r="$(canon_role "$1")"
  for s in $roles; do
    [ "$(canon_role "$s")" = "$r" ] && return 0
  done
  return 1
}
excluded() { # $1=uuid $2=topic -> 0 if excluded (8-char prefix or full uuid or topic)
  local t
  local IFS=','
  for t in $excludes; do
    case "$1" in "$t"*) return 0 ;; esac
    [ -n "${2:-}" ] && [ "$2" = "$t" ] && return 0
  done
  return 1
}
self_uuid="${OC_FANOUT_SELF:-2fae1230-de9e-4fa5-aa24-822cf7188c3e}"

zero_segment() { case "$1" in *-0000-*|*-00000000*) return 0 ;; esac; return 1; }

validate_target() { # $1=uuid -> 0 ok; else echo reason
  local u="$1"
  case "$u" in
    [0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*) ;; # 8-4-4-4-12 shape
    *) echo "malformed uuid"; return 1 ;;
  esac
  if zero_segment "$u"; then echo "placeholder/all-zero-segment uuid (n=2167 class)"; return 1; fi
  # FULL-ID roster match (v0.4.129, same source as oc-waiter): the cached
  # DB roster holds canonical full uuids; a frankenstein id (real prefix +
  # foreign tail, n=2221 class) fails the exact match. All-zero segments
  # die before this check (n=2167 placeholder class).
  if ! grep -qxF "$u" "$LIVE_SESSIONS" 2>/dev/null; then
    echo "not a live session (full-id absent from session DB roster)"; return 1
  fi
  return 0
}

sendable_state() { # $1=roster .state -> 0 if the row is a valid dispatch target
  # LAW 9 (defect #6, 2026-09-12). The live ledger's state vocabulary is
  # {absent, ACTIVE, RETIRED}: `oc-ledger enroll` writes NO state key (absent
  # means active) and RETIRED is the only other value in the roster (12 of 48
  # rows). The test is therefore "ACTIVE or absent", NOT "not RETIRED", so an
  # unknown future state is skipped rather than notified.
  case "$(printf '%s' "${1:-}" | tr 'a-z' 'A-Z')" in
    ""|ACTIVE) return 0 ;;
    *) return 1 ;;
  esac
}

sent=0 skipped=0 failed=0 receipts="" ids=""
while IFS=$'\t' read -r uuid role topic wstate; do
  [ -n "$uuid" ] || continue
  [ "$uuid" = "$self_uuid" ] && [ "$include_self" = 0 ] && continue
  want_role "$role" || continue
  # LAW 9 — target-set filter, applied BEFORE per-target validation: a retired
  # row is not a target at all, so it is reported as such rather than dressed
  # up as a scope/shape failure. Placed AFTER want_role so a wave that does not
  # select the row's role emits no receipt for it.
  if ! sendable_state "$wstate"; then
    receipts+="SKIP ${uuid} ${role} INACTIVE(state=${wstate})"$'\n'; skipped=$((skipped+1)); continue
  fi
  if excluded "$uuid" "$topic"; then
    receipts+="SKIP ${uuid} ${role} excluded(${topic:-no-topic})"$'\n'; skipped=$((skipped+1)); continue
  fi
  if reason="$(validate_target "$uuid")"; then :; else
    receipts+="SKIP ${uuid} ${role} ${reason}"$'\n'; skipped=$((skipped+1)); continue
  fi
  # LAW 6 — forum-scope guard: the session must be bound to the opencrabs-dev
  # forum chat. Unbound or bound-elsewhere targets are never woken (an unbound
  # session's notify lands wherever its default route points — a DM, another
  # group — which is exactly the leak this guard closes).
  if ! grep -qxF "$uuid" "$IN_SCOPE_SESSIONS" 2>/dev/null; then
    receipts+="SKIP ${uuid} ${role} SCOPE(not-bound-to-forum-${forum_chat})"$'\n'; skipped=$((skipped+1)); continue
  fi
  # LAW 8 — per-lane idempotency: already-sent lanes never re-notify.
  if [ "$dry" = 0 ] && grep -qxF "$uuid" "$SENT_FILE" 2>/dev/null; then
    receipts+="SKIP ${uuid} ${role} DUPLICATE(already-sent-wave-${wave_id})"$'\n'; skipped=$((skipped+1)); continue
  fi
  brief="${text}"
  brief="${brief//\{\{UUID\}\}/${uuid}}"
  brief="${brief//\{\{VERSION\}\}/${version}}"
  brief="${brief} RELOAD: run oc-drift-check ${uuid} ${version} --ack, re-read changed files. ACK after drift-check."
  case "$brief" in *'{{'*'}}'*)
    receipts+="ABORT ${uuid} ${role} placeholder-token-survived-substitution(law1)"$'\n'
    failed=$((failed+1)); continue ;;
  esac
  if [ "$dry" = 1 ]; then
    receipts+="DRY ${uuid} ${role} brief-ok(${#brief} chars)"$'\n'; sent=$((sent+1)); continue
  fi
  # n=2221 hang fix: `session notify` to a wedged target can block indefinitely;
  # with ~33 targets one hang starves the whole fanout and NO receipts flush.
  # Per-send timeout + receipts printed INCREMENTALLY (flush before each send),
  # so a mid-run hang leaves every prior receipt on stdout.
  # n=2269 fix (v0.4.126): measured live latency of `session notify` is ~30s
  # UNIFORM (probe A plain=34s, probe B --title=31s — --title NOT the delta).
  # The old 20s default killed EVERY send rc=124 while delivery actually
  # worked. Default raised to 90s; each receipt carries send latency.
  if [ -z "${OC_FANOUT_SEND_TIMEOUT:-}" ]; then OC_FANOUT_SEND_TIMEOUT=90; fi
  # LAW 10 manifest: recorded BEFORE the send, so even a mid-send kill leaves
# the intended set on disk for --verify to diff against .sent receipts.
  if [ "$dry" = 0 ]; then
    grep -qxF "$uuid" "$TARGETS_FILE" 2>/dev/null || printf '%s\n' "$uuid" >> "$TARGETS_FILE"
  fi
  printf '%s' "$receipts"   # incremental flush: receipts survive a mid-send hang
  receipts=""
  T0=$(date +%s%N)
  out="$(timeout "$OC_FANOUT_SEND_TIMEOUT" "$bin" session notify --profile "$PROFILE" --sender "$SENDER" \
        --title "$title" --text "$brief" "$uuid" 2>&1)" && rc=0 || rc=$?
  if [ "$rc" = 3 ]; then  # mid-turn: interrupt-retry per lib contract
    out="$(timeout "$OC_FANOUT_SEND_TIMEOUT" "$bin" session notify --profile "$PROFILE" --sender "$SENDER" \
          --title "$title" --text "$brief" --interrupt "$uuid" 2>&1)" && rc=0 || rc=$?
  fi
  T1=$(date +%s%N)
  LAT_MS=$(( (T1 - T0) / 1000000 ))
  # The CLI prints `notification id <id>` ONLY on a DEFERRED verdict (quiet
  # mode). An IMMEDIATE delivery prints `delivered: delivered to session <uuid>`
  # — no id phrase at all — so this regex can never match a normal send and the
  # fallback below is the COMMON path, not an error. The label is deliberately
  # self-describing: `rc0-no-id` read like a receipt failure and cost HQ a cycle
  # proving it was fine (HQ addendum 2026-09-11). The bare `rc0` fallback that
  # lands in the ledger stamp's `ids:` field is LEFT ALONE — it is a pre-existing
  # token other lanes' greps may key on, and it never reaches a receipt line.
  nid="$(printf '%s' "$out" | grep -oE 'notification id [0-9a-f-]+' | head -1 || true)"
  if [ "$rc" = 0 ]; then
    receipts+="SENT ${uuid} ${role} ${nid:-rc0-immediate-no-id} ${LAT_MS}ms"$'\n'
    ids+="${nid:-rc0} " ; sent=$((sent+1))
    printf '%s\n' "$uuid" >> "$SENT_FILE"   # law 8: append-one-per-send idempotency receipt
  else
    receipts+="FAIL ${uuid} ${role} rc=${rc} ${LAT_MS}ms"$'\n'; failed=$((failed+1))
  fi
done < <(jq -r '.workers[] | [(.uuid // ""), (.role // "editor"), ((.topic_id // 0) | tostring), (.state // "ACTIVE")] | @tsv' "$LEDGER")

echo "--- receipts ---"; printf '%s' "$receipts"
echo "--- summary ---"
echo "sent=$sent skipped=$skipped failed=$failed version=$version dry=$dry"
if [ "$stamp" = 1 ] && [ "$dry" = 0 ] && [ "$sent" -gt 0 ]; then
  # --by fallback (#19, 2026-09-12): oc-ledger refuses an anonymous row, so a
  # wave stamps under the caller's OC_ACTOR when set, else under the tool name.
  bash "$SKILL_DIR/tools/oc-ledger" stamp notify-fanout \
    --by "${OC_ACTOR:-oc-notify-fanout}" \
    "fanout '$title': sent=$sent skipped=$skipped failed=$failed ids: ${ids:-none}" || true
fi
if [ "$failed" -gt 0 ]; then
  # LAW 10 (defect #5, 2026-09-12): a wave that finished its loop with send
  # failures must SAY partial delivery on stderr, not just exit 4 silently.
  echo "PARTIAL DELIVERY: $failed of $((sent+failed)) attempted send(s) failed — named in the FAIL receipts above; resume by re-running the same wave (duplicates skip), audit with: oc-notify-fanout --verify $wave_id" >&2
  exit 4
fi
exit 0
