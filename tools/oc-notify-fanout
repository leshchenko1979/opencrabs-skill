#!/usr/bin/env bash
# oc-notify-fanout — per-lane skill-change brief generator + dispatcher (v0.4.123)
#
# HQ CONCUR+ASSIGN 2026-09-09 (owner order same day): the v0.4.120 notify wave
# hand-picked lanes from a stale roster and missed the RELOAD instruction.
# This tool is the single sanctioned path for skill-change notifies.
#
# Laws baked in (Triage supplement after acc3fa9b/c6b1a539/d5863180):
#   1. SELF-UUID SUBSTITUTION: each lane's brief carries THAT lane's uuid in
#      the drift-check command — no "{{UUID}}" placeholder ever survives into
#      a sent brief. A brief containing a literal placeholder token is a
#      defect generator; the tool refuses to send one (defect class killed
#      at the root: lanes parsed "<your-uuid>" as the sender's uuid).
#   2. RELOAD line per fleet-directives.md (L158 law) + explicit ack contract
#      in EVERY brief.
#   3. TARGET VALIDATION: every target is checked (a) uuid shape, (b) no
#      all-zero segment (n=2167 placeholder-uuid class), (c) LIVE session
#      existence via `opencrabs session get <uuid>` rc==0, BEFORE any send.
#      Dead targets are skipped with a reason, never attempted.
#   4. RECEIPTS: one line per lane (uuid role rc detail); summary; ledger
#      stamp kind=notify-fanout carrying all ids (opt-out --no-stamp).
#   5. QUIET-60S contract text is embedded in briefs. SENDS ARE IMMEDIATE
#      (`--mode` defaults to now) with the standard interrupt-retry: on rc 3
#      the send is re-issued with --interrupt, which is now a deprecated alias
#      for --mode turn-end.
#      CORRECTION 2026-09-11 (Toolsmith, dispatched by the hourly health sweep):
#      an earlier note here claimed the binary's `session notify` CLI had NO
#      quiet/mode flag (verified 2026-09-09) and flagged it to HQ as a binary
#      gap. That is FALSE now and was never re-checked: `opencrabs session
#      notify --help` lists `--mode now|turn-end|quiet`, `--quiet-for-secs`,
#      `--max-delay-secs`, and `--confirm`. The gap was closed upstream-side.
#      The tool still sends immediately ON PURPOSE — deferred delivery for a
#      work-dispatch wave is a fleet delivery-semantics decision, not a header
#      detail. If HQ wants quiet-by-default fanout, the switch is one flag
#      (`--mode quiet`), and it belongs in a separate, owner-visible change.
#   6. FORUM-SCOPE GUARD (owner order 2026-09-10 03:16Z): ALL opencrabs-dev
#      work — including skill-change fanout — happens ONLY in the opencrabs-dev
#      forum chat. A target session is sendable only when the profile session
#      DB binds it (session_bindings.chat_id) to the forum chat. Targets bound
#      elsewhere or unbound are skipped with a `SKIP <uuid> <role> SCOPE(...)`
#      receipt BEFORE any send. Override for drills: --forum-chat <chat_id>
#      (or OC_FANOUT_FORUM_CHAT). Default: -1003936827469.
#   7. WAVE-ID LOCK (v0.4.131, WAVE-GROUP-B B1): wave-id = sha256(title+brief)
#      first 12 hex. A lockfile run/wave-<id>.lock (flock + pid + ts) guards
#      against CONCURRENT re-runs of the same wave: a live lock (pid alive,
#      <15 min old) refuses with rc=7 naming the holder pid/ts; a stale lock
#      (pid dead OR >15 min) is auto-cleared with a receipt line. Locks live
#      in <skill-repo>/run/ (created on demand, gitignored).
#   8. PER-LANE IDEMPOTENCY (v0.4.131, WAVE-GROUP-B B2): run/wave-<id>.sent
#      appends one uuid per successful send. A target already in .sent is
#      skipped with `SKIP <uuid> <role> DUPLICATE` — a re-run of the same wave
#      completes only the remaining lanes (resume semantics), never double-
#      notifies.
#
# Usage:
#   oc-notify-fanout --title "SKILL CHANGE — v0.4.123" \
#     [--text "what changed ..."] [--text-file /path/brief.md] \
#     [--roles editor,hq] [--exclude "40695,uuid8char"] \
#     [--forum-chat <chat_id>] [--dry-run] [--no-stamp] [--include-self]
#
#   Default brief (when --text/--text-file omitted) is the canonical
#   skill-change template with what="" — pass --text for the body.
#
#   --text-file loads the FILE'S CONTENT as the brief — it is not a pointer to
#   be resolved elsewhere: the file is read here and its text IS the brief.
#   --text-file WINS over --text when both are given. A --text-file path that
#   does not exist is a hard error (rc 2), never a silent fall-through to the
#   default brief. Fixed 2026-09-11 (HQ report d72bd52d): the file was
#   validated and hashed into the wave-id but NEVER loaded into the brief, so
#   every --text-file wave shipped the "(see title)" placeholder and nothing
#   else — while the receipt still read brief-ok(N chars).
#   Template tokens (case-sensitive, replaced per lane BEFORE sending):
#     {{UUID}} -> lane's own session uuid   {{VERSION}} -> SKILL.md version
#   Any surviving {{...}} token after substitution -> abort that send (law 1).
#
# Exit codes: 0 all sent/skipped-clean · 2 usage/roster error · 3 ledger ·
#             4 partial send failures (receipts say which) · 5 abort (placeholder leak guard)
#             7 concurrent wave in progress (live lock held by another pid)
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/oc-notify.sh
source "$SKILL_DIR/tools/lib/oc-notify.sh"
_OC_LIB="$SKILL_DIR/tools/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then
  source "$_OC_LIB"
  oc_log_init "oc-notify-fanout" "$@"
else
  oc_log_finish() { :; }
fi
trap 'oc_log_finish $?' EXIT
LEDGER="${OC_FANOUT_LEDGER:-$HOME/.opencrabs/profiles/ops/opencrabs-dev/workers-ledger.json}"
PROFILE="${OC_NOTIFY_PROFILE:-ops}"
SENDER="oc-notify-fanout"

die() { echo "oc-notify-fanout: $*" >&2; exit "${2:-2}"; }
if [ "${1:-}" = "--selftest" ]; then
  # SELFTEST — forum-scope guard + law-1 placeholder guard, fully fixture-based
  # (OC_NOTIFY_DB points at a throwaway sqlite DB; OC_NOTIFY_BIN at a fake
  # notify binary that records sends; OC_FANOUT_LEDGER at a temp ledger).
  # No real DB, no real sends, no real ledger touched.
  T="$(mktemp -d /tmp/fanout-selftest.XXXXXX)"
  trap 'rm -rf "$T"; oc_log_finish $?' EXIT
  L1="11111111-1111-4111-8111-111111111111"  # live + bound to forum chat
  L2="22222222-2222-4222-8222-222222222222"  # live + bound ELSEWHERE (leak path)
  L3="33333333-3333-4333-8333-333333333333"  # live + UNBOUND (leak path)
  L4="44444444-4444-4444-8444-444444444444"  # malformed shape
  L5="00000000-0000-0000-0000-000000000000"  # all-zero (n=2167 class)
  FORUM="-1999999999"
  sqlite3 "$T/db.sqlite" <<SQL
CREATE TABLE sessions (id TEXT PRIMARY KEY, title TEXT, archived_at INTEGER);
CREATE TABLE session_bindings (session_id TEXT PRIMARY KEY, channel TEXT, chat_id TEXT, thread_id INTEGER, updated_at INTEGER DEFAULT 0);
INSERT INTO sessions VALUES ('$L1','lane1',NULL),('$L2','outside',NULL),('$L3','unbound',NULL),('$L4','bad',NULL),('$L5','zero',NULL);
INSERT INTO session_bindings VALUES ('$L1','telegram','$FORUM',123,0);
INSERT INTO session_bindings VALUES ('$L2','telegram','-1000000000',1,0);
SQL
  cat > "$T/fake-notify" <<'EOF'
#!/usr/bin/env bash
echo "sent: $*" >> "$FAKE_NOTIFY_LOG"
echo "notification id 99999999-9999-4999-8999-999999999999"
exit 0
EOF
  chmod +x "$T/fake-notify"
  touch "$T/fake-notify-log"
  LEDG="$T/ledger.json"
  # Fixture roster: 5 workers, one per defect class (L2/L3 are the leak paths
  # the guard exists to close). Roles/topics are irrelevant to the guard.
  cat > "$LEDG" <<JSON
{"workers": [
  {"uuid": "$L1", "role": "editor", "topic_id": 1},
  {"uuid": "$L2", "role": "editor", "topic_id": 2},
  {"uuid": "$L3", "role": "editor", "topic_id": 3},
  {"uuid": "$L4", "role": "editor", "topic_id": 4},
  {"uuid": "$L5", "role": "editor", "topic_id": 5}
], "events": []}
JSON

  run_fanout() { # args passed through; asserts rc 0 and returns receipts
    OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" \
    OC_FANOUT_LEDGER="$LEDG" OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_SEND_TIMEOUT=5 \
    OC_FANOUT_RUN_DIR="${OC_FANOUT_RUN_DIR:-$T/run-default}" FAKE_NOTIFY_LOG="$T/fake-notify-log" \
      bash "$0" --title "T" --text "brief {{UUID}}" --no-stamp "$@" 2>&1
  }
  F=0; P=0
  chk() { if [ "$1" = 0 ]; then P=$((P+1)); else F=$((F+1)); echo "FAIL: $2"; fi }
  mkdir -p "$T/run-default"

  # 1. Default roster (all 4 non-self workers): ONLY L1 sendable.
  out="$(run_fanout)"
  echo "$out" | grep -q "SENT $L1" && chk 0 sent-in-scope || chk 1 sent-in-scope
  echo "$out" | grep -q "SKIP $L2 .*SCOPE" && chk 0 skip-bound-elsewhere || chk 1 skip-bound-elsewhere
  echo "$out" | grep -q "SKIP $L3 .*SCOPE" && chk 0 skip-unbound || chk 1 skip-unbound
  echo "$out" | grep -q "SKIP $L4" && chk 0 skip-malformed || chk 1 skip-malformed
  echo "$out" | grep -q "SKIP $L5" && chk 0 skip-zero-seg || chk 1 skip-zero-seg
  grep -qF "$L2" "$T/fake-notify-log" && chk 1 leak-bound-elsewhere || chk 0 leak-bound-elsewhere
  grep -qF "$L3" "$T/fake-notify-log" && chk 1 leak-unbound || chk 0 leak-unbound

  # 2. Law-1 guard still fires: a brief with an unresolvable token aborts.
  out="$(OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" \
    OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" OC_FANOUT_LEDGER="$LEDG" \
    OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_SEND_TIMEOUT=5 \
    bash "$0" --title T --text "broken {{NOPE}} token" --no-stamp 2>&1)" || true
  echo "$out" | grep -q "ABORT.*placeholder" && chk 0 law1-placeholder-abort || chk 1 law1-placeholder-abort

  # 3. Dry-run behaves identically for scope (no send attempted).
  rm -f "$T/fake-notify-log"; touch "$T/fake-notify-log"
  out="$(run_fanout --dry-run)"
  echo "$out" | grep -q "DRY $L1" && chk 0 dry-in-scope || chk 1 dry-in-scope
  echo "$out" | grep -q "SKIP $L3 .*SCOPE" && chk 0 dry-scope-skip || chk 1 dry-scope-skip
  [ -s "$T/fake-notify-log" ] && chk 1 dry-no-send || chk 0 dry-no-send

  # 4. WAVE-GROUP-B: wave lock + idempotency (isolated run dir).
  RD="$T/run"; mkdir -p "$RD"
  # 4a. resume: run 1 sends L1 and records it in .sent; run 2 must SKIP DUPLICATE.
  out="$(OC_FANOUT_RUN_DIR="$RD" run_fanout)"
  echo "$out" | grep -q "SENT $L1" && chk 0 wave1-sent || chk 1 wave1-sent
  out="$(OC_FANOUT_RUN_DIR="$RD" run_fanout)"
  echo "$out" | grep -q "SKIP $L1 .*DUPLICATE" && chk 0 resume-duplicate-skip || chk 1 resume-duplicate-skip
  n_sends=$(grep -cF "$L1" "$T/fake-notify-log" || true)
  [ "$n_sends" = "1" ] && chk 0 exactly-one-send || chk 1 "exactly-one-send (got $n_sends)"
  # 4b. concurrent-refuse: a live lock (our own pid, fresh ts) refuses rc=7.
  WID="$(printf '%s' "T|brief {{UUID}}" | sha256sum | cut -c1-12)"
  printf '%s %s %s\n' "$$" "$(date +%s)" "$WID" > "$RD/wave-${WID}.lock"
  out="$(OC_FANOUT_RUN_DIR="$RD" run_fanout)" && rc7=0 || rc7=$?
  [ "$rc7" = "7" ] && chk 0 concurrent-refuse-rc7 || chk 1 "concurrent-refuse-rc7 (got rc=$rc7)"
  echo "$out" | grep -q "already in progress" && chk 0 concurrent-refuse-names-holder || chk 1 concurrent-refuse-names-holder
  # 4c. stale-clear: dead pid in the lockfile -> run proceeds, lock cleared.
  printf '999999 1 %s\n' "$WID" > "$RD/wave-${WID}.lock"
  out="$(OC_FANOUT_RUN_DIR="$RD" run_fanout)" && rcst=0 || rcst=$?
  [ "$rcst" = "0" ] && chk 0 stale-lock-cleared || chk 1 "stale-lock-cleared (got rc=$rcst)"
  echo "$out" | grep -q "DUPLICATE" && chk 0 stale-run-still-idempotent || chk 1 stale-run-still-idempotent
  rm -f "$RD/wave-${WID}.sent"
  # 4d. fresh .sent after clear: run sends again (lock was the only blocker).
  out="$(OC_FANOUT_RUN_DIR="$RD" run_fanout)"
  echo "$out" | grep -q "SENT $L1" && chk 0 post-clear-send || chk 1 post-clear-send

  # 5. Ontology fold alias (2026-09-11, c586e61f): the HQ role string was
  #    `hq-supervisor`, now `hq`. A wave dispatched with the LEGACY selector must
  #    still reach an `hq`-roled worker — otherwise it silently reaches nobody,
  #    which is the worst failure mode a fanout can have. Both spellings must
  #    select the same worker, and an unrelated selector must not.
  HQL="$T/ledger-hq.json"
  cat > "$HQL" <<JSON
{"workers": [
  {"uuid": "$L1", "role": "hq", "topic_id": 1}
], "events": []}
JSON
  fanout_roles() { # $1 = --roles value, $2 = run dir
    OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" \
    OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" OC_FANOUT_LEDGER="$HQL" \
    OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_SEND_TIMEOUT=5 OC_FANOUT_RUN_DIR="$2" \
    FAKE_NOTIFY_LOG="$T/fake-notify-log" \
      bash "$0" --title T --text "brief {{UUID}}" --no-stamp --roles "$1" 2>&1
  }
  out="$(fanout_roles hq "$T/run-hq1")"
  echo "$out" | grep -q "SENT $L1" && chk 0 role-alias-new-selector || chk 1 role-alias-new-selector
  out="$(fanout_roles hq-supervisor "$T/run-hq2")"
  echo "$out" | grep -q "SENT $L1" && chk 0 role-alias-legacy-selector || chk 1 role-alias-legacy-selector
  out="$(fanout_roles editor "$T/run-hq3")"
  echo "$out" | grep -q "SENT $L1" && chk 1 role-alias-exact || chk 0 role-alias-exact

  # 6. --text-file brief ASSEMBLY (defect fix 2026-09-11, HQ report d72bd52d).
  #    `brief="${text}"` read ONLY --text: text_file was validated (244) and
  #    hashed into the wave-id (245) and then NEVER loaded, so every
  #    --text-file wave shipped "(see title)" + the RELOAD line and NOTHING
  #    else — while the receipt still read brief-ok(N chars). ZERO of the
  #    assertions above exercise this path, which is exactly why a 2078-char
  #    brief shipped as 136 chars unnoticed. The tell was the character COUNT,
  #    so the assertion must measure the EMITTED BRIEF, not merely the rc —
  #    both paths return rc 0, and that is the whole defect.
  BRIEF="$T/brief.md"
  { printf 'PROBE-FILE-BODY '; head -c 300 /dev/zero | tr '\0' 'Z'; } > "$BRIEF"
  BN="$(wc -c < "$BRIEF" | tr -d ' ')"
  tf_run() { # $1=run dir; remaining args = brief-source flags
    local rd="$1"; shift
    rm -f "$T/fake-notify-log"; touch "$T/fake-notify-log"
    OC_NOTIFY_DB="$T/db.sqlite" OC_NOTIFY_BIN="$T/fake-notify" \
    OC_FANOUT_SELF="00000000-0000-4000-8000-00000000dead" OC_FANOUT_LEDGER="$LEDG" \
    OC_FANOUT_FORUM_CHAT="$FORUM" OC_FANOUT_SEND_TIMEOUT=5 OC_FANOUT_RUN_DIR="$rd" \
    FAKE_NOTIFY_LOG="$T/fake-notify-log" \
      bash "$0" --title T --no-stamp "$@" 2>&1 || true
  }
  sent_brief() { # the logged argv is "... --text <brief> <target-uuid>"; drop the uuid
    local b; b="$(sed -n 's/.*--text //p' "$T/fake-notify-log")"
    printf '%s' "${b% $L1}"
  }
  # distinct run dirs: the wave-id hashes title+brief, so A and B would collide
  # on one lock/.sent file and the second run would SKIP as DUPLICATE.
  tf_run "$T/run-tf1" --text-file "$BRIEF" >/dev/null
  A_B="$(sent_brief)"; A_L=${#A_B}
  tf_run "$T/run-tf2" --text "$(cat "$BRIEF")" >/dev/null
  B_B="$(sent_brief)"; B_L=${#B_B}
  [ "$A_B" = "$B_B" ] && chk 0 text-file-matches-text-form || chk 1 "text-file-matches-text-form (A=$A_L B=$B_L)"
  case "$A_B" in
    "PROBE-FILE-BODY "*) chk 0 text-file-brief-carries-content ;;
    *) chk 1 "text-file-brief-carries-content (got '$(printf '%s' "$A_B" | cut -c1-30)...')" ;;
  esac
  # A brief that is only the placeholder is FAR shorter than the file. This is
  # the length tell that caught the defect in production; asserting the count
  # (not just the content) is what makes the assertion non-vacuous, because the
  # pre-fix code emitted a well-formed brief that simply was not the file.
  [ "$A_L" -gt "$BN" ] && chk 0 text-file-brief-longer-than-placeholder || chk 1 "text-file-brief-longer-than-placeholder (brief=$A_L file=$BN)"
  # A missing --text-file must still die rc 2 rather than silently fall through
  # to the placeholder — the guard at 244 is the only thing standing between a
  # typo'd path and another empty-brief wave.
  OC_NOTIFY_BIN="$T/fake-notify" bash "$0" --title T --no-stamp \
    --text-file "$T/does-not-exist.md" >/dev/null 2>&1 && rc_mf=0 || rc_mf=$?
  [ "$rc_mf" = 2 ] && chk 0 text-file-missing-rc2 || chk 1 "text-file-missing-rc2 (got rc=$rc_mf)"

  echo "oc-notify-fanout selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]
  exit $?
fi

title="" text="" text_file="" roles="" excludes="" dry=0 stamp=1 include_self=0
forum_chat="${OC_FANOUT_FORUM_CHAT:--1003936827469}"
while [ $# -gt 0 ]; do case "$1" in
  --title) title="${2:-}"; shift 2 ;;
  --text) text="${2:-}"; shift 2 ;;
  --text-file) text_file="${2:-}"; shift 2 ;;
  --roles) roles="${2:-}"; shift 2 ;;
  --exclude) excludes="${2:-}"; shift 2 ;;
  --forum-chat) forum_chat="${2:-}"; shift 2 ;;
  --dry-run) dry=1; shift ;;
  --no-stamp) stamp=0; shift ;;
  --include-self) include_self=1; shift ;;
  --help|-h) sed -n '2,40p' "$0"; exit 0 ;;
  *) die "unknown flag '$1' (see --help)" ;;
esac; done

version="$(sed -n 's/^version:[[:space:]]*//p' "$SKILL_DIR/SKILL.md" | head -1)"
[ -n "$version" ] || die "cannot read version from SKILL.md"
[ -n "$title" ] || die "usage: --title required"
[ -f "$LEDGER" ] || die 3 "roster missing: $LEDGER"
bin="$(oc_notify_resolve_bin)" || die "notify binary unresolvable (set OC_NOTIFY_BIN)"

# LAW 7/8 — wave-id + lock + sent-ledger. wave-id derives from title+brief so
# the same wave re-run (retry, resume) hashes identically while any content
# change forks a new wave. Locks/receipts live in <skill-repo>/run/ (gitignored).
RUN_DIR="${OC_FANOUT_RUN_DIR:-$SKILL_DIR/run}"
mkdir -p "$RUN_DIR" 2>/dev/null || die 3 "cannot create run dir: $RUN_DIR"
if [ -n "$text_file" ]; then [ -f "$text_file" ] || die "--text-file missing: $text_file"; fi
wave_text="${title}|$( [ -n "$text_file" ] && cat "$text_file" || echo "${text:-}" )"
wave_id="$(printf '%s' "$wave_text" | sha256sum | cut -c1-12)"
LOCK_FILE="$RUN_DIR/wave-${wave_id}.lock"
SENT_FILE="$RUN_DIR/wave-${wave_id}.sent"

# Live = holder pid alive AND lock < 900s old. Stale = cleared with receipt.
lock_live() { # $1=lockfile -> 0 if live
  local pid ts age
  read -r pid ts _ < "$1" 2>/dev/null || return 1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  age=$(( $(date +%s) - ${ts:-0} ))
  [ "$age" -lt 900 ]
}
if [ "$dry" = 0 ]; then
  exec 9>>"$LOCK_FILE"
  if ! flock -n 9; then
    if lock_live "$LOCK_FILE"; then
      read -r LPID LTS _ < "$LOCK_FILE"
      die "wave ${wave_id} already in progress (holder pid ${LPID:-?} since ${LTS:-?} epoch); concurrent run refused (law 7)" 7
    fi
    printf 'LOCK clear stale wave-%s lock (pid dead or >15min)\n' "$wave_id" >&2
    rm -f "$LOCK_FILE"
    exec 9>>"$LOCK_FILE"
    flock -n 9 || die "wave ${wave_id} lock contention unresolved" 7
  fi
  # flock acquired — but a live holder may have stamped the lockfile in the
  # race window before its own flock (or be holding it via another fd). The
  # lockfile CONTENT is the authority for the refuse verdict (law 7).
  if [ -s "$LOCK_FILE" ]; then
    read -r LPID LTS _ < "$LOCK_FILE" || true
    if [ "${LPID:-}" != "$$" ] && lock_live "$LOCK_FILE"; then
      die "wave ${wave_id} already in progress (holder pid ${LPID:-?} since ${LTS:-?} epoch); concurrent run refused (law 7)" 7
    fi
    printf 'LOCK clear stale wave-%s lock (pid dead or >15min)\n' "$wave_id" >&2
  fi
  printf '%s %s %s\n' "$$" "$(date +%s)" "$wave_id" > "$LOCK_FILE"
fi

LIVE_SESSIONS="$(mktemp /tmp/fanout-sessions.XXXXXX)"
IN_SCOPE_SESSIONS="$(mktemp /tmp/fanout-scope.XXXXXX)"
# FULL-ID roster from the profile session DB (READ-ONLY, ~0s) — v0.4.129:
# session list prints only 8-char prefixes and session get costs ~37s/call;
# the DB is the canonical full-id source (CLI list ≡ archived_at IS NULL AND
# title NOT LIKE 'subagent:%', set-equality verified 2026-09-09). OC_NOTIFY_DB
# overrides the path for selftests.
sqlite3 "file:${OC_NOTIFY_DB:-$HOME/.opencrabs/profiles/${PROFILE}/opencrabs.db}?mode=ro" \
  "SELECT id FROM sessions WHERE archived_at IS NULL AND (title IS NULL OR title NOT LIKE 'subagent:%');" \
  > "$LIVE_SESSIONS" 2>/dev/null || die 3 "session DB unreadable — cannot validate targets"
# FORUM-SCOPE roster (law 6): sessions bound to the opencrabs-dev forum chat.
# One query, same read-only DB; empty roster = nothing is sendable (safe).
sqlite3 "file:${OC_NOTIFY_DB:-$HOME/.opencrabs/profiles/${PROFILE}/opencrabs.db}?mode=ro" \
  "SELECT b.session_id FROM session_bindings b JOIN sessions s ON s.id = b.session_id
   WHERE s.archived_at IS NULL AND b.chat_id = '$forum_chat';" \
  > "$IN_SCOPE_SESSIONS" 2>/dev/null || die 3 "session DB unreadable — cannot resolve forum scope"

# --text-file is loaded HERE, not merely hashed. The first cut validated the
# file (244), hashed its content into the wave-id (245) — and then never read
# it into `text`, so EVERY --text-file wave shipped the "(see title)"
# placeholder plus the auto-appended RELOAD line and NOTHING ELSE (silent-
# failure defect, fixed 2026-09-11 on HQ report d72bd52d). The receipts looked
# plausible — brief-ok(136 chars) — which is precisely why it survived a
# 2078-char brief; only the character count gave it away, and the selftest had
# no --text-file assertion to notice. Loaded into `text` (not just into the
# brief assembly) so every downstream consumer sees the file content, with
# --text remaining the fallback when no file is given. A file that exists but
# is EMPTY still falls through to the placeholder below, exactly as an empty
# --text does — the two paths stay symmetric.
if [ -n "$text_file" ]; then text="$(cat "$text_file")"; fi

[ -n "$text" ] || text="(see title)"

canon_role() { # ontology fold 2026-09-11 (c586e61f): the HQ role string was
  # `hq-supervisor`, now `hq`. Legacy selectors must keep resolving, or a wave
  # dispatched with `--roles hq-supervisor` silently reaches nobody. Twin of the
  # alias in oc-ledger cmd_roster; both carry a selftest assertion.
  case "$1" in hq-supervisor|HQ-SUPERVISOR) printf 'hq' ;; *) printf '%s' "$1" ;; esac
}
want_role() { # $1=role -> 0 if selected by --roles filter
  [ -z "$roles" ] && return 0
  # Exact comma-delimited match, as before — but canonicalised on BOTH sides so
  # the legacy `hq-supervisor` selector and the new `hq` selector each match the
  # row whichever spelling the row happens to carry.
  local r s IFS=','
  r="$(canon_role "$1")"
  for s in $roles; do
    [ "$(canon_role "$s")" = "$r" ] && return 0
  done
  return 1
}
excluded() { # $1=uuid $2=topic -> 0 if excluded (8-char prefix or full uuid or topic)
  local t
  local IFS=','
  for t in $excludes; do
    case "$1" in "$t"*) return 0 ;; esac
    [ -n "${2:-}" ] && [ "$2" = "$t" ] && return 0
  done
  return 1
}
self_uuid="${OC_FANOUT_SELF:-2fae1230-de9e-4fa5-aa24-822cf7188c3e}"

zero_segment() { case "$1" in *-0000-*|*-00000000*) return 0 ;; esac; return 1; }

validate_target() { # $1=uuid -> 0 ok; else echo reason
  local u="$1"
  case "$u" in
    [0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*) ;; # 8-4-4-4-12 shape
    *) echo "malformed uuid"; return 1 ;;
  esac
  if zero_segment "$u"; then echo "placeholder/all-zero-segment uuid (n=2167 class)"; return 1; fi
  # FULL-ID roster match (v0.4.129, same source as oc-waiter): the cached
  # DB roster holds canonical full uuids; a frankenstein id (real prefix +
  # foreign tail, n=2221 class) fails the exact match. All-zero segments
  # die before this check (n=2167 placeholder class).
  if ! grep -qxF "$u" "$LIVE_SESSIONS" 2>/dev/null; then
    echo "not a live session (full-id absent from session DB roster)"; return 1
  fi
  return 0
}

sent=0 skipped=0 failed=0 receipts="" ids=""
while IFS=$'\t' read -r uuid role topic; do
  [ -n "$uuid" ] || continue
  [ "$uuid" = "$self_uuid" ] && [ "$include_self" = 0 ] && continue
  want_role "$role" || continue
  if excluded "$uuid" "$topic"; then
    receipts+="SKIP ${uuid} ${role} excluded(${topic:-no-topic})"$'\n'; skipped=$((skipped+1)); continue
  fi
  if reason="$(validate_target "$uuid")"; then :; else
    receipts+="SKIP ${uuid} ${role} ${reason}"$'\n'; skipped=$((skipped+1)); continue
  fi
  # LAW 6 — forum-scope guard: the session must be bound to the opencrabs-dev
  # forum chat. Unbound or bound-elsewhere targets are never woken (an unbound
  # session's notify lands wherever its default route points — a DM, another
  # group — which is exactly the leak this guard closes).
  if ! grep -qxF "$uuid" "$IN_SCOPE_SESSIONS" 2>/dev/null; then
    receipts+="SKIP ${uuid} ${role} SCOPE(not-bound-to-forum-${forum_chat})"$'\n'; skipped=$((skipped+1)); continue
  fi
  # LAW 8 — per-lane idempotency: already-sent lanes never re-notify.
  if [ "$dry" = 0 ] && grep -qxF "$uuid" "$SENT_FILE" 2>/dev/null; then
    receipts+="SKIP ${uuid} ${role} DUPLICATE(already-sent-wave-${wave_id})"$'\n'; skipped=$((skipped+1)); continue
  fi
  brief="${text}"
  brief="${brief//\{\{UUID\}\}/${uuid}}"
  brief="${brief//\{\{VERSION\}\}/${version}}"
  brief="${brief} RELOAD: run oc-drift-check ${uuid} ${version} --ack, re-read changed files. ACK after drift-check."
  case "$brief" in *'{{'*'}}'*)
    receipts+="ABORT ${uuid} ${role} placeholder-token-survived-substitution(law1)"$'\n'
    failed=$((failed+1)); continue ;;
  esac
  if [ "$dry" = 1 ]; then
    receipts+="DRY ${uuid} ${role} brief-ok(${#brief} chars)"$'\n'; sent=$((sent+1)); continue
  fi
  # n=2221 hang fix: `session notify` to a wedged target can block indefinitely;
  # with ~33 targets one hang starves the whole fanout and NO receipts flush.
  # Per-send timeout + receipts printed INCREMENTALLY (flush before each send),
  # so a mid-run hang leaves every prior receipt on stdout.
  # n=2269 fix (v0.4.126): measured live latency of `session notify` is ~30s
  # UNIFORM (probe A plain=34s, probe B --title=31s — --title NOT the delta).
  # The old 20s default killed EVERY send rc=124 while delivery actually
  # worked. Default raised to 90s; each receipt carries send latency.
  if [ -z "${OC_FANOUT_SEND_TIMEOUT:-}" ]; then OC_FANOUT_SEND_TIMEOUT=90; fi
  printf '%s' "$receipts"   # incremental flush: receipts survive a mid-send hang
  receipts=""
  T0=$(date +%s%N)
  out="$(timeout "$OC_FANOUT_SEND_TIMEOUT" "$bin" session notify --profile "$PROFILE" --sender "$SENDER" \
        --title "$title" --text "$brief" "$uuid" 2>&1)" && rc=0 || rc=$?
  if [ "$rc" = 3 ]; then  # mid-turn: interrupt-retry per lib contract
    out="$(timeout "$OC_FANOUT_SEND_TIMEOUT" "$bin" session notify --profile "$PROFILE" --sender "$SENDER" \
          --title "$title" --text "$brief" --interrupt "$uuid" 2>&1)" && rc=0 || rc=$?
  fi
  T1=$(date +%s%N)
  LAT_MS=$(( (T1 - T0) / 1000000 ))
  nid="$(printf '%s' "$out" | grep -oE 'notification id [0-9a-f-]+' | head -1 || true)"
  if [ "$rc" = 0 ]; then
    receipts+="SENT ${uuid} ${role} ${nid:-rc0-no-id} ${LAT_MS}ms"$'\n'
    ids+="${nid:-rc0} " ; sent=$((sent+1))
    printf '%s\n' "$uuid" >> "$SENT_FILE"   # law 8: append-one-per-send idempotency receipt
  else
    receipts+="FAIL ${uuid} ${role} rc=${rc} ${LAT_MS}ms"$'\n'; failed=$((failed+1))
  fi
done < <(jq -r '.workers[] | [(.uuid // ""), (.role // "editor"), ((.topic_id // 0) | tostring)] | @tsv' "$LEDGER")

echo "--- receipts ---"; printf '%s' "$receipts"
echo "--- summary ---"
echo "sent=$sent skipped=$skipped failed=$failed version=$version dry=$dry"
if [ "$stamp" = 1 ] && [ "$dry" = 0 ] && [ "$sent" -gt 0 ]; then
  bash "$SKILL_DIR/tools/oc-ledger" stamp notify-fanout \
    "fanout '$title': sent=$sent skipped=$skipped failed=$failed ids: ${ids:-none}" || true
fi
[ "$failed" = 0 ] || exit 4
exit 0
