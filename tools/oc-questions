def selftest():
    import shutil
    import subprocess

    fails = []

    def ck(cond, msg):
        print(("  ok   - " if cond else "  FAIL - ") + msg)
        if not cond:
            fails.append(msg)

    tool = os.path.abspath(__file__)
    root = tempfile.mkdtemp(prefix="oc-questions-selftest-")
    env = dict(os.environ)
    env["OC_QUESTIONS_DIR"] = os.path.join(root, "store")
    # A DB path that does NOT exist forces the derived leg down its SKIP branch,
    # which the selftest asserts is DISCLOSED — never a silent clean.
    env["OC_QUESTIONS_DB"] = os.path.join(root, "absent.db")
    env["OC_TOOLS_NOLOG"] = "1"
    env["OC_QUESTIONS_BASE_URL"] = PRODUCTION_BASE_URL
    # The Node renderer resolves its bare imports against node_modules BESIDE
    # the render file, so the fixture links the real installed tree into its own
    # render dir. A symlink keeps the test from writing the live store while
    # still exercising the json-render path rather than silently falling back.
    fixture_render = os.path.join(root, "render")
    real_modules = os.path.join(profile_home(), "questions", "build", "node_modules")
    try:
        os.makedirs(fixture_render, exist_ok=True)
        link = os.path.join(fixture_render, "node_modules")
        if os.path.isdir(real_modules) and not os.path.exists(link):
            os.symlink(real_modules, link)
    except OSError:
        pass
    env["OC_QUESTIONS_RENDER_DIR"] = fixture_render

    def run(*args):
        proc = subprocess.run([tool] + list(args), env=env, capture_output=True,
                              text=True, timeout=90)
        return proc.returncode, proc.stdout, proc.stderr

    def store_json():
        with open(os.path.join(env["OC_QUESTIONS_DIR"], "open.json"),
                  encoding="utf-8") as fh:
            return json.load(fh)

    def get_set(sid):
        """None instead of an exception: a missing set is a FAIL row, not a
        traceback. A selftest that dies mid-way reports nothing at all."""
        for item in store_json()["sets"]:
            if item.get("id") == sid:
                return item
        return None

    session_a = "11111111-2222-3333-4444-555555555555"
    try:
        # -- 1. ask -> list -------------------------------------------------
        rc, out, _ = run("ask", "--lane", "Cron lane", "--session", session_a,
                         "--questions-json", json.dumps([
                             {"title": "Ship the second half?",
                              "description": "**Context:** measured.",
                              "options": ["Ship", "Hold"], "recommended": 1},
                             {"title": "Which cadence?",
                              "description": "Two options.",
                              "options": ["6h", "12h"], "recommended": 0},
                         ]))
        ck(rc == 0, "ask registers a set (rc=%d)" % rc)
        rc, out, _ = run("list")
        ck(rc == 0 and "Ship the second half?" in out and "Which cadence?" in out,
           "list shows the registered questions")

        # -- 2. ORDER + PER-QUESTION RECOMMENDATIONS (owner criterion) ------
        sets = store_json()["sets"]
        ck(len(sets) == 1, "exactly one set registered (%d)" % len(sets))
        entry = sets[0] if sets else {}
        set_id = entry.get("id", "")
        questions = entry.get("questions", [])
        ck([q.get("qid") for q in questions] == ["q1", "q2"],
           "question order is CALL order (q1, q2)")
        ck(len(questions) == 2 and questions[0].get("recommended") == 1
           and questions[1].get("recommended") == 0,
           "per-question recommendations preserved (1 then 0, not shared)")
        ck(len(set_id) == SET_ID_LEN, "set id is %d chars (%r)" % (SET_ID_LEN, set_id))

        # -- 3. CONCURRENT ASK: two writers lose NEITHER (owner criterion) --
        procs = [subprocess.Popen(
            [tool, "ask", "--lane", "Race %d" % i, "--session",
             "aaaaaaaa-bbbb-cccc-dddd-00000000000%d" % i,
             "--title", "Race question %d" % i, "--description", "concurrent"],
            env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            for i in (1, 2)]
        codes = [p.wait(timeout=90) for p in procs]
        ck(codes == [0, 0], "two concurrent ask calls both exit 0 (%s)" % codes)
        racers = [s for s in store_json()["sets"] if s["lane"].startswith("Race ")]
        ck(len(racers) == 2,
           "NEITHER concurrent set was lost (%d of 2 present)" % len(racers))
        ck(len({s["id"] for s in store_json()["sets"]}) == 3,
           "…and the ids are distinct (3 sets, 3 ids)")
        ck(os.path.isfile(os.path.join(env["OC_QUESTIONS_DIR"], "open.json")),
           "the atomic replace left a complete register, not a .tmp")

        # -- 4. C1/C2/C3: the session comes from the ENV, ask returns the
        # TOTAL, and the card/button leg is GONE (owner order 2026-09-24:
        # "the calling lane should not get a card with buttons. delete that leg
        # - the user decisions are collected via the page").
        ck("render" not in _VERBS,
           "the card leg is DELETED -- render is not a verb any more")
        gone = "def cmd_" + "render"
        ck(gone not in open(os.path.abspath(__file__), encoding="utf-8").read(),
           "\u2026and the function is gone from the source, not merely unrouted")
        envask = dict(env)
        envask["OPENCRABS_SESSION_ID"] = session_a
        proc = subprocess.run([tool, "ask", "--lane", "Env lane",
                               "--title", "t", "--description", "d",
                               "--option", "a", "--option", "b",
                               "--recommended", "0", "--no-publish", "--json"],
                              env=envask, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 0,
           "ask needs NO --session when OPENCRABS_SESSION_ID is set (rc=%d)"
           % proc.returncode)
        envset = {}
        try:
            envset = json.loads(proc.stdout)
        except ValueError:
            pass
        ck(envset.get("entry", {}).get("session") == session_a,
           "\u2026and it records the ENV session as the return address (%r)"
           % envset.get("entry", {}).get("session"))
        ck(isinstance(envset.get("open_questions"), int)
           and envset["open_questions"] >= 1,
           "ask returns the OPEN-QUESTION TOTAL, not a card payload (%r)"
           % envset.get("open_questions"))
        ck("cards" not in envset and "buttons" not in envset,
           "\u2026and the payload carries no card and no buttons")
        # The owner reads the TEXT, so the total must be there too -- asserting
        # only the JSON field let the human-readable half be removed silently.
        proc = subprocess.run([tool, "ask", "--lane", "Text lane",
                               "--title", "t", "--description", "d"],
                              env=envask, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 0 and "open question(s) across" in proc.stdout,
           "ask PRINTS the open-question total, not only a json field (%r)"
           % proc.stdout.strip().splitlines()[-2:])

        # an env var that is not a UUID is refused: the register must hold a
        # REAL return address, not a guess.
        envbad = dict(env)
        envbad["OPENCRABS_SESSION_ID"] = "not-a-uuid"
        proc = subprocess.run([tool, "ask", "--lane", "Bad env",
                               "--title", "t", "--description", "d"],
                              env=envbad, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 2,
           "a non-UUID OPENCRABS_SESSION_ID is refused rc=2 (rc=%d)"
           % proc.returncode)
        envnone = dict(env)
        envnone.pop("OPENCRABS_SESSION_ID", None)
        proc = subprocess.run([tool, "ask", "--lane", "No addr",
                               "--title", "t", "--description", "d"],
                              env=envnone, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 2,
           "with no session anywhere, ask refuses rather than registering a "
           "question whose answer has nowhere to go (rc=%d)" % proc.returncode)

        # -- 5. answer, idempotence, clarify -------------------------------
        rc, out, _ = run("answer", set_id, "q1", "1", "--via", "card")
        ck(rc == 0 and "Hold" in out,
           "answer records the OPTION TEXT, not the index (%r)" % out.strip()[:40])
        rc, out, _ = run("answer", set_id, "q1", "1", "--via", "card")
        ck(rc == 3, "re-submit on a closed question is rc=3, idempotent (rc=%d)" % rc)
        rc, out, _ = run("answer", set_id, "q2", "clarify", "--text", "explain 12h")
        ck(rc == 0, "clarify is recorded (rc=%d)" % rc)
        current = get_set(set_id)
        q2 = (current or {}).get("questions", [{}, {}])
        q2 = q2[1] if len(q2) > 1 else {}
        ck(q2.get("status") == "clarifying" and q2.get("answer") == "explain 12h",
           "clarify does NOT close the question (status=%r)" % q2.get("status"))
        ck(set_id in {s["id"] for s in store_json()["sets"]},
           "…and the SET stays live while a question is merely clarifying")
        rc, _, _ = run("answer", set_id, "q2", "0")
        ck(rc == 0, "a later real answer closes the clarifying question")
        ck(set_id not in {s["id"] for s in store_json()["sets"]},
           "a fully answered set leaves the LIVE register")
        archive = os.path.join(env["OC_QUESTIONS_DIR"], "archive.jsonl")
        ck(os.path.isfile(archive) and set_id in open(archive, encoding="utf-8").read(),
           "…and is appended to archive.jsonl (append-only)")

        # -- 6. lint --------------------------------------------------------
        rc, _, _ = run("ask", "--lane", session_a, "--session", session_a,
                       "--title", "uuid lane", "--description", "x")
        ck(rc == 2, "a session id as --lane is REFUSED (rc=%d)" % rc)
        rc, _, _ = run("ask", "--lane", "Leaky lane", "--session", session_a,
                       "--questions-json", json.dumps([
                           {"title": "Leak", "description": "key at /root/x"}]))
        ck(rc == 0, "a name lane with leaky text still registers (lint, not ask, judges it)")
        rc, out, _ = run("lint", "--json")
        findings = json.loads(out)["findings"]
        ck(rc == 1 and any("secret" in f["why"] for f in findings),
           "lint finds the secret pattern and returns rc=1")

        # -- 7. gc: TTL expiry ---------------------------------------------
        path = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        data = store_json()
        for item in data["sets"]:
            if item["lane"] == "Leaky lane":
                item["asked_at"] = "2020-01-01T00:00:00+00:00"
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        rc, out, _ = run("gc", "--dry-run", "--json")
        dry = json.loads(out)
        ck(dry["expired"] >= 1 and dry["archived"] == 0,
           "gc --dry-run reports the expiry without writing (expired=%d)" % dry["expired"])
        rc, out, _ = run("gc", "--json")
        result = json.loads(out)
        ck(result["archived"] >= 1,
           "gc archives the expired set (archived=%d)" % result["archived"])

        # -- 8. publish: token, noindex, TTL, prune ------------------------
        rc, _, _ = run("ask", "--lane", "Page lane", "--session", session_a,
                       "--questions-json", json.dumps([
                           {"title": "Rendered?",
                            "description": "| option | cost |\n|---|---|\n"
                                           "| 6h | 4/day |\n| 12h | 2/day |\n\n"
                                           "```mermaid\nflowchart TD\n  A --> B\n```",
                            "options": ["6h", "12h"], "recommended": 0}]))
        ck(rc == 0, "a description with a table and a mermaid fence registers")
        rc, out, _ = run("publish", "--json")
        page = json.loads(out)
        ck(rc == 0 and page["token"] and len(page["token"]) >= 20,
           "publish mints an unguessable token (%r)" % (page["token"][:8] + "..."))
        body = open(os.path.join(page["path"], "index.html"), encoding="utf-8").read()
        ck("noindex" in body, "the page carries the noindex directive")
        ck("<table>" in body, "a Markdown table in a description renders as a <table>")
        ck("mermaid.ink" in body, "a ```mermaid fence renders through mermaid.ink")
        # owner-visible misrender: the emitted form had NO stylesheet rule at
        # all, so a bare <textarea> (inline, ~20 columns by default) collapsed
        # the free-text field and both buttons onto one line.
        for _rule in ("form{", "textarea{", "form button{"):
            ck(_rule in body, "the stylesheet carries the %s rule" % _rule)
        # the age helper already ended in a unit word, so the call sites'
        # "asked " prefix rendered the double-worded "asked 1.7h old".
        _ages = set(re.findall(r"asked [0-9a-z.]* (ago|old)", body))
        ck(_ages == {"ago"},
           "the age paragraph is not double-worded (%r)" % (sorted(_ages),))
        meta = json.load(open(os.path.join(page["path"], "meta.json"), encoding="utf-8"))
        created, expires = parse_iso(meta["created_at"]), parse_iso(meta["expires_at"])
        ck(created and expires and (expires - created).days == PAGE_TTL_DAYS,
           "the page TTL is %d days" % PAGE_TTL_DAYS)
        rc, _, _ = run("render", "--set", set_id, "--json")
        ck(rc == 2, "the DELETED render verb is unknown -> rc=2 (rc=%d)" % rc)

        # expiry behaviour: backdate the meta, then prune
        meta["expires_at"] = "2020-01-01T00:00:00+00:00"
        with open(os.path.join(page["path"], "meta.json"), "w", encoding="utf-8") as fh:
            json.dump(meta, fh)
        rc, out, _ = run("publish", "--prune", "--json")
        ck(not os.path.exists(page["path"]),
           "an expired token directory is pruned by publish --prune")
        ck(page["token"] in json.loads(out).get("pruned", []),
           "…and the pruned token is reported, not removed silently")

        # -- 8b. C7: the page URL is STABLE across re-renders, and C4:
        # a register mutation re-publishes the page. Owner: "I want the page to
        # be rerendered after each question list set of changes". Implemented
        # against a mint-per-publish token, that 404s the link he bookmarked --
        # so re-render-on-change and a stable URL have to hold together.
        ck(page_url("tok") == base_url() + "/tok/",
           "page_url joins the base origin and the token")
        saved_base = os.environ.pop("OC_QUESTIONS_BASE_URL", None)
        ck(base_url() == PRODUCTION_BASE_URL,
           "with no override the base origin is the production host (%s)" % base_url())
        if saved_base is not None:
            os.environ["OC_QUESTIONS_BASE_URL"] = saved_base

        rc, out, _ = run("publish", "--json")
        first = json.loads(out)
        pointer = os.path.join(env["OC_QUESTIONS_DIR"], "pages", "latest.json")
        ck(os.path.isfile(pointer),
           "publish records pages/latest.json -- the pointer the tool reads")
        rc, out, _ = run("publish", "--json")
        second = json.loads(out)
        ck(second["token"] == first["token"],
           "two consecutive publishes REUSE one token -- the URL does not churn "
           "(%r vs %r)" % (first["token"][:8], second["token"][:8]))
        ck(len([d for d in os.listdir(os.path.join(env["OC_QUESTIONS_DIR"], "pages"))
                if d != "latest.json"]) == 1,
           "\u2026so exactly ONE live page directory exists, not one per publish")
        rc, out, _ = run("publish", "--rotate", "--json")
        rotated = json.loads(out)
        ck(rotated["token"] != first["token"],
           "--rotate mints a new URL explicitly (the escape hatch)")
        rc, out, _ = run("publish", "--json")
        ck(json.loads(out)["token"] == rotated["token"],
           "\u2026and the new token is the one subsequently reused")

        # C4: a mutation re-publishes, so the page is never hours stale.
        before = json.load(open(pointer, encoding="utf-8"))
        rc, out, _ = run("ask", "--lane", "Republish lane", "--session", session_a,
                         "--title", "t", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        ck(rc == 0, "ask with auto-republish exits 0 (rc=%d)" % rc)
        asked = json.loads(out)
        ck(asked.get("page", "").endswith(before["token"] + "/"),
           "ask returns the page url (%r)" % asked.get("page"))
        after = json.load(open(pointer, encoding="utf-8"))
        ck(after.get("token") == before["token"],
           "the auto-republish did NOT move the URL (token unchanged)")
        body = open(os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                                 after["token"], "index.html"), encoding="utf-8").read()
        ck("Republish lane" in body,
           "\u2026and the re-rendered page actually carries the new set")
        rc, out, _ = run("ask", "--lane", "No publish lane", "--session", session_a,
                         "--title", "t", "--description", "d", "--no-publish", "--json")
        ck(rc == 0 and json.loads(out).get("page") is None,
           "--no-publish suppresses the refresh (rc=%d)" % rc)

        # A publish fault must never fail the mutation that triggered it.
        rc, out, err = run("ask", "--lane", "Broken page lane", "--session", session_a,
                           "--title", "t", "--description", "d", "--json",
                           "--no-publish")
        ck(rc == 0, "the mutation succeeds regardless of the page (rc=%d)" % rc)

        # -- 8b2. the json-render page (owner order 2026-09-24: "rewrite for
        # json-render"). The page BODY is now a typed SPEC rendered by a Node
        # process; the shell stays in Python. These are the four legs HQ asked
        # for, plus the two properties that would break the live endpoint.
        rc, out, _ = run("publish", "--json")
        page = json.loads(out)
        body = open(os.path.join(page["path"], "index.html"), encoding="utf-8").read()
        ck(not re.search(r"<script", body, re.I),
           "1. the rendered page carries NO <script> (the static property)")
        ck('name="token"' in body and 'name="set"' in body and 'name="qid"' in body,
           "2. the form carries token + set + qid as hidden inputs -- the submit "
           "contract the answer backend reads")
        ck('action="/answer"' in body,
           "\u2026and the action is the absolute /answer path")
        ck("noindex" in body, "\u2026and the noindex directive survives the rewrite")
        # Per-question, because the page carries EVERY open set: a global count
        # of "checked" measures the register size, not the recommendation.
        # Per-question, because the page carries EVERY open set: a global count
        # of "checked" measures the register size, not the recommendation. The
        # assertion is attribute-ORDER agnostic on purpose: React emits
        # checked="" BEFORE value, the Python fallback emits value="N" checked,
        # and a leg that assumes one order tests the renderer's ordering rather
        # than the recommendation.
        radios = re.findall(r"<input[^>]*type=\"radio\"[^>]*>", body)
        ck(bool(radios), "3. the page renders radio inputs")
        checked = [r for r in radios if "checked" in r]
        ck(len(checked) >= 1, "\u2026and a recommended option renders checked")
        ck(len(checked) < len(radios),
           "\u2026while a NON-recommended option does not (%d of %d checked)"
           % (len(checked), len(radios)))
        ck("<table>" in body and "mermaid.ink" in body,
           "4. a Markdown table and a ```mermaid fence still reach the page "
           "through RichText")

        # The spec is DATA, so its structure is assertable without parsing HTML
        # -- which is the whole reason for the rewrite.
        spec = build_spec([{"id": "abc123", "lane": "L", "asked_at": None,
                            "questions": [{"qid": "q1", "title": "T",
                                           "description": "d",
                                           "options": ["A", "B"],
                                           "recommended": 1}]}],
                          "tok", "2026-01-01T00:00:00+00:00", "/answer")
        ck(spec["root"] == "page" and spec["elements"]["page"]["type"] == "Page",
           "the spec has a named root element")
        ck(spec["elements"]["abc123-q1-o1"]["props"]["recommended"] is True
           and spec["elements"]["abc123-q1-o0"]["props"]["recommended"] is False,
           "\u2026and the recommended option is marked in the SPEC, not in a string")
        ck(all(isinstance(spec["elements"][k].get("children"), list)
               for k in spec["elements"]),
           "\u2026and every element carries a children LIST (the flat contract)")
        ck(set(spec["elements"]) >= {"page", "set-abc123", "abc123-q1"},
           "the spec nests page -> set -> question by KEY")

        # Owner order 2026-09-24: a renderer fault must fail the COMMAND, not
        # the page. Point the build dir at an impossible path and assert all
        # four halves: non-zero, reason on stderr, nothing written, last good
        # page byte-identical.
        before_dirs = sorted(os.listdir(pages_dir()))
        good_path = os.path.join(page["path"], "index.html")
        good_body = open(good_path, encoding="utf-8").read()
        broke = dict(env)
        broke["OC_QUESTIONS_RENDER_DIR"] = "/proc/nonexistent/build"
        proc = subprocess.run([tool, "publish"], env=broke,
                              capture_output=True, text=True, timeout=120)
        ck(proc.returncode != 0,
           "a renderer fault exits NON-ZERO (rc=%d)" % proc.returncode)
        ck("renderer fault" in proc.stderr,
           "\u2026and names the fault on stderr (%r)" % proc.stderr.strip()[-80:])
        ck(sorted(os.listdir(pages_dir())) == before_dirs,
           "\u2026and writes no page and creates no token dir (%r)"
           % (sorted(os.listdir(pages_dir())),))
        ck(open(good_path, encoding="utf-8").read() == good_body,
           "\u2026and the previous page is byte-identical, so the last good URL "
           "still serves instead of a 404")
        ck(render_via_node({"root": "page", "elements": {}})[1] is not None,
           "render_via_node reports a REASON on failure, never raises")

        # -- 8c. C5: amend -- the CLARIFY return leg. A Clarify click used to
        # dead-end: status=clarifying and the question could never be answered
        # again, so the loop never closed and the owner never saw the answer.
        rc, out, _ = run("ask", "--lane", "Amend lane", "--session", session_a,
                         "--title", "Original?", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        am_set = json.loads(out)["set"]
        run("answer", am_set, "q1", "clarify", "--text", "what do you mean")
        ck(get_set(am_set)["questions"][0]["status"] == "clarifying",
           "clarify records status=clarifying")
        rc, out, _ = run("answer", am_set, "q1", "0")
        ck(rc == 0, "a clarifying question is still ANSWERABLE (rc=%d)" % rc)
        # amend on a set whose only question is answered: the set archived, so
        # amend must REPORT that rather than silently doing nothing.
        rc, _, _ = run("amend", "--set", am_set, "--qid", "q1", "--title", "x")
        ck(rc == 1, "amend on a closed/archived set is rc=1 (rc=%d)" % rc)
        # the real clarify loop, in order: ask -> clarify -> amend -> answer
        rc, out, _ = run("ask", "--lane", "Clarify lane", "--session", session_a,
                         "--title", "Clarify me?", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        am_set = json.loads(out)["set"]
        run("answer", am_set, "q1", "clarify", "--text", "what do you mean")
        ck(get_set(am_set)["questions"][0]["status"] == "clarifying",
           "the clarify loop starts from a clarifying question")
        rc, out, _ = run("amend", "--set", am_set, "--qid", "q1",
                         "--title", "Rewritten?", "--description", "d2",
                         "--option", "x", "--option", "y", "--recommended", "1",
                         "--json")
        ck(rc == 0, "amend exits 0 (rc=%d)" % rc)
        amended = json.loads(out)
        ck(amended["status"] == "open" and amended["was"] == "clarifying",
           "amend returns the question to OPEN (%r -> %r)"
           % (amended["was"], amended["status"]))
        ck(amended["amend_count"] == 1, "amend records an amend count")
        question = get_set(am_set)["questions"][0]
        ck(question["title"] == "Rewritten?" and question["options"] == ["x", "y"]
           and question["recommended"] == 1,
           "amend applied title, options and recommendation together")
        ck("answer" not in question,
           "amend CLEARS the stale answer, so the reopened question is clean")
        rc, out, _ = run("answer", am_set, "q1", "1")
        ck(rc == 0 and "y" in out,
           "the amended question is answerable and records the new option")
        rc, _, _ = run("amend", "--set", am_set, "--qid", "q1")
        ck(rc == 2, "amend with no field to change is rc=2 (rc=%d)" % rc)
        rc, _, _ = run("amend", "--set", am_set, "--qid", "nope", "--title", "t")
        ck(rc == 1, "amend on an unknown qid is rc=1 (rc=%d)" % rc)

        # -- 8d. C6: mechanical closure. The register used to close only on an
        # explicit answer or TTL, so questions outlived the thing they asked
        # about. "Never guess" is the contract: an unreadable predicate SKIPS.
        rc, out, _ = run("ask", "--lane", "Mech lane", "--session", session_a,
                         "--title", "Closed by predicate?", "--description", "d",
                         "--close-when", "true", "--json")
        mech_set = json.loads(out)["set"]
        ck(get_set(mech_set)["questions"][0]["status"] == "open",
           "a close_when predicate does not fire at register time")
        rc, out, _ = run("gc", "--json")
        ck("resolved_mechanically" in out,
           "gc reports the mechanical closure by STATUS (rc=%d)" % rc)
        ck(get_set(mech_set)["questions"][0]["status"] == "resolved_mechanically",
           "\u2026and the question is closed as resolved_mechanically")
        ck("closed_reason" in get_set(mech_set)["questions"][0],
           "\u2026with the REASON recorded, never a bare disappearance")

        rc, out, _ = run("ask", "--lane", "Mech no lane", "--session", session_a,
                         "--title", "Must stay open?", "--description", "d",
                         "--close-when", "false", "--json")
        keep_set = json.loads(out)["set"]
        run("gc", "--json")
        ck(get_set(keep_set)["questions"][0]["status"] == "open",
           "a predicate returning non-zero does NOT close the question")

        # A question whose subject names no fork issue and carries no predicate
        # must never be closed by the default arm -- the arm cannot guess.
        rc, out, _ = run("ask", "--lane", "Mech bare lane", "--session", session_a,
                         "--title", "No issue named", "--description", "nothing here",
                         "--json")
        bare_set = json.loads(out)["set"]
        run("gc", "--json")
        ck(get_set(bare_set)["questions"][0]["status"] == "open",
           "the default arm closes NOTHING when no fork issue is named")

        # -- 9. the LOGGING path, unsuppressed -----------------------------
        # This leg exists because every other leg suppresses the unified log, so
        # oc_log_init returned BEFORE time.time(). A missing `import time`
        # therefore left the tool green in fixtures while it crashed on every
        # real invocation. A suppressed-log selftest cannot see that class.
        logfile = os.path.join(root, "tools.log")
        logenv = dict(env)
        logenv.pop("OC_TOOLS_NOLOG", None)
        logenv["OC_TOOLS_LOG"] = logfile
        proc = subprocess.run([tool, "list"], env=logenv, capture_output=True,
                              text=True, timeout=90)
        ck(proc.returncode == 0,
           "the UNSUPPRESSED logging path exits 0 (rc=%d %s)"
           % (proc.returncode, proc.stderr.strip().splitlines()[-1:]))
        rows = []
        if os.path.isfile(logfile):
            with open(logfile, encoding="utf-8") as fh:
                rows = [json.loads(line) for line in fh if line.strip()]
        ck(len(rows) == 1, "…and appends exactly one JSONL row (%d)" % len(rows))
        ck(bool(rows) and rows[0].get("tool") == PROG
           and "secs" in rows[0] and rows[0].get("exit") == 0,
           "…carrying tool/secs/exit per the unified-log schema")

        # WHICH renderer ran is observable ONLY in the log. The contract legs
        # above pass on the Python fallback too -- MEASURED: forcing the fallback
        # left all 114 legs green -- so without this leg nothing proves
        # json-render is actually in use, which is the owner's directive.
        pub_log = os.path.join(root, "publish.log")
        if os.path.isfile(pub_log):
            os.remove(pub_log)
        pubenv = dict(logenv)
        pubenv["OC_TOOLS_LOG"] = pub_log
        proc = subprocess.run([tool, "publish"], env=pubenv, capture_output=True,
                              text=True, timeout=120)
        ck(proc.returncode == 0,
           "publish under the unsuppressed log exits 0 (rc=%d)" % proc.returncode)
        fields = []
        if os.path.isfile(pub_log):
            with open(pub_log, encoding="utf-8") as fh:
                for line in fh:
                    if line.strip():
                        fields.append((json.loads(line).get("extra") or {}))
        ck(any(f.get("renderer") == "json-render" for f in fields),
           "publish records renderer=json-render -- there is exactly ONE "
           "builder, so the artifact states its own provenance (%r)"
           % (fields[-1:] if fields else None,))
        ck(not any("publish_failed" in f for f in fields),
           "…and a SUCCESSFUL publish records no fault, so a degradation cannot "
           "hide behind a green run")

        # -- 10. usage contract (the battery's edge cases) -----------------
        rc, _, _ = run("--help")
        ck(rc == 0, "--help exits 0 (rc=%d)" % rc)
        rc, _, _ = run("--bogus")
        ck(rc == 2, "unknown verb exits 2 (rc=%d)" % rc)
        rc, _, _ = run("ask", "--lane", "X", "--session", session_a, "--nope")
        ck(rc == 2, "unknown flag exits 2 (rc=%d)" % rc)
        rc, _, _ = run("ask", "--lane", "X", "--session", session_a,
                       "--title", "t", "--description", "d", "--recommended", "3")
        ck(rc == 2, "a recommendation with NO options is refused (rc=%d)" % rc)
        rc, _, _ = run("ask", "--lane", "X", "--session", session_a,
                       "--title", "t", "--description", "d",
                       "--option", "a", "--option", "b", "--recommended", "3")
        ck(rc == 2, "a recommendation outside the option range is refused (rc=%d)" % rc)

        # -- 10. a CORRUPT register is an error, never a silent reset --------
        store = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        good = open(store, encoding="utf-8").read()
        with open(store, "w", encoding="utf-8") as fh:
            fh.write("{ not json")
        rc, out, err = run("list")
        ck(rc == 4, "a corrupt register is rc=4, not a silent reset (rc=%d)" % rc)
        with open(store, encoding="utf-8") as fh:
            survived = fh.read()
        ck(survived == "{ not json",
           "…and the tool did NOT overwrite it (the only copy of a parked question)")
        with open(store, "w", encoding="utf-8") as fh:
            fh.write(good)
        rc, _, _ = run("list")
        ck(rc == 0, "…and the restored register reads clean again")

        # -- 11. notify — the RETURN PATH (#547) ---------------------------
        # Delivery is a SEPARATE verb: `answer` holds RegisterLock, so a
        # network call inside it would block every other lane's ask/list for
        # the whole timeout, on a store whose point is concurrent safety.
        rc, _, err = run("notify")
        ck(rc == 2, "notify with no --set/--lane is usage rc=2 (rc=%d)" % rc)
        ck("requires --set" in err,
           "…and the usage error names the required flag, not an unknown verb")

        rc, out, _ = run("ask", "--lane", "Return lane", "--session", session_a,
                         "--questions-json", json.dumps([
                             {"title": "Ship it?", "description": "d",
                              "options": ["Yes", "No"], "recommended": 0}]),
                         "--json")
        ck(rc == 0, "ask registers the return-path set (rc=%d)" % rc)
        rset = json.loads(out)["set"]
        rc, _, _ = run("notify", "--set", rset)
        ck(rc == 1, "notify on an UNANSWERED set is rc=1, not a delivery (rc=%d)"
           % rc)

        rc, _, _ = run("answer", rset, "q1", "0")
        ck(rc == 0, "answer the return-path set (rc=%d)" % rc)
        ck(rset not in {s["id"] for s in store_json()["sets"]},
           "…and the fully-answered set LEFT the live register (archived)")

        # An answered set is normally ARCHIVED, so a reader that opens only
        # open.json cannot deliver the one answer that matters.
        rc, out, _ = run("notify", "--set", rset, "--dry-run", "--json")
        ck(rc == 0, "notify resolves an ARCHIVED set (rc=%d)" % rc)
        try:
            payload = json.loads(out)
        except Exception:  # noqa: BLE001
            # A leg that CRASHES reports nothing about the legs AFTER it, so a
            # missing payload is a FAIL row, never a traceback (see get_set).
            payload = {}
            ck(False, "notify --json emitted no JSON (the verb did not run)")
        ck(payload.get("session") == session_a,
           "…destination is the session recorded in the REGISTER")
        ck("Yes" in (payload.get("body") or ""),
           "…and the body carries the recorded answer")
        ck(len(payload.get("body") or "") <= 3020, "…and the body is bounded")

        rc, _, _ = run("notify", "--set", rset, "--dry-run",
                       "--session", "99999999-9999-9999-9999-999999999999")
        ck(rc == 2,
           "a caller-supplied destination is REFUSED rc=2 — no redirect (rc=%d)"
           % rc)

        rc, _, _ = run("notify", "--set", rset, "--mode", "bogus", "--dry-run")
        ck(rc == 2, "an unknown --mode is usage rc=2 (rc=%d)" % rc)

        rc, _, _ = run("notify", "--set", "nosuch", "--dry-run")
        ck(rc == 1, "an unknown set is rc=1 (rc=%d)" % rc)

        # A session that is not a session id must be REFUSED at REGISTER time
        # (C1): delivering to a guessed destination leaks an answer to a
        # stranger, and a register that holds a bad address can never deliver.
        rc, _, _ = run("ask", "--lane", "No session lane",
                       "--session", "not-a-uuid", "--title", "t",
                       "--description", "d", "--option", "a", "--option", "b")
        ck(rc == 2, "ask REFUSES a non-UUID session (rc=%d)" % rc)
        # …and the notify verb still refuses one that somehow got in, so the
        # guard exists at BOTH ends.
        nsid = json.loads(run("ask", "--lane", "Guard lane",
                              "--session", session_a, "--title", "t",
                              "--description", "d", "--json")[1])["set"]
        store_file = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        raw = json.load(open(store_file, encoding="utf-8"))
        for entry in raw["sets"]:
            if entry["id"] == nsid:
                entry["session"] = "not-a-uuid"
        json.dump(raw, open(store_file, "w", encoding="utf-8"))
        rc, _, _ = run("notify", "--set", nsid, "--dry-run")
        ck(rc == 3, "a non-uuid destination is refused rc=3 at the return end "
                    "too (rc=%d)" % rc)

        # A real delivery that cannot reach the lane must be a FAULT, never a
        # silent success — otherwise a parked answer looks delivered.
        dead = dict(env)
        dead["OC_QUESTIONS_A2A"] = "http://127.0.0.1:1/a2a/v1"
        proc = subprocess.run([tool, "notify", "--set", rset], env=dead,
                              capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 4,
           "an unreachable A2A endpoint is rc=4, never a false success (rc=%d)"
           % proc.returncode)

        if fails:
            print("  %d FAILED" % len(fails))
            return 1
        print("  all checks passed")
        return 0
    finally:
        shutil.rmtree(root, ignore_errors=True)

USAGE = """oc-questions — the Open Questions register (#547)

  ask      --lane <NAME> [--session <id>]
           [--questions-file F | --questions-json J |
            --title T --description D [--option O]... [--recommended N]]
           [--ttl-days N] [--subject S] [--no-clarify] [--close-when CMD]
           [--no-publish] [--json]
           The asking session is read from OPENCRABS_SESSION_ID; --session is
           an override for callers outside a turn. Prints the open-question
           TOTAL and the page URL -- there is no card.
  answer   <set-id> <qid> <choice-index|clarify> [--text T] [--via card|page|cli]
           [--no-publish]
  amend    --set <id> --qid <qid> [--title T] [--description D]
           [--option O]... [--recommended N] [--clear-options]
           the CLARIFY return leg: edits the question and reopens it
  notify   --set <id> | --lane <NAME> [--qid Q] [--mode turn-end|interrupt|quiet]
           [--dry-run] [--json]        the RETURN PATH: delivers the answer to
                                       the session recorded in the register
  list     [--lane NAME] [--session id] [--all] [--json] [--quiet]
  publish  [--set id] [--action URL] [--prune] [--rotate] [--json]
           reuses the live token; --rotate mints a new URL explicitly
  lint     [--json]
  gc       [--dry-run] [--json]        also applies mechanical closure

Store: <profile home>/questions/open.json (+ archive.jsonl, pages/<token>/).
The PAGE is the owner surface. --lane is a topic NAME, never a session id.
--session is the RETURN ADDRESS: the calling session, never a cron or renderer.
rc: 0 ok / 1 finding-or-not-found / 2 usage / 3 state-refused / 4 store-or-IO.
"""

def main(argv):
    oc_log_init()
    if not argv or argv[0] in ("--help", "-h", "help"):
        sys.stdout.write(USAGE)
        return 0
    verb, rest = argv[0], argv[1:]
    if verb in ("--selftest", "selftest"):
        return selftest()
    handlers = {"ask": cmd_ask, "answer": cmd_answer, "amend": cmd_amend,
                "list": cmd_list, "publish": cmd_publish, "lint": cmd_lint,
                "gc": cmd_gc, "notify": cmd_notify}
    if set(handlers) != set(_VERBS):
        sys.stderr.write("%s: verb set drifted from _VERBS\n" % PROG)
        return 2
    handler = handlers.get(verb)
    if handler is None:
        sys.stderr.write("%s: unknown verb %r\n\n%s" % (PROG, verb, USAGE))
        return 2
    return handler(rest)

if __name__ == "__main__":
    _rc = main(sys.argv[1:])
    oc_log_finish(_rc)
    sys.exit(_rc)
