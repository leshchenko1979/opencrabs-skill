#!/usr/bin/env python3
# =============================================================================
# oc-questions — the Open Questions register (#547)
#
# The sanctioned "blocked on you" channel (fleet-directives.md §Open Questions
# register). A lane that needs an owner decision registers an ORDERED set of
# questions in the same turn it parks; a renderer emits a card in the CALLING
# session's own topic plus a short-lived public page; answers return to the
# calling session.
#
# Store: <profile home>/questions/open.json, answered sets -> archive.jsonl
# Single writer: flock + atomic replace (tmp -> rename). Two concurrent `ask`
# calls must lose NEITHER set — that is a selftest criterion, not a comment.
#
# Verbs: ask · answer · list · render · publish · lint · gc
#
# rc vocabulary (tools/RC-CONTRACT.md): 0 ok / 1 finding-or-not-found /
# 2 usage / 3 state-refused (already answered, expired) / 4 store-or-IO fault.
# =============================================================================

import datetime
import fcntl
import html
import json
import os
import re
import secrets
import sys
import tempfile
import time

PROG = "oc-questions"
VERSION = "1.0.0"

# Callback data cap is a Telegram limit, asserted at register and render time
# (#547 risk table): a truncated callback resolves to nothing when tapped.
CALLBACK_MAX_BYTES = 64
DEFAULT_TTL_DAYS = 7
SET_ID_LEN = 6

# A lane NAME, never a uuid (fleet-directives: "Refer to workers by TOPIC/CHAT
# NAME only"). The lint verb enforces it rather than trusting the caller.
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)
# Secrets/no-secrets lint (#547 risk table: the page is world-readable).
SECRET_RE = re.compile(
    r"(?:/root/|/home/[a-z0-9_-]+/|api[_-]?key|bearer\s+[A-Za-z0-9._-]{16,}|"
    r"[0-9]{6,}:[A-Za-z0-9_-]{30,}|ssh\s+-i\s|BEGIN [A-Z ]*PRIVATE KEY)",
    re.I,
)


def profile_home():
    prof = os.environ.get("OC_PROFILE") or os.environ.get("OPENCRABS_PROFILE") or "ops"
    return os.path.join(os.path.expanduser("~"), ".opencrabs", "profiles", prof)


def store_dir():
    override = os.environ.get("OC_QUESTIONS_DIR")
    if override:
        return override
    return os.path.join(profile_home(), "questions")


def store_path():
    return os.path.join(store_dir(), "open.json")


def archive_path():
    return os.path.join(store_dir(), "archive.jsonl")


def pages_dir():
    return os.path.join(store_dir(), "pages")


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def parse_iso(text):
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00"))
    except Exception:
        return None


def age_hours(asked_at):
    dt = parse_iso(asked_at)
    if not dt:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    delta = datetime.datetime.now(datetime.timezone.utc) - dt
    return round(delta.total_seconds() / 3600.0, 1)


def fmt_age(asked_at):
    hours = age_hours(asked_at)
    if hours is None:
        return "age unknown"
    if hours < 1:
        return f"{int(hours * 60)}m old"
    if hours < 48:
        return f"{hours:g}h old"
    return f"{hours / 24:.1f}d old"


def empty_register():
    return {"version": 1, "sets": []}


def read_register():
    """Read the register. A MISSING store is an empty register; a CORRUPT one is
    an error, never silently replaced — overwriting it would destroy the only
    copy of a parked question."""
    path = store_path()
    if not os.path.exists(path):
        return empty_register()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception as exc:
        die(4, f"register unreadable at {path}: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("sets"), list):
        die(4, f"register malformed at {path} (expected an object with a sets array)")
    return data


def write_register_atomic(data):
    """tmp -> os.replace, so a reader never observes a half-written register."""
    directory = store_dir()
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".open.", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, store_path())
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class RegisterLock(object):
    """Single-writer guard: a read-modify-write must hold this for the WHOLE
    cycle, or two concurrent `ask` calls interleave and one set is lost."""

    def __init__(self, timeout=10.0):
        self.timeout = timeout
        self.fh = None

    def __enter__(self):
        os.makedirs(store_dir(), exist_ok=True)
        path = os.path.join(store_dir(), ".lock")
        self.fh = open(path, "a+")
        deadline = None
        import time as _time
        deadline = _time.time() + self.timeout
        while True:
            try:
                fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if _time.time() >= deadline:
                    die(4, f"register lock not acquired within {self.timeout:g}s "
                           f"({path}) — another writer is mid-cycle")
                _time.sleep(0.05)

    def __exit__(self, *exc):
        try:
            fcntl.flock(self.fh.fileno(), fcntl.LOCK_UN)
        finally:
            self.fh.close()
        return False


def new_set_id(taken):
    while True:
        candidate = secrets.token_hex(SET_ID_LEN // 2 + 1)[:SET_ID_LEN]
        if candidate not in taken:
            return candidate


def die(rc, message):
    sys.stderr.write(f"{PROG}: {message}\n")
    sys.exit(rc)


def open_sets(data):
    return [s for s in data["sets"] if s.get("status") == "open"]


def find_set(data, set_id):
    for entry in data["sets"]:
        if entry.get("id") == set_id:
            return entry
    return None


def find_question(entry, qid):
    for question in entry.get("questions", []):
        if question.get("qid") == qid:
            return question
    return None


# A question is CLOSED only once it is answered, withdrawn or expired.
# "clarifying" is NOT closed: a Clarify request means the owner asked for more
# context and is still waiting. Counting it as closed archived the WHOLE set and
# silently removed it from the live register — the opposite of the contract
# ("a Clarify request ... never silently closes the question").
CLOSED_STATUSES = ("answered", "withdrawn", "expired")

def question_is_closed(question):
    return question.get("status") in CLOSED_STATUSES

def set_is_closed(entry):
    questions = entry.get("questions") or []
    return bool(questions) and all(question_is_closed(q) for q in questions)




# =============================================================================
# Unified tools log (parity with tools/lib/oc-log.sh, schema per RC-CONTRACT)
# =============================================================================
_LOG_ENABLED = False
_LOG_ARGS = ""
_LOG_EXTRA = {}
_LOG_START = 0.0
_LOG_FINISHED = False


def _is_selftest():
    return "--selftest" in sys.argv[1:] or (len(sys.argv) > 1 and sys.argv[1] == "selftest")


def oc_log_init():
    global _LOG_ENABLED, _LOG_ARGS, _LOG_EXTRA, _LOG_START, _LOG_FINISHED
    _LOG_ARGS = " ".join(sys.argv[1:])
    _LOG_EXTRA = {}
    _LOG_FINISHED = False
    if "--no-log" in sys.argv[1:] or _is_selftest():
        os.environ["OC_TOOLS_NOLOG"] = "1"
    if os.environ.get("OC_TOOLS_NOLOG", "0") == "1":
        return
    _LOG_ENABLED = True
    _LOG_START = time.time()


def oc_log_extra(key, value):
    if _LOG_ENABLED:
        _LOG_EXTRA[key] = value


def oc_log_finish(exit_code):
    global _LOG_FINISHED
    if not _LOG_ENABLED or _LOG_FINISHED:
        return
    _LOG_FINISHED = True
    logf = os.environ.get(
        "OC_TOOLS_LOG",
        os.path.join(
            os.environ.get("OC_DEV_STATE",
                           os.path.expanduser("~/.opencrabs/profiles/ops/opencrabs-dev")),
            "tools.log",
        ),
    )
    entry = {
        "ts": now_iso(),
        "tool": PROG,
        "actor": os.environ.get("OPENCRABS_SESSION_ID", "unknown"),
        "args": _LOG_ARGS[:500],
        "exit": int(exit_code) if isinstance(exit_code, int) else 1,
        "secs": round(time.time() - _LOG_START, 3),
        "extra": _LOG_EXTRA,
    }
    try:
        os.makedirs(os.path.dirname(logf), exist_ok=True)
        with open(logf, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry, separators=(",", ":")) + "\n")
    except Exception:
        pass


# =============================================================================
# Argument helpers
# =============================================================================
def parse_flags(argv, valued, boolean=()):
    """Return (positional, {flag: value}). Unknown flags are a usage error —
    silently ignoring one would let a typo register a question with no
    recommendation while appearing to succeed."""
    valued = set(valued)
    boolean = set(boolean)
    positional, flags, index = [], {}, 0
    while index < len(argv):
        token = argv[index]
        if token in boolean:
            flags[token] = True
            index += 1
            continue
        if token in valued:
            if index + 1 >= len(argv):
                die(2, f"{token} requires a value")
            if token in flags:
                existing = flags[token]
                flags[token] = existing + [argv[index + 1]] if isinstance(existing, list) \
                    else [existing, argv[index + 1]]
            else:
                flags[token] = argv[index + 1]
            index += 2
            continue
        if token.startswith("--"):
            die(2, f"unknown flag {token} (see {PROG} --help)")
        positional.append(token)
        index += 1
    return positional, flags


def flag_list(flags, name):
    value = flags.get(name)
    if value is None:
        return []
    return value if isinstance(value, list) else [value]


def normalise_questions(raw):
    """Validate and normalise the ordered question array. Order is the contract
    (#547: 'questions[] in call order'), so nothing here reorders."""
    if not isinstance(raw, list) or not raw:
        die(2, "at least one question is required")
    out = []
    for position, item in enumerate(raw, start=1):
        if not isinstance(item, dict):
            die(2, f"question {position} must be an object")
        title = str(item.get("title") or "").strip()
        description = str(item.get("description") or "").strip()
        if not title:
            die(2, f"question {position}: title is required")
        if not description:
            die(2, f"question {position}: description is required")
        options = item.get("options") or []
        if not isinstance(options, list):
            die(2, f"question {position}: options must be an array")
        options = [str(o) for o in options]
        recommended = item.get("recommended")
        if recommended is not None:
            if not isinstance(recommended, int) or isinstance(recommended, bool):
                die(2, f"question {position}: recommended must be an integer index")
            if not options:
                die(2, f"question {position}: recommended is set but the question "
                       f"carries no options — there is nothing to recommend")
            if not 0 <= recommended < len(options):
                die(2, f"question {position}: recommended {recommended} is outside "
                       f"options (0..{len(options) - 1})")
        out.append({
            "qid": f"q{position}",
            "title": title,
            "description": description,
            "options": options,
            "recommended": recommended,
            "clarify": bool(item.get("clarify", True)),
            "status": "open",
            "answer": None,
            "answered_at": None,
            "answered_by": None,
        })
    return out


def questions_from_flags(flags):
    path = flags.get("--questions-file")
    inline = flags.get("--questions-json")
    if path:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                return json.load(fh)
        except Exception as exc:
            die(2, f"--questions-file unreadable: {exc}")
    if inline:
        try:
            return json.loads(inline)
        except Exception as exc:
            die(2, f"--questions-json is not valid JSON: {exc}")
    if flags.get("--title") or flags.get("--description"):
        return [{
            "title": flags.get("--title", ""),
            "description": flags.get("--description", ""),
            "options": flag_list(flags, "--option"),
            "recommended": int(flags["--recommended"]) if "--recommended" in flags else None,
            "clarify": "--no-clarify" not in flags,
        }]
    die(2, "supply --questions-file, --questions-json, or --title/--description")


# =============================================================================
# ask — register an ordered question set (the single-writer cycle)
# =============================================================================
def cmd_ask(argv):
    _, flags = parse_flags(
        argv,
        valued=["--lane", "--session", "--questions-file", "--questions-json",
                "--title", "--description", "--option", "--recommended",
                "--ttl-days", "--subject"],
        boolean=["--no-clarify", "--json"],
    )
    lane = (flags.get("--lane") or "").strip()
    session = (flags.get("--session") or "").strip()
    if not lane:
        die(2, "ask requires --lane <topic NAME>")
    if not session:
        die(2, "ask requires --session <calling session id>")
    if UUID_RE.search(lane):
        die(2, f"--lane must be a topic NAME, not a session id (got {lane!r}) — "
               f"fleet-directives: refer to workers by topic/chat name only")
    questions = normalise_questions(questions_from_flags(flags))
    try:
        ttl_days = int(flags.get("--ttl-days", DEFAULT_TTL_DAYS))
    except ValueError:
        die(2, "--ttl-days must be an integer")
    if not 1 <= ttl_days <= 365:
        die(2, "--ttl-days must be between 1 and 365")

    for question in questions:
        for index in range(len(question["options"])):
            callback_data("x" * SET_ID_LEN, question["qid"], index)

    with RegisterLock():
        data = read_register()
        taken = {s.get("id") for s in data["sets"]}
        set_id = new_set_id(taken)
        entry = {
            "id": set_id,
            "lane": lane,
            "session": session,
            "subject": flags.get("--subject"),
            "asked_at": now_iso(),
            "ttl_days": ttl_days,
            "status": "open",
            "questions": questions,
        }
        data["sets"].append(entry)
        write_register_atomic(data)

    oc_log_extra("set", set_id)
    oc_log_extra("questions", str(len(questions)))
    if flags.get("--json"):
        print(json.dumps(entry, indent=2, ensure_ascii=False))
    else:
        print(f"registered set {set_id} ({len(questions)} question(s), "
              f"lane {lane}, ttl {ttl_days}d)")
        for question in questions:
            mark = ""
            if question["options"] and question["recommended"] is not None:
                mark = f" [recommended: {question['options'][question['recommended']]}]"
            print(f"  {question['qid']}  {question['title']}{mark}")
    return 0


# =============================================================================
# list — every parked decision, OLDEST FIRST (that ordering is the instrument)
# =============================================================================
def cmd_list(argv):
    _, flags = parse_flags(argv, valued=["--lane", "--session"],
                           boolean=["--json", "--all", "--quiet"])
    with RegisterLock():
        data = read_register()
    entries = data["sets"]
    if "--all" not in flags:
        entries = [s for s in entries if s.get("status") == "open"]
    if flags.get("--lane"):
        entries = [s for s in entries if s.get("lane") == flags["--lane"]]
    if flags.get("--session"):
        entries = [s for s in entries if s.get("session") == flags["--session"]]
    entries = sorted(entries, key=lambda s: s.get("asked_at") or "")

    if flags.get("--json"):
        print(json.dumps({"count": len(entries), "sets": entries},
                         indent=2, ensure_ascii=False))
        return 0

    if not entries:
        if "--quiet" not in flags:
            print("no open questions")
        return 0

    open_count = sum(1 for s in entries for q in s.get("questions", [])
                     if not question_is_closed(q))
    for entry in entries:
        print(f"{entry['id']}  {entry['lane']}  {fmt_age(entry.get('asked_at'))}  "
              f"[{entry.get('status')}]")
        for question in entry.get("questions", []):
            if "--quiet" in flags and question.get("status") != "open":
                continue
            detail = f"    {question['qid']}  {question['title']}"
            if question.get("status") == "open":
                if question.get("options") and question.get("recommended") is not None:
                    detail += f"  (recommended: {question['options'][question['recommended']]})"
            else:
                detail += f"  -> {question.get('status')}"
                if question.get("answer") is not None:
                    detail += f": {question['answer']}"
            print(detail)
    print(f"-- {len(entries)} set(s), {open_count} open question(s), oldest first")
    return 0

# =============================================================================
# callback_data — the button payload (#547 risk: a 64-byte cap)
# =============================================================================
def callback_size(set_id, qid, choice):
    return len(f"{set_id}:{qid}:{choice}".encode("utf-8"))

def callback_data(set_id, qid, choice):
    """<set-id>:<qid>:<choice>. A truncated callback resolves to NOTHING when
    tapped, so the cap is asserted at register and render time rather than
    discovered in production."""
    payload = f"{set_id}:{qid}:{choice}"
    size = len(payload.encode("utf-8"))
    if size > CALLBACK_MAX_BYTES:
        die(2, f"callback_data {payload!r} is {size} bytes, over the "
               f"{CALLBACK_MAX_BYTES}-byte Telegram cap")
    return payload

def parse_callback(payload):
    """Inverse of callback_data: (set_id, qid, choice) or None."""
    parts = str(payload).split(":")
    if len(parts) != 3 or not all(parts):
        return None
    return parts[0], parts[1], parts[2]

def archive_entries(data, entries):
    """Append closed sets to archive.jsonl, then drop them from the live
    register. Caller MUST hold the lock. Append-only, so an archive write
    cannot destroy a previously archived set."""
    if not entries:
        return 0
    ids = {e.get("id") for e in entries}
    os.makedirs(store_dir(), exist_ok=True)
    with open(archive_path(), "a", encoding="utf-8") as fh:
        for entry in entries:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    data["sets"] = [s for s in data["sets"] if s.get("id") not in ids]
    return len(ids)

# =============================================================================
# answer — record an answer against ONE question (card tap or page submit)
# =============================================================================
def cmd_answer(argv):
    positional, flags = parse_flags(
        argv,
        valued=["--text", "--via", "--by"],
        boolean=["--json", "--clarify"],
    )
    if len(positional) < 2:
        die(2, "answer requires <set-id> <question-id> [choice-index|clarify]")
    set_id, qid = positional[0], positional[1]
    choice = positional[2] if len(positional) > 2 else None
    if flags.get("--clarify"):
        choice = "clarify"
    if choice is None and flags.get("--text") is None:
        die(2, "supply a choice index, the literal 'clarify', or --text")
    via = flags.get("--via") or "cli"
    if via not in ("card", "page", "cli"):
        die(2, "--via must be card, page or cli")

    with RegisterLock():
        data = read_register()
        entry = find_set(data, set_id)
        if entry is None:
            die(1, f"no question set {set_id!r} in the register")
        question = find_question(entry, qid)
        if question is None:
            die(1, f"set {set_id} has no question {qid!r}")
        if question_is_closed(question):
            # Idempotent by contract: a re-submit says so, it does not mutate.
            # NOTE the predicate is CLOSED, not "not open": a CLARIFYING question
            # is still awaiting the owner's real answer and MUST stay answerable.
            # Keying on "not open" made a clarified question unanswerable forever.
            if flags.get("--json"):
                print(json.dumps({"set": set_id, "qid": qid,
                                  "status": question.get("status"),
                                  "answer": question.get("answer"),
                                  "idempotent": True}, indent=2))
            else:
                print(f"{set_id}/{qid} is already {question.get('status')} "
                      f"({question.get('answer')!r}) — re-submit ignored")
            return 3

        is_clarify = (str(choice).lower() == "clarify")
        if is_clarify:
            question["status"] = "clarifying"
            question["answer"] = flags.get("--text")
            question["answer_kind"] = "clarify"
        else:
            options = question.get("options") or []
            text = flags.get("--text")
            if choice is not None:
                try:
                    index = int(choice)
                except ValueError:
                    die(2, f"{choice!r} is neither an option index nor 'clarify'")
                if not options:
                    die(2, f"set {set_id}/{qid} has no options; answer with --text")
                if not 0 <= index < len(options):
                    die(2, f"option {index} is outside 0..{len(options) - 1}")
                question["answer"] = options[index]
            else:
                question["answer"] = text
            question["status"] = "answered"
            question["answer_kind"] = "option" if choice is not None else "text"
        question["answered_at"] = now_iso()
        question["answered_by"] = flags.get("--by")
        question["answered_via"] = via

        remaining = [q for q in entry.get("questions", [])
                     if not question_is_closed(q)]
        archived = 0
        if not remaining:
            entry["status"] = "answered"
            entry["closed_at"] = now_iso()
            archived = archive_entries(data, [entry])
        write_register_atomic(data)

    oc_log_extra("set", set_id)
    oc_log_extra("qid", qid)
    oc_log_extra("via", via)
    if flags.get("--json"):
        print(json.dumps({"set": set_id, "qid": qid, "status": question["status"],
                          "answer": question.get("answer"),
                          "remaining": len(remaining), "archived": archived},
                         indent=2, ensure_ascii=False))
    else:
        print(f"{set_id}/{qid} -> {question['status']}: {question.get('answer')!r}")
        if remaining:
            print(f"  {len(remaining)} question(s) still open in {set_id}")
        else:
            print(f"  set {set_id} complete — archived")
    return 0

# =============================================================================
# lint — the register must not carry a uuid, a secret, or an over-cap callback
# =============================================================================
def cmd_lint(argv):
    _, flags = parse_flags(argv, valued=[], boolean=["--json"])
    with RegisterLock():
        data = read_register()
    findings = []
    for entry in data["sets"]:
        set_id = entry.get("id")
        lane = str(entry.get("lane") or "")
        if UUID_RE.search(lane):
            findings.append({"set": set_id, "qid": "-",
                             "why": "lane is a session id, not a topic NAME"})
        if not str(entry.get("session") or "").strip():
            findings.append({"set": set_id, "qid": "-",
                             "why": "missing return address (session)"})
        for question in entry.get("questions", []):
            qid = question.get("qid")
            blob = f"{question.get('title', '')}\n{question.get('description', '')}"
            if SECRET_RE.search(blob):
                findings.append({"set": set_id, "qid": qid,
                                 "why": "text matches the no-secrets pattern"})
            options = question.get("options") or []
            if options and question.get("recommended") is None:
                findings.append({"set": set_id, "qid": qid,
                                 "why": "options without a recommendation"})
            if callback_size(set_id, qid, "clarify") > CALLBACK_MAX_BYTES:
                findings.append({"set": set_id, "qid": qid,
                                 "why": "callback_data over the 64-byte cap"})
    if flags.get("--json"):
        print(json.dumps({"findings": findings, "count": len(findings)}, indent=2))
    elif not findings:
        print("lint clean — no uuid lanes, no secrets, no over-cap callbacks")
    else:
        for item in findings:
            print(f"FINDING {item['set']}/{item['qid']}: {item['why']}")
        print(f"-- {len(findings)} finding(s)")
    return 1 if findings else 0

# =============================================================================
# gc — archive expired and fully-closed sets
# =============================================================================
def cmd_gc(argv):
    _, flags = parse_flags(argv, valued=[], boolean=["--json", "--dry-run"])
    now = datetime.datetime.now(datetime.timezone.utc)
    with RegisterLock():
        data = read_register()
        expired = []
        for entry in data["sets"]:
            if entry.get("status") != "open":
                continue
            asked = parse_iso(entry.get("asked_at"))
            if not asked:
                continue
            if asked.tzinfo is None:
                asked = asked.replace(tzinfo=datetime.timezone.utc)
            ttl = int(entry.get("ttl_days") or DEFAULT_TTL_DAYS)
            if now >= asked + datetime.timedelta(days=ttl):
                entry["status"] = "expired"
                entry["expired_at"] = now_iso()
                expired.append(entry)
        closed = [s for s in data["sets"] if set_is_closed(s)]
        closed_ids = {s.get("id") for s in closed}
        victims = expired + [s for s in closed if s.get("id") not in {e.get("id") for e in expired}]
        if flags.get("--dry-run"):
            moved = 0
        else:
            moved = archive_entries(data, victims)
            if moved:
                write_register_atomic(data)
    if flags.get("--json"):
        print(json.dumps({"expired": len(expired),
                          "closed": len(closed_ids),
                          "archived": moved,
                          "dry_run": bool(flags.get("--dry-run"))}, indent=2))
    else:
        print(f"gc: {len(expired)} expired, {len(closed_ids)} closed, "
              f"{moved} archived"
              + (" (dry run — nothing written)" if flags.get("--dry-run") else ""))
    return 0

# =============================================================================
# notify — the RETURN PATH (#547). An answer must reach the calling session.
# =============================================================================
# Delivery is a SEPARATE verb, never folded into `answer`. `answer` is a pure
# state mutation that holds RegisterLock; a network call inside that lock would
# hold it for up to A2A_TIMEOUT seconds and block every other lane's ask/list —
# on a store whose entire point is concurrent safety. Keeping it separate also
# keeps rc honest: a delivery fault must not read as an answer fault.
#
# The destination is ALWAYS the session recorded in the register — never a
# caller-supplied id, never a field from a browser. That is the security
# property: a page or a card tap cannot redirect an answer to a third party.
# There is deliberately no --session flag on this verb.
#
# Transport is the A2A gateway, NOT `opencrabs session notify`: the CLI hangs on
# this host (rc=124, enqueues nothing) — fork issue #412.
A2A_URL = os.environ.get("OC_QUESTIONS_A2A") or "http://127.0.0.1:18791/a2a/v1"
A2A_TIMEOUT = int(os.environ.get("OC_QUESTIONS_A2A_TIMEOUT") or "20")
NOTIFY_BODY_MAX = 3000

def load_all_sets():
    """Open sets PLUS archived ones. An answered set is normally ARCHIVED, so a
    reader that only opens open.json cannot deliver the one answer that matters."""
    sets = list(read_register()["sets"])
    try:
        with open(archive_path(), encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    sets.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except FileNotFoundError:
        pass
    return sets

def find_set_anywhere(set_id):
    for entry in load_all_sets():
        if entry.get("id") == set_id:
            return entry
    return None

def compose_answer_body(entry, qid=None):
    questions = entry.get("questions") or []
    if qid:
        questions = [q for q in questions if q.get("qid") == qid]
    answered = [q for q in questions
                if q.get("answer") is not None
                or q.get("status") in ("clarifying", "clarified")]
    if not answered:
        return None
    lines = ["Open Questions — answer received (set %s, lane %s)"
             % (entry.get("id"), entry.get("lane")), ""]
    for question in answered:
        lines.append("%s. %s" % (question.get("qid"), question.get("title")))
        if question.get("answer") is None:
            lines.append("   -> CLARIFY REQUESTED")
        else:
            lines.append("   -> %s" % (question.get("answer"),))
        if question.get("answer_text"):
            lines.append("   text: %s" % (question["answer_text"],))
        lines.append("")
    body = "\n".join(lines).strip()
    if len(body) > NOTIFY_BODY_MAX:
        body = body[:NOTIFY_BODY_MAX] + " (truncated)"
    return body

def a2a_deliver(session, body, mode="turn-end"):
    import urllib.error
    import urllib.request
    payload = {"jsonrpc": "2.0", "id": "1", "method": "session/notify",
               "params": {"session_id": session, "message": body, "mode": mode}}
    request = urllib.request.Request(
        A2A_URL, data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=A2A_TIMEOUT) as response:
            return response.status, response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")
    except Exception as exc:  # noqa: BLE001
        return 0, "transport error: %s" % (exc,)

def cmd_notify(argv):
    positional, flags = parse_flags(
        argv,
        valued=["--set", "--lane", "--qid", "--mode"],
        boolean=["--json", "--dry-run"],
    )
    set_id = flags.get("--set") or (positional[0] if positional else None)
    lane = flags.get("--lane")
    if not set_id and not lane:
        die(2, "notify requires --set <set-id> or --lane <NAME>")
    mode = flags.get("--mode") or "turn-end"
    if mode not in ("turn-end", "interrupt", "quiet"):
        die(2, "--mode must be turn-end, interrupt or quiet")

    if set_id:
        entry = find_set_anywhere(set_id)
    else:
        candidates = [s for s in load_all_sets() if s.get("lane") == lane]
        entry = candidates[-1] if candidates else None
    if entry is None:
        die(1, "no question set %s in the register or the archive"
            % (set_id or lane,))

    session = (entry.get("session") or "").strip()
    if not UUID_RE.fullmatch(session):
        # Refuse rather than guess: a wrong destination leaks an answer to an
        # unrelated lane, and the register is the only authority for it.
        die(3, "set %s records no usable calling session — refusing to guess a "
               "destination" % (entry.get("id"),))
    body = compose_answer_body(entry, flags.get("--qid"))
    if body is None:
        die(1, "no answer recorded yet for set %s" % (entry.get("id"),))

    if flags.get("--dry-run"):
        if flags.get("--json"):
            print(json.dumps({"set": entry.get("id"), "session": session,
                              "mode": mode, "body": body},
                             indent=2, ensure_ascii=False))
        else:
            print("would notify %s (set %s, %s):\n\n%s"
                  % (entry.get("lane"), entry.get("id"), mode, body))
        return 0

    status, response = a2a_deliver(session, body, mode)
    if flags.get("--json"):
        print(json.dumps({"set": entry.get("id"), "session": session,
                          "mode": mode, "http": status, "response": response},
                         indent=2, ensure_ascii=False))
    else:
        print("notified %s (set %s) — http %s"
              % (entry.get("lane"), entry.get("id"), status))
    if status == 0:
        return 4
    if status >= 400:
        return 3
    return 0

# =============================================================================
# Session-binding lookups (read-only) — the card goes to the CALLER's own topic
# =============================================================================
def _session_db():
    return os.environ.get("OC_QUESTIONS_DB") or \
        os.path.join(profile_home(), "opencrabs.db")

def binding_thread(session_id):
    """(thread_id, note). The card must land in the CALLING session's topic, so
    the thread is resolved from that session's binding — never guessed, and
    never taken from whoever happens to be rendering."""
    db = _session_db()
    if not os.path.exists(db):
        return None, f"binding SKIPPED: no session DB at {db}"
    try:
        import sqlite3
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            row = conn.execute(
                "select thread_id from session_bindings where session_id=?",
                (session_id,)).fetchone()
        finally:
            conn.close()
    except Exception as exc:
        return None, f"binding SKIPPED: session_bindings unreadable ({exc})"
    if not row:
        return None, f"binding SKIPPED: {session_id[:8]} holds no binding row"
    return row[0], None

def derived_plan_cards(registered_sessions):
    """plan_cards rows STILL AWAITING APPROVAL whose session registered no
    question — so a lane that forgot to register still surfaces.

    The awaiting-approval predicate is the button suffix in `signature`:
    'ApproveDiscard' / 'ReviewingApproveDiscard' mean the card can still be
    approved; 'DiscardOnly' means it has left Editing. plan_cards carries no
    status column, so the suffix IS the state.

    Returns (rows, note). An unreadable DB returns ([], reason) — a skip, NEVER
    a silent clean (same posture as the C8 anchor guard)."""
    db = _session_db()
    if not os.path.exists(db):
        return [], f"derived leg SKIPPED: no session DB at {db}"
    try:
        import sqlite3
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            rows = conn.execute(
                "select session_id, thread_id, updated_at, signature from plan_cards"
            ).fetchall()
        finally:
            conn.close()
    except Exception as exc:
        return [], f"derived leg SKIPPED: plan_cards unreadable ({exc})"
    out = []
    for session_id, thread_id, updated_at, signature in rows:
        tail = str(signature or "").split("\x01")[-1]
        if "Approve" not in tail:
            continue
        if session_id in registered_sessions:
            continue
        out.append({"session": session_id, "thread": thread_id,
                    "updated_at": updated_at})
    out.sort(key=lambda item: item.get("updated_at") or 0)
    return out, None

# =============================================================================
# render — the card spec for the CALLING session's own topic
# =============================================================================
def card_text(entry):
    lines = [f"**Open questions — {entry['lane']}**",
             f"set `{entry['id']}` · {fmt_age(entry.get('asked_at'))}"]
    for question in entry.get("questions", []):
        if question_is_closed(question):
            continue
        lines.append("")
        lines.append(f"**{question['qid']}. {question['title']}**")
        lines.append(question["description"])
        options = question.get("options") or []
        for index, option in enumerate(options):
            mark = "  <- recommended" if index == question.get("recommended") else ""
            lines.append(f"{index}. {option}{mark}")
        if not options:
            lines.append("_free-text answer_")
    return "\n".join(lines)

def card_buttons(entry):
    """One row per question. Values are compact and the 64-byte cap is asserted
    by callback_data at build time, not discovered when a tap resolves to
    nothing."""
    rows = []
    for question in entry.get("questions", []):
        if question_is_closed(question):
            continue
        row = []
        for index, option in enumerate(question.get("options") or []):
            row.append({"text": option[:28],
                        "callback_data": callback_data(entry["id"], question["qid"], index)})
        if question.get("clarify"):
            row.append({"text": "Clarify",
                        "callback_data": callback_data(entry["id"], question["qid"], "clarify")})
        if row:
            rows.append(row)
    return rows

def cmd_render(argv):
    _, flags = parse_flags(argv, valued=["--set"], boolean=["--json", "--no-derived"])
    with RegisterLock():
        data = read_register()
    entries = [s for s in data["sets"] if s.get("status") == "open"]
    if flags.get("--set"):
        wanted = flags["--set"]
        entries = [s for s in entries if s.get("id") == wanted]
        if not entries:
            die(1, f"no open question set {wanted!r}")
    entries = sorted(entries, key=lambda s: s.get("asked_at") or "")

    notes = []
    cards = []
    for entry in entries:
        thread, note = binding_thread(entry.get("session"))
        if note:
            notes.append(f"{entry['id']}: {note}")
        cards.append({
            "set": entry["id"],
            "lane": entry["lane"],
            "session": entry["session"],
            "thread": thread,
            "age": fmt_age(entry.get("asked_at")),
            "text": card_text(entry),
            "buttons": card_buttons(entry),
        })

    derived = []
    if "--no-derived" not in flags:
        derived, note = derived_plan_cards({s.get("session") for s in data["sets"]})
        if note:
            notes.append(note)

    oc_log_extra("cards", str(len(cards)))
    oc_log_extra("derived", str(len(derived)))
    if flags.get("--json"):
        print(json.dumps({"cards": cards, "derived": derived, "notes": notes},
                         indent=2, ensure_ascii=False))
        return 0
    if not cards and not derived:
        print("nothing to render")
        return 0
    for card in cards:
        print(f"--- card {card['set']} -> {card['lane']} "
              f"(session {card['session'][:8]}, thread {card['thread']}, {card['age']}) ---")
        print(card["text"])
        for row in card["buttons"]:
            print("  [ " + " | ".join(b["text"] for b in row) + " ]")
    if derived:
        print(f"--- derived: {len(derived)} plan card(s) awaiting approval with no "
              f"registered question ---")
        for item in derived:
            print(f"  {item['session'][:8]} thread {item['thread']}")
    for note in notes:
        print(f"NOTE {note}")
    return 0

# =============================================================================
# publish — static HTML into a fresh unguessable token directory (7-day TTL)
# =============================================================================
PAGE_TTL_DAYS = 7

def inline_md(text):
    """Escape FIRST, then apply the two inline forms worth having. The page is
    world-readable, so nothing reaches the output unescaped."""
    safe = html.escape(str(text), quote=False)
    safe = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", safe)
    safe = re.sub(r"`([^`]+?)`", r"<code>\1</code>", safe)
    return safe

def markdown_to_html(text):
    """A bounded renderer, NOT a full Markdown implementation. Fenced blocks,
    tables, headings and paragraphs; a ```mermaid fence becomes a mermaid.ink
    image (the design's chosen renderer), any other fence becomes a <pre>.
    Richer Markdown is a renderer's job if wanted (@json-render is available on
    the host) — this does not pretend to be one."""
    import base64
    lines = str(text).split("\n")
    out, index = [], 0
    while index < len(lines):
        line = lines[index]
        stripped = line.strip()
        if stripped.startswith("```"):
            lang = stripped[3:].strip()
            body, index = [], index + 1
            while index < len(lines) and not lines[index].strip().startswith("```"):
                body.append(lines[index])
                index += 1
            index += 1
            joined = "\n".join(body)
            if lang == "mermaid":
                encoded = base64.urlsafe_b64encode(
                    joined.encode("utf-8")).decode("ascii")
                out.append('<figure><img alt="diagram" '
                           f'src="https://mermaid.ink/img/{encoded}"></figure>')
            else:
                out.append(f"<pre>{html.escape(joined)}</pre>")
            continue
        if stripped.startswith("|") and stripped.endswith("|"):
            rows = []
            while index < len(lines) and lines[index].strip().startswith("|"):
                rows.append(lines[index].strip())
                index += 1
            cells_rows = [[c.strip() for c in r.strip("|").split("|")] for r in rows]
            body = []
            for position, cells in enumerate(cells_rows):
                if all(c and set(c) <= set("-: ") for c in cells):
                    continue
                tag = "th" if position == 0 else "td"
                body.append("<tr>" + "".join(
                    f"<{tag}>{inline_md(c)}</{tag}>" for c in cells) + "</tr>")
            out.append("<table>" + "".join(body) + "</table>")
            continue
        if stripped.startswith("### "):
            out.append(f"<h4>{inline_md(stripped[4:])}</h4>")
        elif stripped.startswith("## "):
            out.append(f"<h3>{inline_md(stripped[3:])}</h3>")
        elif stripped.startswith("# "):
            out.append(f"<h2>{inline_md(stripped[2:])}</h2>")
        elif stripped:
            out.append(f"<p>{inline_md(stripped)}</p>")
        index += 1
    return "\n".join(out)

PAGE_CSS = """
body{font:16px/1.5 system-ui,sans-serif;max-width:52rem;margin:2rem auto;padding:0 1rem}
section{border:1px solid #ccc;border-radius:8px;padding:1rem;margin:1rem 0}
.opt{display:block;margin:.35rem 0}
.rec{color:#0a0;font-weight:600}
.desc table{border-collapse:collapse}
.desc td,.desc th{border:1px solid #ccc;padding:.25rem .5rem}
.desc img{max-width:100%}
.age,.meta{color:#666;font-size:.85em}
button{cursor:pointer}
"""

def build_page(entries, token, expires_at, action):
    sections = []
    for entry in entries:
        for question in entry.get("questions", []):
            if question_is_closed(question):
                continue
            fields = [
                f'<input type="hidden" name="token" value="{html.escape(token)}">',
                f'<input type="hidden" name="set" value="{html.escape(entry["id"])}">',
                f'<input type="hidden" name="qid" value="{html.escape(question["qid"])}">',
            ]
            for index, option in enumerate(question.get("options") or []):
                checked = " checked" if index == question.get("recommended") else ""
                badge = ' <span class="rec">recommended</span>' if checked else ""
                fields.append(
                    f'<label class="opt"><input type="radio" name="choice" '
                    f'value="{index}"{checked}> {html.escape(option)}{badge}</label>')
            fields.append('<textarea name="text" rows="2" '
                          'placeholder="free-text answer"></textarea>')
            fields.append('<button type="submit" name="choice" value="clarify">'
                          'Clarify</button>')
            sections.append(
                f'<section id="{html.escape(entry["id"])}-{html.escape(question["qid"])}">'
                f'<h2>{inline_md(question["title"])}</h2>'
                f'<div class="desc">{markdown_to_html(question["description"])}</div>'
                f'<form method="post" action="{html.escape(action)}">'
                + "".join(fields) + "</form>"
                f'<p class="age">asked {fmt_age(entry.get("asked_at"))} &middot; '
                f'lane {html.escape(entry["lane"])} &middot; '
                f'set {html.escape(entry["id"])} {html.escape(question["qid"])}</p>'
                "</section>")
    return ("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n"
            "<meta name=\"robots\" content=\"noindex, nofollow\">\n"
            "<title>Open questions</title>\n"
            f"<style>{PAGE_CSS}</style>\n"
            "</head><body>\n<h1>Open questions</h1>\n"
            f'<p class="meta">expires {html.escape(expires_at)}</p>\n'
            + ("".join(sections) or "<p>No open questions.</p>")
            + "\n</body></html>\n")

def prune_pages():
    """Delete token directories past their TTL. The token IS the credential, so
    an expired directory is removed rather than left serving."""
    import shutil
    removed = []
    root = pages_dir()
    if not os.path.isdir(root):
        return removed
    now = datetime.datetime.now(datetime.timezone.utc)
    for name in sorted(os.listdir(root)):
        meta_path = os.path.join(root, name, "meta.json")
        if not os.path.isfile(meta_path):
            continue
        try:
            with open(meta_path, "r", encoding="utf-8") as fh:
                meta = json.load(fh)
        except Exception:
            continue
        expires = parse_iso(meta.get("expires_at"))
        if expires and expires <= now:
            shutil.rmtree(os.path.join(root, name), ignore_errors=True)
            removed.append(name)
    return removed

def page_is_live(token):
    """(live, reason) — used by the selftest and by anything that needs to know
    whether a token still serves."""
    directory = os.path.join(pages_dir(), token)
    meta_path = os.path.join(directory, "meta.json")
    if not os.path.isfile(meta_path):
        return False, f"no page for token {token!r}"
    try:
        with open(meta_path, "r", encoding="utf-8") as fh:
            meta = json.load(fh)
    except Exception as exc:
        return False, f"meta unreadable: {exc}"
    expires = parse_iso(meta.get("expires_at"))
    if not expires:
        return False, "meta carries no expires_at"
    if expires <= datetime.datetime.now(datetime.timezone.utc):
        return False, f"expired at {meta.get('expires_at')}"
    return True, f"live until {meta.get('expires_at')}"

def cmd_publish(argv):
    _, flags = parse_flags(argv, valued=["--set", "--action"],
                           boolean=["--json", "--prune"])
    action = flags.get("--action") or "/answer"
    with RegisterLock():
        data = read_register()
    entries = [s for s in data["sets"] if s.get("status") == "open"]
    if flags.get("--set"):
        wanted = flags["--set"]
        entries = [s for s in entries if s.get("id") == wanted]
        if not entries:
            die(1, f"no open question set {wanted!r}")
    entries = sorted(entries, key=lambda s: s.get("asked_at") or "")
    pruned = prune_pages() if flags.get("--prune") else []

    if not entries:
        if flags.get("--json"):
            print(json.dumps({"published": None, "reason": "no open questions",
                              "pruned": pruned}, indent=2))
        else:
            print("nothing to publish (no open questions)")
        return 0

    token = secrets.token_urlsafe(24)
    created = datetime.datetime.now(datetime.timezone.utc)
    expires = created + datetime.timedelta(days=PAGE_TTL_DAYS)
    directory = os.path.join(pages_dir(), token)
    os.makedirs(directory, exist_ok=True)
    page = build_page(entries, token, expires.replace(microsecond=0).isoformat(), action)
    with open(os.path.join(directory, "index.html"), "w", encoding="utf-8") as fh:
        fh.write(page)
    meta = {"token": token, "created_at": created.replace(microsecond=0).isoformat(),
            "expires_at": expires.replace(microsecond=0).isoformat(),
            "action": action, "sets": [e["id"] for e in entries],
            "questions": sum(1 for e in entries for q in e.get("questions", [])
                             if not question_is_closed(q))}
    with open(os.path.join(directory, "meta.json"), "w", encoding="utf-8") as fh:
        json.dump(meta, fh, indent=2)

    oc_log_extra("token", token)
    oc_log_extra("questions", str(meta["questions"]))
    if flags.get("--json"):
        print(json.dumps({"token": token, "path": directory, "meta": meta,
                          "pruned": pruned}, indent=2))
    else:
        print(f"published {meta['questions']} question(s) to {directory}")
        print(f"  token {token} (expires {meta['expires_at']})")
        print(f"  action {action}")
    if not flags.get("--json"):
        for name in pruned:
            print(f"  pruned expired page {name}")
    return 0

