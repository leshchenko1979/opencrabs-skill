if is_class_active "logs"; then
  # 11. tools.log JSONL syntax integrity
  if [ -f "$LOGF" ]; then
    n_lines=$(wc -l < "$LOGF")
    n_ok=$(jq -Rr 'fromjson? | .ts' "$LOGF" 2>/dev/null | wc -l)
    n_bad=$((n_lines - n_ok))
    if [ "$n_bad" -gt 0 ]; then
      bad_lines="$(grep -n -v -E '^\{' "$LOGF" 2>/dev/null | head -3 | cut -d: -f1 | tr '\n' ' ')"
      add_finding 11 QUIRK toolslog-malformed "$n_bad non-JSON line(s) in $(basename "$LOGF") (${n_ok} parseable of ${n_lines}; lines: ${bad_lines:-?}) — recipes must use -Rr 'fromjson?'"
    else
      clean_line "tools.log: ${n_lines} JSONL line(s), all parseable"
    fi

    # Failure rate audit (>15% non-zero exit with minimum 10 invocations)
    high_fail_tools="$(jq -Rr 'fromjson? | select(.tool != null) | {tool: .tool, exit: .exit}' "$LOGF" 2>/dev/null | \
      python3 -c '
import json, sys
from collections import defaultdict
counts = defaultdict(int)
fails = defaultdict(int)
for line in sys.stdin:
    try:
        row = json.loads(line)
        t = row["tool"]
        counts[t] += 1
        if row.get("exit", 0) != 0:
            fails[t] += 1
    except:
        pass
bad = []
for t, total in counts.items():
    if total >= 10:
        rate = fails[t] / total
        if rate > 0.15:
            bad.append(f"{t}({fails[t]}/{total}={rate:.0%})")
if bad:
    print(", ".join(bad))
' 2>/dev/null)"
    if [ -n "$high_fail_tools" ]; then
      add_finding 15 REPORT tool-failure-rate "high failure rate (>15%) in tools: $high_fail_tools"
    else
      clean_line "tools.log: tool failure rates normal"
    fi
  else
    clean_line "tools.log: absent"
  fi

  # Daemon log error spikes
  today_log="$DAEMON_LOG_DIR/opencrabs.$(date -u +%Y-%m-%d)"
  if [ -f "$today_log" ]; then
    err_count="$(grep -c ' ERROR ' "$today_log" 2>/dev/null || echo 0)"
