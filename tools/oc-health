            open_claims[ref] = uuid
        elif k in ("unclaim", "close", "done") and ref in open_claims:
            open_claims.pop(ref, None)
    # Check if any claim lacks uuid
    empty = [r for r, u in open_claims.items() if not u]
    if empty:
        print(f"{len(empty)} unassigned claim(s)")
except Exception as e:
    pass
' 2>/dev/null)"
