#!/usr/bin/env bash
# =============================================================================
# oc-health — hourly fleet health & cleanliness sweep (owner order 2026-09-11).
#
# Spec + per-check remediation: tools/HEALTH-CHECKS.md (canonical). This tool is
# the MECHANICAL half: it measures, decides SAFE vs QUIRK, and (with --reap)
# performs only the provably-dead class. It never touches evidence — see the
# "Never touch" list in HEALTH-CHECKS.md.
#
# Usage: oc-health [--json] [--reap] [--quiet] [--selftest]
#   --json    machine-readable findings (the cron's contract)
#   --reap    apply the SAFE remediations (stale locks, old backups, old tmp).
#             Without it the tool is a pure read — safe to run any time.
#   --quiet   print only findings, not the checked-and-clean lines
#   --selftest  run the hermetic offline fixture suite (22 assertions), exit 0/1
#
# Exit: 0 clean · 1 findings (warn) · 2 usage · 3 measurement failure
#   Findings NEVER make the exit non-zero for a reaped-only run: a reap is a
#   successful remediation, not a failure. rc 1 means "something is wrong".
#
# Env: OC_HEALTH_STATE (default profile opencrabs-dev state dir)
#      OC_HEALTH_LOCK_MAX_AGE_H (default 24)  OC_HEALTH_BAK_KEEP (default 3)
#      OC_HEALTH_TMP_MAX_AGE_H (default 48)   OC_HEALTH_FORK (default ~/opencrabs)
#      (OC_HEALTH_DB / OC_HEALTH_SKILL_DIR / OC_HEALTH_WT_PATTERNS / OC_HEALTH_SKIP_VERSION
#       exist for the hermetic selftest only)
# =============================================================================
set -u
set -o pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
TOOLS_DIR="$(dirname "$SELF")"
PROFILE="${OC_PROFILE:-ops}"
STATE="${OC_HEALTH_STATE:-$HOME/.opencrabs/profiles/$PROFILE/opencrabs-dev}"
FORK="${OC_HEALTH_FORK:-$HOME/opencrabs}"
DB="${OC_HEALTH_DB:-$HOME/.opencrabs/profiles/$PROFILE/opencrabs.db}"
TMP_GLOB="${OC_HEALTH_TMP_GLOB:-/tmp/oc-*}"
SKILL_CHECK="${OC_HEALTH_SKILL_DIR:-$(cd "$TOOLS_DIR/.." && pwd)}"
WT_PATTERNS="${OC_HEALTH_WT_PATTERNS:-/root/oc-work/* /root/oc-wt-*}"
LOCK_MAX_AGE_H="${OC_HEALTH_LOCK_MAX_AGE_H:-24}"
BAK_KEEP="${OC_HEALTH_BAK_KEEP:-3}"
TMP_MAX_AGE_H="${OC_HEALTH_TMP_MAX_AGE_H:-48}"
SKILL_DIR="$(cd "$TOOLS_DIR/.." && pwd)"
LOGF="${OC_HEALTH_LOG:-$STATE/tools.log}"

JSON=0; REAP=0; QUIET=0
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --reap) REAP=1 ;;
    --quiet) QUIET=1 ;;
    --selftest) SELFTEST=1 ;;
    -h|--help) sed -n '2,26p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "oc-health: unknown arg '$a' (see --help)" >&2; exit 2 ;;
  esac
done

# ---- selftest --------------------------------------------------------------
# Hermetic: every live path is overridden to a fixture (state dir, tmp glob,
# session DB, skill checkout, worktree patterns). Nothing here can touch live
# state — the tool reaps real files under --reap, so the fixture discipline is
# load-bearing, not decoration.
selftest_impl() {
  set -u
  T="$(mktemp -d)"
  trap 'rm -rf "$T"' EXIT
  P=0; F=0
  ok()  { P=$((P+1)); }
  bad() { F=$((F+1)); echo "  FAIL $*" >&2; }
  chk() { [ "$2" = "$3" ] && ok || bad "$1 (want $2 got $3)"; }

  mkdir -p "$T/state" "$T/tmp" "$T/skill" "$T/wt" "$T/fork"
  git -C "$T/skill" init -q 2>/dev/null
  git -C "$T/skill" config user.email t@t; git -C "$T/skill" config user.name t
  echo x > "$T/skill/f"; git -C "$T/skill" add -A >/dev/null 2>&1
  git -C "$T/skill" commit -qm init >/dev/null 2>&1
  git -C "$T/skill" branch -M main >/dev/null 2>&1
  # check 6 compares HEAD against each push remote's main — give the fixture both
  # refs, or every clean run reports a phantom checkout-diverged finding.
  git -C "$T/skill" update-ref refs/remotes/origin/main HEAD
  git -C "$T/skill" update-ref refs/remotes/mirror2/main HEAD
  # fixture fork repo (so check 2 measures something, not a missing-dir failure)
  git -C "$T/fork" init -q 2>/dev/null
  git -C "$T/fork" config user.email t@t; git -C "$T/fork" config user.name t
  echo y > "$T/fork/f"; git -C "$T/fork" add -A >/dev/null 2>&1
  git -C "$T/fork" commit -qm init >/dev/null 2>&1

  sqlite3 "$T/db.sqlite" "CREATE TABLE cron_jobs (name TEXT, enabled INTEGER, deliver_to TEXT, prompt TEXT);"
  sqlite3 "$T/db.sqlite" "INSERT INTO cron_jobs VALUES ('oc-waiter-sweep',1,'','silent; uses session_notify');"
  sqlite3 "$T/db.sqlite" "INSERT INTO cron_jobs VALUES ('harvest-watch-4h',1,'','ok');"

  run() {
    OC_HEALTH_STATE="$T/state" OC_HEALTH_TMP_GLOB="$T/tmp/oc-*" OC_HEALTH_DB="$T/db.sqlite" \
    OC_HEALTH_SKILL_DIR="$T/skill" OC_HEALTH_FORK="$T/fork" OC_HEALTH_WT_PATTERNS="$T/wt/*" \
    OC_HEALTH_LOG="$T/tools.log" OC_HEALTH_SKIP_VERSION=1 \
      bash "$SELF" "$@"
  }

  # fixture tools.log: valid JSONL (check 11 clean path)
  printf '{"ts":"2026-09-11T00:00:00Z","tool":"oc-demo","args":"","exit":0,"secs":0.1,"extra":{}}\n' > "$T/tools.log"

  # 1. clean fixture → rc 0, zero findings
  RC=0; OUT="$(run 2>&1)" || RC=$?
  chk "clean-rc0" 0 "$RC"
  case "$OUT" in *"0 finding(s)"*) ok ;; *) bad "clean-zero-findings: $OUT" ;; esac

  # 2. a stale lock (dead pid, old) is detected
  printf 'pid=999999 ts=2020-01-01T00:00:00Z run=1\n' > "$T/state/fanout.lock.1"
  touch -d '3 days ago' "$T/state/fanout.lock.1"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  chk "stale-lock-rc1" 1 "$RC"
  case "$OUT" in *"stale-locks"*) ok ;; *) bad "stale-lock-detected: $OUT" ;; esac

  # 3. --reap removes the stale lock
  run --reap >/dev/null 2>&1
  [ -e "$T/state/fanout.lock.1" ] && bad "stale-lock-reaped" || ok

  # 4. a lock whose pid is ALIVE is flagged and NEVER reaped (the safety rule)
  printf 'pid=%s ts=2020-01-01T00:00:00Z run=2\n' "$$" > "$T/state/fanout.lock.2"
  touch -d '3 days ago' "$T/state/fanout.lock.2"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"stale-lock-live-pid"*) ok ;; *) bad "live-lock-flagged: $OUT" ;; esac
  run --reap >/dev/null 2>&1
  [ -e "$T/state/fanout.lock.2" ] && ok || bad "live-lock-not-reaped"
  rm -f "$T/state/fanout.lock.2"

  # 5. a lock younger than the threshold is left alone
  printf 'pid=999999 ts=x run=3\n' > "$T/state/fanout.lock.3"
  run --reap >/dev/null 2>&1
  [ -e "$T/state/fanout.lock.3" ] && ok || bad "fresh-lock-kept"
  rm -f "$T/state/fanout.lock.3"

  # 6. old backups are pruned to the keep count
  for i in 1 2 3 4 5; do
    printf 'x' > "$T/state/workers-ledger.json.bak.$i"
    touch -d "$((i + 1)) days ago" "$T/state/workers-ledger.json.bak.$i"
  done
  run --reap >/dev/null 2>&1
  left="$(ls -1 "$T/state"/workers-ledger.json.*bak* 2>/dev/null | wc -l)"
  chk "backups-pruned-to-keep" 3 "$left"

  # 7. a backup younger than 24h is NEVER deleted, even beyond the keep count —
  #    all five are fresh, so the keep-3 rule must prune NOTHING (order-independent).
  rm -f "$T/state"/workers-ledger.json.*bak*
  for i in 1 2 3 4 5; do printf 'x' > "$T/state/workers-ledger.json.bak.$i"; done
  run --reap >/dev/null 2>&1
  left="$(ls -1 "$T/state"/workers-ledger.json.*bak* 2>/dev/null | wc -l)"
  chk "recent-backups-kept" 5 "$left"

  # 8. stale tmp is reaped; fresh tmp is not
  printf 'x' > "$T/tmp/oc-old"; touch -d '3 days ago' "$T/tmp/oc-old"
  printf 'x' > "$T/tmp/oc-fresh"
  run --reap >/dev/null 2>&1
  [ -e "$T/tmp/oc-old" ] && bad "stale-tmp-reaped" || ok
  [ -e "$T/tmp/oc-fresh" ] && ok || bad "fresh-tmp-kept"

  # 9. --json is the whole stdout contract (no 'ok' chatter polluting it)
  RC=0; OUT="$(run --json 2>/dev/null)" || RC=$?
  if printf '%s' "$OUT" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then ok; else bad "json-parse: $OUT"; fi

  # 10. a DM-routed dev cron is flagged as a leak
  sqlite3 "$T/db.sqlite" "UPDATE cron_jobs SET deliver_to='telegram:133526395' WHERE name='oc-waiter-sweep';"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"cron-leak"*) ok ;; *) bad "cron-leak-detected: $OUT" ;; esac

  # 11. a BLANK deliver_to is NOT a leak (the cron briefs via session_notify) —
  #     regression guard for the false positive caught live on 2026-09-11.
  sqlite3 "$T/db.sqlite" "UPDATE cron_jobs SET deliver_to='' WHERE name='oc-waiter-sweep';"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"cron-leak"*) bad "blank-deliver-to-false-positive: $OUT" ;; *) ok ;; esac

  # 12. a disabled law-carrying cron is flagged
  sqlite3 "$T/db.sqlite" "UPDATE cron_jobs SET enabled=0 WHERE name='harvest-watch-4h';"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"cron-disabled"*) ok ;; *) bad "cron-disabled-detected: $OUT" ;; esac
  sqlite3 "$T/db.sqlite" "UPDATE cron_jobs SET enabled=1 WHERE name='harvest-watch-4h';"

  # 13. an unregistered worktree dir is reported, never removed
  mkdir -p "$T/wt/orphan"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"orphan-worktrees"*) ok ;; *) bad "orphan-worktree-detected: $OUT" ;; esac
  run --reap >/dev/null 2>&1
  [ -d "$T/wt/orphan" ] && ok || bad "orphan-worktree-not-removed"

  # 14. an uncommitted path in the shared checkout is flagged
  echo dirty > "$T/skill/dirtyfile"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"checkout-dirty"*) ok ;; *) bad "checkout-dirty-detected: $OUT" ;; esac

  # 15. check 11: a clean JSONL log is NOT flagged (regression guard — the
  #     clean path must stay silent, or every run cries wolf)
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"toolslog-malformed"*) bad "toolslog-clean-false-positive: $OUT" ;; *) ok ;; esac

  # 16. check 11: a hand-appended PROSE line in the JSONL journal is flagged
  #     (the 383/443 class) — report-only, the evidence line is NEVER rewritten
  printf '2026-08-31T04:11:21Z actor-correction: prose evidence line\n' >> "$T/tools.log"
  RC=0; OUT="$(run 2>&1)" || RC=$?
  case "$OUT" in *"toolslog-malformed"*) ok ;; *) bad "toolslog-malformed-detected: $OUT" ;; esac
  n_after="$(wc -l < "$T/tools.log")"
  chk "toolslog-evidence-preserved" 2 "$n_after"

  echo "oc-health selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]
}

if [ "${SELFTEST:-0}" = "1" ]; then selftest_impl; exit $?; fi

FINDINGS=0        # count of warn-class findings
REAPED=0          # count of remediations applied
FAILED=0          # measurement failures
F_JSON=""         # accumulated JSON finding objects
F_TEXT=""         # accumulated human finding lines

add_finding() { # <check-no> <severity> <slug> <message>
  FINDINGS=$((FINDINGS + 1))
  F_TEXT="${F_TEXT}$1 $2 $3 — $4"$'\n'
  [ -n "$F_JSON" ] && F_JSON="$F_JSON,"
  F_JSON="$F_JSON{\"check\":$1,\"severity\":\"$2\",\"slug\":\"$3\",\"message\":\"$(printf '%s' "$4" | sed 's/"/\\"/g')\"}"
}
clean_line() { # never writes to stdout in --json mode: the JSON is the whole contract
  if [ "$QUIET" = "1" ] || [ "$JSON" = "1" ]; then return 0; fi
  printf '  ok   %s\n' "$1"
}

# ---- 1. stale fanout locks -------------------------------------------------
n_locks=0; n_stale=0; reaped_locks=0
if [ -d "$STATE" ]; then
  for f in "$STATE"/fanout.lock.*; do
    [ -e "$f" ] || continue
    n_locks=$((n_locks + 1))
    age_h=$(( ( $(date +%s) - $(stat -c %Y "$f") ) / 3600 ))
    [ "$age_h" -ge "$LOCK_MAX_AGE_H" ] || continue
    pid="$(sed -n 's/^pid=\([0-9]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      add_finding 1 QUIRK stale-lock-live-pid "lock $(basename "$f") is ${age_h}h old but pid $pid is ALIVE — not reaping"
      continue
    fi
    n_stale=$((n_stale + 1))
    if [ "$REAP" = "1" ]; then rm -f "$f"; reaped_locks=$((reaped_locks + 1)); fi
  done
fi
if [ "$n_stale" -gt 0 ]; then
  if [ "$REAP" = "1" ]; then
    REAPED=$((REAPED + reaped_locks))
    add_finding 1 SAFE stale-locks "reaped $reaped_locks stale fanout lock(s) of $n_locks"
  else
    add_finding 1 SAFE stale-locks "$n_stale of $n_locks fanout lock(s) are stale (>=${LOCK_MAX_AGE_H}h, owner pid dead) — rerun with --reap"
  fi
else
  clean_line "locks: $n_locks present, none stale"
fi

# ---- 2. orphaned worktrees -------------------------------------------------
if [ -d "$FORK/.git" ]; then
  reg="$(git -C "$FORK" worktree list 2>/dev/null | tail -n +2 | awk '{print $1}' | sort)"
  n_reg="$(printf '%s\n' "$reg" | grep -c . || true)"
  # shellcheck disable=SC2086 — intentional word-splitting of the pattern list
  ondisk="$(ls -d $WT_PATTERNS 2>/dev/null | sort)"
  n_disk="$(printf '%s\n' "$ondisk" | grep -c . || true)"
  orphan="$(comm -13 <(printf '%s\n' "$reg") <(printf '%s\n' "$ondisk") | grep -c . || true)"
  if [ "${orphan:-0}" -gt 0 ]; then
    add_finding 2 QUIRK orphan-worktrees "$orphan dir(s) on disk are NOT registered worktrees ($n_disk on disk vs $n_reg registered) — remove via tools/oc-wt, never rm -rf"
  else
    clean_line "worktrees: $n_reg registered, $n_disk on disk, 0 orphans"
  fi
else
  FAILED=$((FAILED + 1))
fi

# ---- 3. ledger backups -----------------------------------------------------
n_bak=0; reap_bak=0
if [ -d "$STATE" ]; then
  mapfile -t baks < <(ls -1t "$STATE"/workers-ledger.json.*bak* 2>/dev/null)
  n_bak="${#baks[@]}"
  for ((i=BAK_KEEP; i<n_bak; i++)); do
    f="${baks[$i]}"
    age_h=$(( ( $(date +%s) - $(stat -c %Y "$f") ) / 3600 ))
    [ "$age_h" -ge 24 ] || continue        # never delete a <24h backup
    if [ "$REAP" = "1" ]; then rm -f "$f"; reap_bak=$((reap_bak + 1)); fi
  done
  if [ "$reap_bak" -gt 0 ]; then
    REAPED=$((REAPED + reap_bak))
    add_finding 3 SAFE ledger-backups "pruned $reap_bak old ledger backup(s), kept newest $BAK_KEEP"
  elif [ "$n_bak" -gt "$BAK_KEEP" ]; then
    add_finding 3 SAFE ledger-backups "$n_bak ledger backups (keep $BAK_KEEP) — rerun with --reap"
  else
    clean_line "ledger backups: $n_bak (keep $BAK_KEEP)"
  fi
fi

# ---- 4. state-dir bloat ----------------------------------------------------
if [ -d "$STATE" ]; then
  mb="$(du -sm "$STATE" 2>/dev/null | awk '{print $1}')"
  if [ "${mb:-0}" -gt 200 ]; then
    top="$(du -sm "$STATE"/* 2>/dev/null | sort -rn | head -3 | awk '{printf "%s(%sM) ", $2, $1}')"
    add_finding 4 REPORT state-bloat "state dir ${mb}MB > 200MB — top: $top"
  else
    clean_line "state dir: ${mb}MB"
  fi
fi

# ---- 5. disk headroom ------------------------------------------------------
disk_pct="$(df -P / | awk 'NR==2{gsub(/%/,"",$5); print $5}')"
if [ "${disk_pct:-0}" -ge 89 ]; then
  add_finding 5 URGENT disk-critical "root filesystem ${disk_pct}% — run vds-servers/scripts/cleanup-unified.sh, then re-check"
elif [ "${disk_pct:-0}" -ge 85 ]; then
  add_finding 5 WARN disk-high "root filesystem ${disk_pct}% (warn at 85)"
else
  clean_line "disk: ${disk_pct}%"
fi

# ---- 6. shared checkout ----------------------------------------------------
if [ -d "$SKILL_CHECK/.git" ]; then
  dirty="$(git -C "$SKILL_CHECK" status --porcelain 2>/dev/null | wc -l)"
  if [ "$dirty" -gt 0 ]; then
    files="$(git -C "$SKILL_CHECK" status --porcelain 2>/dev/null | head -5 | awk '{print $2}' | tr '\n' ' ')"
    add_finding 6 QUIRK checkout-dirty "$dirty uncommitted path(s) in the SHARED skill checkout: $files"
  else
    clean_line "checkout: clean"
  fi
  head_sha="$(git -C "$SKILL_CHECK" rev-parse --short HEAD 2>/dev/null)"
  for r in origin mirror2; do
    rsha="$(git -C "$SKILL_CHECK" rev-parse --short "$r/main" 2>/dev/null || echo none)"
    [ "$rsha" = "$head_sha" ] || add_finding 6 QUIRK checkout-diverged "HEAD=$head_sha but $r/main=$rsha"
  done
else
  FAILED=$((FAILED + 1))
fi

# ---- 7. version / ledger consistency --------------------------------------
if [ "${OC_HEALTH_SKIP_VERSION:-0}" = "1" ]; then
  clean_line "version: skipped (selftest)"
else
cv_out="$(cd "$TOOLS_DIR" && ./oc-ledger check-version 2>&1)"; cv_rc=$?
case "$cv_out" in
  *MISMATCH*) add_finding 7 QUIRK version-mismatch "$(printf '%s' "$cv_out" | head -1) — fix is oc-ledger sync (Supervisor release flow)" ;;
  *) [ "$cv_rc" = "0" ] && clean_line "version: consistent" || add_finding 7 QUIRK version-unreadable "check-version rc=$cv_rc: $(printf '%s' "$cv_out" | head -1)" ;;
esac
fi

# ---- 8. cron liveness + leak detection -------------------------------------
if [ -f "$DB" ] && command -v sqlite3 >/dev/null 2>&1; then
  # (a) law-carrying crons must be enabled
  cron_bad="$(sqlite3 "$DB" "SELECT name FROM cron_jobs WHERE enabled=0 AND name IN ('harvest-watch-4h','oc-waiter-sweep','oc-health-hourly');" 2>/dev/null)"
  [ -n "$cron_bad" ] && add_finding 8 QUIRK cron-disabled "law-carrying cron(s) disabled: $(printf '%s' "$cron_bad" | tr '\n' ' ')"
  # (b) LEAK class — a dev cron delivering OUTSIDE the forum. Two real shapes:
  #     deliver_to is a private DM (positive id; groups/supergroups are negative),
  #     or the prompt hardcodes the owner DM chat id. A BLANK deliver_to is NOT a
  #     leak: per the Agent briefing law the cron sends via session_notify to the
  #     process owner itself (oc-waiter-sweep does exactly this) — flagging blank
  #     would be a false positive, caught live on 2026-09-11 when this check's
  #     first version accused a correctly-routed cron.
  leak_bad="$(sqlite3 "$DB" "SELECT name FROM cron_jobs WHERE enabled=1 AND name LIKE 'oc-%' AND ((deliver_to LIKE 'telegram:%' AND deliver_to NOT LIKE 'telegram:-%') OR prompt LIKE '%133526395%');" 2>/dev/null)"
  [ -n "$leak_bad" ] && add_finding 8 QUIRK cron-leak "dev cron(s) delivering outside the forum (DM-routed): $(printf '%s' "$leak_bad" | tr '\n' ' ')"
  [ -z "$cron_bad$leak_bad" ] && clean_line "crons: law-carrying enabled, no DM leaks"
else
  FAILED=$((FAILED + 1))
fi

# ---- 9. temp accumulation --------------------------------------------------
n_tmp=0; reap_tmp=0
for f in $TMP_GLOB; do
  [ -e "$f" ] || continue
  age_h=$(( ( $(date +%s) - $(stat -c %Y "$f") ) / 3600 ))
  [ "$age_h" -ge "$TMP_MAX_AGE_H" ] || continue
  n_tmp=$((n_tmp + 1))
  if [ "$REAP" = "1" ]; then rm -rf "$f"; reap_tmp=$((reap_tmp + 1)); fi
done
if [ "$reap_tmp" -gt 0 ]; then
  REAPED=$((REAPED + reap_tmp))
  add_finding 9 SAFE stale-tmp "removed $reap_tmp /tmp/oc-* path(s) older than ${TMP_MAX_AGE_H}h"
elif [ "$n_tmp" -gt 0 ]; then
  add_finding 9 SAFE stale-tmp "$n_tmp /tmp/oc-* path(s) older than ${TMP_MAX_AGE_H}h — rerun with --reap"
else
  clean_line "tmp: no stale /tmp/oc-*"
fi

# ---- 10. session DB size ---------------------------------------------------
if [ -f "$DB" ]; then
  db_mb=$(( $(stat -c %s "$DB") / 1048576 ))
  if [ "$db_mb" -gt 1024 ]; then
    add_finding 10 REPORT db-size "session DB ${db_mb}MB > 1GB"
  else
    clean_line "session db: ${db_mb}MB"
  fi
fi

# ---- 11. tools.log JSONL integrity -----------------------------------------
# tools.log is JSONL by contract, but hand-appended prose lines exist (383, 443
# — written 2026-08-31; 443 is an evidentiary actor-correction, so it is NOT
# deleted). One malformed line makes a plain `jq -r` over the whole file abort
# AND stops the flood guard's tail-based scan at that point, so the failure is
# invisible exactly when it matters. Report-only: never rewrite evidence.
if [ -f "$LOGF" ]; then
  n_lines=$(wc -l < "$LOGF")
  n_ok=$(jq -Rr 'fromjson? | .ts' "$LOGF" 2>/dev/null | wc -l)
  n_bad=$((n_lines - n_ok))
  if [ "$n_bad" -gt 0 ]; then
    bad_lines="$(jq -Rr 'fromjson? | empty' "$LOGF" 2>/dev/null >/dev/null; awk 'NR==FNR{next}' /dev/null /dev/null; jq -R 'fromjson? // empty' "$LOGF" >/dev/null 2>&1; grep -n -v -E '^\{' "$LOGF" 2>/dev/null | head -3 | cut -d: -f1 | tr '\n' ' ')"
    add_finding 11 QUIRK toolslog-malformed "$n_bad non-JSON line(s) in $(basename "$LOGF") (${n_ok} parseable of ${n_lines}; lines: ${bad_lines:-?}) — plain jq aborts there and the flood guard's tail scan stops at that point; recipes must use -Rr 'fromjson?'"
  else
    clean_line "tools.log: ${n_lines} JSONL line(s), all parseable"
  fi
else
  clean_line "tools.log: absent"
fi

# ---- output ----------------------------------------------------------------
if [ "$JSON" = "1" ]; then
  printf '{"findings":[%s],"reaped":%d,"measure_failures":%d,"state_dir":"%s"}\n' \
    "$F_JSON" "$REAPED" "$FAILED" "$STATE"
else
  printf 'oc-health: %d finding(s), %d remediation(s), %d measurement failure(s)\n' \
    "$FINDINGS" "$REAPED" "$FAILED"
  [ -n "$F_TEXT" ] && printf '%s' "$F_TEXT"
fi
[ "$FAILED" -gt 0 ] && exit 3
[ "$FINDINGS" -gt 0 ] && exit 1
exit 0
