  # Commit for 501
  echo "Child issue content" >> "$mock_repo/child.rs"
  git -C "$mock_repo" add child.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(child): sub-issue (#501)"
  local commit_501
  commit_501="$(git -C "$mock_repo" rev-parse HEAD)"

  # Commit for 502
  echo "Blocked issue content" >> "$mock_repo/blocked.rs"
  git -C "$mock_repo" add blocked.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(blocked): dependency (#502)"
  local commit_502
  commit_502="$(git -C "$mock_repo" rev-parse HEAD)"

  # Commit for 503
  echo "Clean issue content" >> "$mock_repo/clean.rs"
  git -C "$mock_repo" add clean.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(clean): resolved hierarchy (#503)"
  local commit_503
  commit_503="$(git -C "$mock_repo" rev-parse HEAD)"

  export OC_HARVEST_MOCK_HIERARCHY="$mock_hier_file"
  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"

  rc=0
  out="$(run_engine "vet" "$commit_501" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "HELD_PARENT_UNHARVESTED"; then
    echo "  ok 8b - vet #501 (unharvested parent) -> REJECTED HELD_PARENT_UNHARVESTED exit 1"
  else
    echo "  bad 8b - vet #501 expected rc=1 HELD_PARENT_UNHARVESTED, got rc=$rc ($out)"
    return 1
  fi

  rc=0
  out="$(run_engine "vet" "$commit_502" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "HELD_BLOCKED_BY_DEPENDENCY"; then
    echo "  ok 8c - vet #502 (unharvested blocker) -> REJECTED HELD_BLOCKED_BY_DEPENDENCY exit 1"
  else
    echo "  bad 8c - vet #502 expected rc=1 HELD_BLOCKED_BY_DEPENDENCY, got rc=$rc ($out)"
    return 1
  fi

  rc=0
  out="$(run_engine "vet" "$commit_503" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "APPROVED"; then
    echo "  ok 8d - vet #503 (merged parent/blocker) -> APPROVED exit 0"
  else
    echo "  bad 8d - vet #503 expected rc=0 APPROVED, got rc=$rc ($out)"
    return 1
  fi

  # 8e. Test dispatch with --draft flag
  rc=0
  out="$(run_engine "dispatch" "503" "$commit_503" "none" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$mock_ledger" "true" "true" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Draft: true (--draft)"; then
    echo "  ok 8e - dispatch with --draft -> envelope carries Draft: true exit 0"
  else
    echo "  bad 8e - dispatch with --draft expected Draft: true in envelope, got rc=$rc ($out)"
    return 1
  fi

  unset OC_HARVEST_MOCK_HIERARCHY
  unset OC_HARVEST_MOCK_DEPLOYED_TS

  # 9. --help exit 0
  rc=0
  bash "$0" --help >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "  ok 9 - --help -> exit 0"
  else
    echo "  bad 9 - --help expected rc=0, got rc=$rc"
    return 1
  fi

  # 10. missing args exit 2
  rc=0
  bash "$0" vet >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "  ok 10 - missing args -> exit 2"
  else
    echo "  bad 10 - missing args expected rc=2, got rc=$rc"
    return 1
  fi

  echo "selftest: 10/10 OK"
  return 0
}

# --- Main Dispatcher ---
case "${1:-}" in
  vet) shift; cmd_vet "$@" ;;
  dispatch) shift; cmd_dispatch "$@" ;;
  --selftest) cmd_selftest ;;
  -h|--help) usage 0 ;;
  *) usage ;;
esac
