EOF

  local rc=0 out=""

  # 1. Test #95 (empty diff vs adolfousier/main) -> REJECTED (rc 1)
  rc=0
  out="$(run_engine "vet" "$commit_95" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "ALREADY_MERGED_EMPTY_DIFF"; then
    echo "  ok 1 - vet #95 (empty diff) -> REJECTED exit 1"
  else
    echo "  bad 1 - vet #95 expected rc=1 ALREADY_MERGED_EMPTY_DIFF, got rc=$rc ($out)"
    return 1
  fi

  # 2. Test #82 (patch-id / ancestor of upstream) -> REJECTED (rc 1)
  rc=0
  out="$(run_engine "vet" "$fork_commit_82" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "ALREADY_MERGED"; then
    echo "  ok 2 - vet #82 (patch-id match) -> REJECTED exit 1"
  else
    echo "  bad 2 - vet #82 expected rc=1 ALREADY_MERGED, got rc=$rc ($out)"
    return 1
  fi

  # 3. Test #52 (superseded audit) -> REJECTED (rc 1)
  rc=0
  out="$(run_engine "vet" "52" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "SUPERSEDED"; then
    echo "  ok 3 - vet #52 (superseded) -> REJECTED exit 1"
  else
    echo "  bad 3 - vet #52 expected rc=1 SUPERSEDED, got rc=$rc ($out)"
    return 1
