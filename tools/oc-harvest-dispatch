#!/usr/bin/env bash
# =============================================================================
# oc-harvest-dispatch — mechanized candidate vetting, lane selection, and dispatch
#
# Enforces the Parallel Harvest Orchestration Protocol (PHOP):
# 1. Candidate Vetting:
#    - Tree-diff delta check (git diff adolfousier/main -- <files>) -> rejects if empty
#    - Patch-ID / Ancestor check -> rejects if diff already merged upstream
#    - Upstream PR settling authority -> rejects if already merged/in-flight
#    - Supersession audit -> rejects if obsolete/superseded
#    - 24h deployment soak check -> rejects if feat is fresh
#    - Subsystem cohesion check -> rejects if touches files of soaking feat (HELD_DEPENDENT_SOAK)
#    - In-flight lane fencing -> rejects if touches files of active editor claim (HELD_IN_FLIGHT_LANE)
# 2. Capacity-Gated Dispatch:
#    - Queries workers-ledger.json to verify target editor is strictly idle with 0 open claims
#    - Formats standard self-contained wire envelope
#    - Sends payload via session_notify (or dry-run output)
#
# Subcommands:
#   vet <issue-or-commits> [--repo <path>] [--base <ref>] [--json]
#   dispatch <issue> <commits> [--to <uuid>] [--repo <path>] [--base <ref>] [--draft] [--dry-run]
#   --help | -h
#   --selftest
#
# Exit codes:
#   0: APPROVED / Clean / Success / --help
#   1: REJECTED (already merged, superseded, empty diff, in-flight, soak, dependent-soak, in-flight-lane, parent-unharvested, blocked-by)
#   2: Usage error
#   3: Git or GitHub API failure
#   4: CAPACITY_EXHAUSTED / Target lane busy with active claims
# =============================================================================
set -u
set -o pipefail

_OC_TOOLS="$(cd "$(dirname "$0")" && pwd)"
export SKILL_DIR="${SKILL_DIR:-$(cd "$_OC_TOOLS/.." && pwd)}"
_OC_LIB="$_OC_TOOLS/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then
  source "$_OC_LIB"
  oc_log_init "oc-harvest-dispatch" "$@"
else
  oc_log_finish() { :; }
fi
trap 'oc_log_finish $?' EXIT

PROG="$(basename "$0")"
REPO="${HOME}/opencrabs"
BASE_REF="adolfousier/main"
UPSTREAM_REPO="adolfousier/opencrabs"
STATE_DIR="${HOME}/.opencrabs/profiles/ops/opencrabs-dev"
LEDGER_FILE="${STATE_DIR}/workers-ledger.json"

usage() {
  cat <<EOF
Usage:
  $PROG vet <issue-or-commits> [--repo <path>] [--base <ref>] [--json]
  $PROG dispatch <issue> <commits> [--to <uuid>] [--repo <path>] [--base <ref>] [--draft] [--dry-run]
  $PROG --help | -h
  $PROG --selftest

Exit codes:
  0: APPROVED / Eligible / Success
  1: REJECTED (already merged upstream, empty diff, superseded, soak, held, unharvested parent/blocker)
  2: Usage error
  3: Git or API failure
  4: CAPACITY_EXHAUSTED / Target lane busy with active claims
EOF
  exit "${1:-2}"
}

# --- Core Python Engine ---
run_engine() {
  python3 -c "
import sys, os, json, re, subprocess, argparse, time, datetime, glob

def parse_iso_ts(ts_str):
    if not ts_str: return 0
    try:
        if ts_str.endswith('Z'):
            ts_str = ts_str[:-1] + '+00:00'
        return int(datetime.datetime.fromisoformat(ts_str).timestamp())
    except Exception:
        return 0

def load_swap_history(state_dir):
    swaps = []
    if not state_dir or not os.path.exists(state_dir):
        return swaps
    journals = glob.glob(os.path.join(state_dir, 'oc-deploy', 'journal', 'swap-*.jsonl'))
    for jf in journals:
        try:
            with open(jf) as f:
                for line in f:
                    if not line.strip(): continue
                    data = json.loads(line)
                    if data.get('step') == 'auto-swap' and data.get('sha') and data.get('ts'):
                        ts_val = parse_iso_ts(data['ts'])
                        if ts_val > 0:
                            swaps.append((data['sha'], ts_val))
                        break
        except Exception:
            pass
    meta_path = os.path.join(state_dir, 'deployed.meta.json')
    if os.path.exists(meta_path):
        try:
            with open(meta_path) as f:
                data = json.load(f)
                ts_str = data.get('swapped_at') or data.get('ts')
                sha = data.get('sha')
                ts_val = parse_iso_ts(ts_str)
                if sha and ts_val > 0:
                    swaps.append((sha, ts_val))
        except Exception:
            pass
    swaps.sort(key=lambda x: x[1])
    return swaps

def get_commit_deploy_ts(commit_sha, repo_path, swaps):
    mock_env = os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS')
    if mock_env and mock_env.isdigit() and int(mock_env) > 0:
        return int(mock_env)
    if not swaps:
        return 0
    for s_sha, s_ts in swaps:
        if commit_sha == s_sha or commit_sha.startswith(s_sha) or s_sha.startswith(commit_sha):
            return s_ts
    if not os.path.isdir(repo_path):
        return 0
    latest_sha = swaps[-1][0]
    rc = subprocess.run(['git', '-C', repo_path, 'merge-base', '--is-ancestor', commit_sha, latest_sha], capture_output=True).returncode
    if rc != 0:
        return 0
    low = 0
    high = len(swaps) - 1
    earliest_idx = high
    while low <= high:
        mid = (low + high) // 2
        mid_sha = swaps[mid][0]
        rc = subprocess.run(['git', '-C', repo_path, 'merge-base', '--is-ancestor', commit_sha, mid_sha], capture_output=True).returncode
        if rc == 0:
            earliest_idx = mid
            high = mid - 1
        else:
            low = mid + 1
    return swaps[earliest_idx][1]

def run_cmd(cmd, cwd=None):
    res = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    return res.returncode, res.stdout, res.stderr

def get_patch_id(commit, repo_path):
    rc, out, _ = run_cmd(['git', '-C', repo_path, 'show', commit])
    if rc != 0:
        return None
    p = subprocess.run(['git', 'patch-id'], input=out, text=True, capture_output=True)
    if p.returncode == 0 and p.stdout:
        return p.stdout.strip().split()[0]
    return None

def check_ancestor(commit, base_ref, repo_path):
    rc, _, _ = run_cmd(['git', '-C', repo_path, 'merge-base', '--is-ancestor', commit, base_ref])
    return rc == 0

def check_files_diff(files, base_ref, repo_path):
    if not files:
        return False, ''
    cmd = ['git', '-C', repo_path, 'diff', base_ref, '--'] + files
    rc, out, _ = run_cmd(cmd)
    if rc == 0 and not out.strip():
        return True, ''
    return False, out

def resolve_issue_commits(issue_num, repo_path):
    pattern = f'#{issue_num}'
    range_arg = 'adolfousier/main..origin/main'
    rc_rev, _, _ = run_cmd(['git', '-C', repo_path, 'rev-parse', '--verify', 'origin/main'])
    if rc_rev != 0:
        range_arg = 'HEAD'
    rc, out, _ = run_cmd([
        'git', '-C', repo_path, 'log', '--reverse', range_arg,
        '--format=%H%x09%h%x09%s%x09%(trailers:key=Issue-Ref,valueonly)'
    ])
    if rc != 0 or not out.strip():
        return []
    commits = []
    for line in out.strip().split('\n'):
        parts = line.split('\t')
        full_sha = parts[0]
        short_sha = parts[1] if len(parts) > 1 else full_sha[:7]
        subject = parts[2] if len(parts) > 2 else ''
        trailer = parts[3] if len(parts) > 3 else ''
        if pattern in subject or pattern in trailer:
            commits.append(full_sha)
    return commits

def get_fork_issue_hierarchy(issue_num, repo_path=None, mock_hierarchy=None):
    if mock_hierarchy is not None:
        return mock_hierarchy.get(str(issue_num)) or mock_hierarchy.get(issue_num)
    mock_env = os.environ.get('OC_HARVEST_MOCK_HIERARCHY')
    if mock_env:
        try:
            with open(mock_env) as f:
                data = json.load(f)
                return data.get(str(issue_num)) or data.get(issue_num)
        except Exception:
            pass
    cmd = ['gh', 'issue', 'view', str(issue_num), '--repo', 'leshchenko1979/opencrabs', '--json', 'number,title,state,parent,blockedBy,subIssues']
    rc, out, _ = run_cmd(cmd)
    if rc != 0 or not out.strip():
        return None
    try:
        return json.loads(out)
    except Exception:
        return None

def is_issue_harvested_upstream(issue_num, upstream_repo, repo_path, base_ref, swaps=None, mock_prs=None):
    # 1. Check if upstream PR exists
    pr = check_upstream_pr(issue_num, upstream_repo, mock_prs=mock_prs)
    if pr and pr.get('state') == 'MERGED':
        return True
    
    # 2. Check if base_ref already has a commit mentioning this issue
    if repo_path and os.path.isdir(repo_path):
        rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '100', f'--grep=#{issue_num}', '--format=%H', base_ref])
        if rc == 0 and out.strip():
            return True

    # 3. Check if all commits for this issue are ancestors of base_ref or match patch-ids
    if repo_path and os.path.isdir(repo_path):
        commits = resolve_issue_commits(issue_num, repo_path)
        if commits:
            all_ancestor = True
            for c in commits:
                if not check_ancestor(c, base_ref, repo_path):
                    pid = get_patch_id(c, repo_path)
                    matched_pid = False
                    if pid:
                        rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '100', '--format=%H', base_ref])
                        if rc == 0:
                            for up_c in out.strip().split('\n'):
                                if not up_c.strip(): continue
                                if get_patch_id(up_c.strip(), repo_path) == pid:
                                    matched_pid = True
                                    break
                    if not matched_pid:
                        all_ancestor = False
                        break
            if all_ancestor:
                return True
    return False

def get_affected_files(commits, repo_path):
    files = set()
    for c in commits:
        rc, out, _ = run_cmd(['git', '-C', repo_path, 'diff-tree', '--no-commit-id', '--name-only', '-r', c])
        if rc == 0 and out.strip():
            for f in out.strip().split('\n'):
                if f.strip():
                    files.add(f.strip())
    return sorted(list(files))

def check_upstream_pr(issue_num, upstream_repo, mock_prs=None):
    if mock_prs is not None:
        prs = mock_prs
    else:
        cmd = ['gh', 'pr', 'list', '--repo', upstream_repo, '--state', 'all', '--limit', '150', '--json', 'number,title,state,headRefName,mergedAt,body']
        rc, out, _ = run_cmd(cmd)
        if rc != 0:
            return None
        prs = json.loads(out)
    for p in prs:
        if p.get('state') not in ['MERGED', 'OPEN']:
            continue
        body = p.get('body', '') or ''
        head = p.get('headRefName', '') or ''
        title = p.get('title', '') or ''

        if re.search(rf'leshchenko1979/opencrabs(?:/issues/|#){issue_num}\b', body) or \
           re.search(rf'leshchenko1979/opencrabs(?:/issues/|#){issue_num}\b', title):
            return p
        if re.search(rf'Original issue:\s*(?:https?://[^\s]+/)?(?:issues/|#)?{issue_num}\b', body, re.IGNORECASE):
            return p
        if re.search(rf'(?:^|/)(?:fix|feat|up|harvest)[/-]{issue_num}(?:-|$)', head) or \
           re.search(rf'/{issue_num}(?:-|$)', head):
            return p
        if re.search(rf'(?:\(|^|\s)(?:fix|fixes|feat|close|closes)?\s*#{issue_num}\b', title, re.IGNORECASE) and not re.search(rf'(?:follow-up to|reverts?|related to)\s*#{issue_num}\b', title, re.IGNORECASE):
            return p
    return None

def get_active_claims(ledger_file, repo_path=None):
    if not os.path.exists(ledger_file):
        return []
    try:
        with open(ledger_file) as f:
            data = json.load(f)
    except Exception:
        return []
    events = data.get('events', [])
    claims = []
    for idx, ev in enumerate(events):
        if ev.get('kind') == 'claim':
            by = ev.get('by', '')
            m_uuid = re.search(r'([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})', by)
            uuid = m_uuid.group(1) if m_uuid else by.replace('editor ', '').strip()
            what = ev.get('what', '')
            m_iss = re.search(r'#(\d+)', what) or re.search(r'issue\s*=?\s*(\d+)', what, re.IGNORECASE)
            iss = int(m_iss.group(1)) if m_iss else None
            closed = False
            for later_ev in events[idx+1:]:
                later_by = later_ev.get('by', '')
                if (uuid in later_by or (iss and f'#{iss}' in later_ev.get('what', ''))) and later_ev.get('kind') in ['close', 'confirm', 'reject', 'done', 'unclaim']:
                    closed = True
                    break
            if not closed:
                files = []
                if 'files' in ev and isinstance(ev['files'], list):
                    files = ev['files']
                elif iss and repo_path and os.path.isdir(repo_path):
                    res_rc, res_out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '10', f'--grep=#{iss}', '--format=%H'])
                    if res_rc == 0 and res_out.strip():
                        c_shas = [s.strip() for s in res_out.strip().split('\n') if s.strip()]
                        files = get_affected_files(c_shas, repo_path)
                claims.append({
                    'uuid': uuid,
                    'issue': iss,
                    'what': what,
                    'files': files
                })
    return claims

def get_available_editors(ledger_file, target_uuid=None):
    if not os.path.exists(ledger_file):
        return []
    with open(ledger_file) as f:
        data = json.load(f)
    active_claims = get_active_claims(ledger_file)
    busy_uuids = set(c['uuid'] for c in active_claims)
    workers = data.get('workers', [])
    available = []
    for w in workers:
        u = w.get('uuid')
        role = w.get('role', '')
        if role != 'editor':
            continue
        if target_uuid and u != target_uuid:
            continue
        if u not in busy_uuids:
            available.append(w)
    return available

def vet_candidate(candidate_arg, repo_path, base_ref, upstream_repo, mock_prs=None, mock_inventory=None, mock_ledger=None):
    issue_num = None
    commits = []
    
    rc, _, _ = run_cmd(['git', '-C', repo_path, 'cat-file', '-e', candidate_arg + '^{commit}'])
    is_commit = (rc == 0)

    if is_commit:
        commits = [candidate_arg]
        rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '1', '--format=%s%x09%(trailers:key=Issue-Ref,valueonly)', candidate_arg])
        if rc == 0 and out.strip():
            m = re.search(r'#(\d+)', out.strip())
            if m:
                issue_num = int(m.group(1))
    elif re.match(r'^#?\d+$', candidate_arg):
        issue_num = int(candidate_arg.lstrip('#'))
        commits = resolve_issue_commits(issue_num, repo_path)
    else:
        commits = [c.strip() for c in candidate_arg.split() if c.strip()]
        for c in commits:
            rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '1', '--format=%s%x09%(trailers:key=Issue-Ref,valueonly)', c])
            if rc == 0 and out.strip():
                m = re.search(r'#(\d+)', out.strip())
                if m:
                    issue_num = int(m.group(1))
                    break

    # Gate 1: Supersession audit from inventory / known supersessions
    if issue_num in [52, 53]:
        return {
            'status': 'REJECTED',
            'verdict': f'SUPERSEDED: Issue #{issue_num} row-budget model was superseded by #79 and #119 (merged upstream in PR #1481)',
            'issue': issue_num,
            'commits': commits,
            'exit_code': 1
        }

    # Gate 2: Check upstream PR history
    if issue_num:
        pr = check_upstream_pr(issue_num, upstream_repo, mock_prs=mock_prs)
        if pr:
            pr_num = pr.get('number')
            pr_st = pr.get('state')
            return {
                'status': 'REJECTED',
                'verdict': f'ALREADY_MERGED_UPSTREAM_PR: Issue #{issue_num} covered by upstream PR #{pr_num} ({pr_st})',
                'issue': issue_num,
                'commits': commits,
                'exit_code': 1
            }

    # Gate 2b: 24h feature soak gate across entire relationship graph (Owner 2026-09-15 / 2026-09-16)
    now_ts = int(os.environ.get('OC_HARVEST_NOW_TS') or time.time())
    st_dir = os.environ.get('STATE_DIR', '')
    if not st_dir:
        home_dir = os.environ.get('HOME', '/root')
        st_dir = os.path.join(home_dir, '.opencrabs/profiles/ops/opencrabs-dev')
    swaps = load_swap_history(st_dir)
    
    # Check candidate commits for feat soak
    for c in commits:
        rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '1', '--format=%s%x09%ct', c])
        if rc == 0 and out.strip():
            parts = out.strip().split('\t')
            c_subj = parts[0]
            c_ts = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0
            is_feat = c_subj.startswith('feat')
            if is_feat:
                d_ts = get_commit_deploy_ts(c, repo_path, swaps)
                if not d_ts and not swaps and not os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS'):
                    d_ts = c_ts
                if d_ts > 0:
                    age_hours = (now_ts - d_ts) / 3600.0
                else:
                    age_hours = 0.0
                if age_hours < 24.0:
                    return {
                        'status': 'REJECTED',
                        'verdict': f'SOAK_GATE_VIOLATION: Feature commit {c[:8]} is within 24h soak window (age: {max(0.0, age_hours):.1f}h < 24h)',
                        'issue': issue_num,
                        'commits': commits,
                        'exit_code': 1
                    }

    # Graph-wide 24h soak check on child/blocker/parent issues
    if issue_num:
        hier = get_fork_issue_hierarchy(issue_num, repo_path=repo_path)
        if hier:
            related_issue_nums = []
            parent = hier.get('parent')
            if parent and isinstance(parent, dict) and parent.get('number'):
                related_issue_nums.append((parent.get('number'), 'parent'))
            
            sub_issues = hier.get('subIssues')
            sub_nodes = sub_issues.get('nodes', []) if isinstance(sub_issues, dict) else (sub_issues if isinstance(sub_issues, list) else [])
            for s in sub_nodes:
                s_num = s.get('number') if isinstance(s, dict) else s
                if s_num:
                    related_issue_nums.append((s_num, 'sub-issue'))

            blocked_by = hier.get('blockedBy')
            b_nodes = blocked_by.get('nodes', []) if isinstance(blocked_by, dict) else (blocked_by if isinstance(blocked_by, list) else [])
            for b in b_nodes:
                b_num = b.get('number') if isinstance(b, dict) else b
                if b_num:
                    related_issue_nums.append((b_num, 'blocker'))

            for rel_num, rel_type in related_issue_nums:
                rel_commits = resolve_issue_commits(rel_num, repo_path)
                for rc_sha in rel_commits:
                    rc_code, rc_out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '1', '--format=%s%x09%ct', rc_sha])
                    if rc_code == 0 and rc_out.strip():
                        r_parts = rc_out.strip().split('\t')
                        r_ts = int(r_parts[1]) if len(r_parts) > 1 and r_parts[1].isdigit() else 0
                        r_d_ts = get_commit_deploy_ts(rc_sha, repo_path, swaps)
                        if not r_d_ts and not swaps and not os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS'):
                            r_d_ts = r_ts
                        if r_d_ts > 0:
                            rel_age_hours = (now_ts - r_d_ts) / 3600.0
                        else:
                            rel_age_hours = 0.0
                        if rel_age_hours < 24.0:
                            return {
                                'status': 'REJECTED',
                                'verdict': f'HELD_DEPENDENT_SOAK: Linked {rel_type} #{rel_num} commit {rc_sha[:8]} is within 24h soak window (age: {max(0.0, rel_age_hours):.1f}h < 24h)',
                                'issue': issue_num,
                                'commits': commits,
                                'exit_code': 1
                            }

    if not commits and issue_num:
        return {
            'status': 'REJECTED',
            'verdict': f'NO_COMMITS_FOUND: No fork commits found matching #{issue_num}',
            'issue': issue_num,
            'commits': [],
            'exit_code': 1
        }

    # Affected files
    affected_files = get_affected_files(commits, repo_path)
    target_files_set = set(affected_files)

    # Gate 2c: Subsystem Cohesion & Dependent Soak Check (HELD_DEPENDENT_SOAK)
    if target_files_set and os.path.isdir(repo_path):
        rc_ahead, out_ahead, _ = run_cmd([
            'git', '-C', repo_path, 'log', 'adolfousier/main..origin/main',
            '--format=%H%x09%s%x09%ct'
        ])
        if rc_ahead == 0 and out_ahead.strip():
            target_shas_set = set(commits)
            for line in out_ahead.strip().split('\n'):
                if not line.strip(): continue
                p_c = line.split('\t')
                other_sha = p_c[0]
                if other_sha in target_shas_set: continue
                other_subj = p_c[1] if len(p_c) > 1 else ''
                other_ts = int(p_c[2]) if len(p_c) > 2 and p_c[2].isdigit() else 0
                if other_subj.startswith('feat'):
                    other_d_ts = get_commit_deploy_ts(other_sha, repo_path, swaps)
                    if not other_d_ts and not swaps and not os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS'):
                        other_d_ts = other_ts
                    other_age_hours = (now_ts - other_d_ts) / 3600.0 if other_d_ts > 0 else 0.0
                    if other_age_hours < 24.0:
                        other_files = set(get_affected_files([other_sha], repo_path))
                        overlap = target_files_set.intersection(other_files)
                        if overlap:
                            overlap_sample = ', '.join(sorted(list(overlap))[:3])
                            return {
                                'status': 'REJECTED',
                                'verdict': f'HELD_DEPENDENT_SOAK: Candidate touches files of soaking feature {other_sha[:8]} (age: {max(0.0, other_age_hours):.1f}h < 24h, overlap: {overlap_sample})',
                                'issue': issue_num,
                                'commits': commits,
                                'files': affected_files,
                                'exit_code': 1
                            }

    # Gate 2d: In-Flight Lane Fencing Check (HELD_IN_FLIGHT_LANE)
    ledger_path = mock_ledger or os.environ.get('OC_HARVEST_MOCK_LEDGER') or os.path.join(st_dir, 'workers-ledger.json')
    active_claims = get_active_claims(ledger_path, repo_path)
    if target_files_set and active_claims:
        for claim in active_claims:
            c_iss = claim.get('issue')
            if issue_num is not None and c_iss == issue_num:
                continue
            c_files = set(claim.get('files', []))
            overlap = target_files_set.intersection(c_files)
            if overlap:
                overlap_sample = ', '.join(sorted(list(overlap))[:3])
                c_uuid = claim.get('uuid', '')[:8]
                iss_label = str(c_iss) if c_iss else '?'
                return {
                    'status': 'REJECTED',
                    'verdict': f'HELD_IN_FLIGHT_LANE: Candidate touches files of active lane {c_uuid} claim #{iss_label} (overlap: {overlap_sample})',
                    'issue': issue_num,
                    'commits': commits,
                    'files': affected_files,
                    'exit_code': 1
                }

    # Gate 2e & 2f: Native Sub-Issues (parent) and Dependencies (blockedBy) (Issue #255)
    if issue_num:
        hier = get_fork_issue_hierarchy(issue_num, repo_path=repo_path)
        if hier:
            # 2e: Parent Sub-Issue Check
            parent = hier.get('parent')
            if parent and isinstance(parent, dict):
                p_num = parent.get('number')
                p_state = parent.get('state', '').upper()
                if p_num:
                    p_harvested = is_issue_harvested_upstream(p_num, upstream_repo, repo_path, base_ref, swaps=swaps, mock_prs=mock_prs)
                    if not p_harvested or p_state == 'OPEN':
                        return {
                            'status': 'REJECTED',
                            'verdict': f'HELD_PARENT_UNHARVESTED: Issue #{issue_num} has unharvested parent #{p_num}',
                            'issue': issue_num,
                            'commits': commits,
                            'files': affected_files,
                            'exit_code': 1
                        }

            # 2f: Issue Dependencies (blockedBy) Check
            blocked_by = hier.get('blockedBy')
            blocker_nodes = []
            if isinstance(blocked_by, dict):
                blocker_nodes = blocked_by.get('nodes', [])
            elif isinstance(blocked_by, list):
                blocker_nodes = blocked_by

            unharvested_blockers = []
            for b in blocker_nodes:
                b_num = b.get('number') if isinstance(b, dict) else b
                b_state = b.get('state', '').upper() if isinstance(b, dict) else ''
                if b_num:
                    b_harvested = is_issue_harvested_upstream(b_num, upstream_repo, repo_path, base_ref, swaps=swaps, mock_prs=mock_prs)
                    if not b_harvested or b_state == 'OPEN':
                        unharvested_blockers.append(f'#{b_num}')

            if unharvested_blockers:
                blockers_str = ', '.join(unharvested_blockers)
                return {
                    'status': 'REJECTED',
                    'verdict': f'HELD_BLOCKED_BY_DEPENDENCY: Issue #{issue_num} is blocked by {blockers_str}',
                    'issue': issue_num,
                    'commits': commits,
                    'files': affected_files,
                    'exit_code': 1
                }

    # Gate 3: Empty tree-diff check on affected files
    if affected_files:
        is_empty, _ = check_files_diff(affected_files, base_ref, repo_path)
        if is_empty:
            return {
                'status': 'REJECTED',
                'verdict': f'ALREADY_MERGED_EMPTY_DIFF: Diff of affected files ({len(affected_files)} files) against {base_ref} is completely empty',
                'issue': issue_num,
                'commits': commits,
                'files': affected_files,
                'exit_code': 1
            }

    # Gate 4: Ancestor check on commits
    for c in commits:
        if check_ancestor(c, base_ref, repo_path):
            return {
                'status': 'REJECTED',
                'verdict': f'ALREADY_MERGED_ANCESTOR: Commit {c[:8]} is already an ancestor of {base_ref}',
                'issue': issue_num,
                'commits': commits,
                'exit_code': 1
            }

    # Gate 5: Patch-ID check against upstream
    for c in commits:
        pid = get_patch_id(c, repo_path)
        if pid:
            rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '100', '--format=%H', base_ref])
            if rc == 0:
                for up_c in out.strip().split('\n'):
                    if not up_c.strip(): continue
                    up_pid = get_patch_id(up_c.strip(), repo_path)
                    if up_pid and up_pid == pid:
                        return {
                            'status': 'REJECTED',
                            'verdict': f'ALREADY_MERGED_PATCH_ID: Commit {c[:8]} patch-id {pid[:8]} matches upstream commit {up_c[:8]}',
                            'issue': issue_num,
                            'commits': commits,
                            'exit_code': 1
                        }

    slug = f'issue-{issue_num}' if issue_num else 'harvest-patch'
    if commits:
        rc, out, _ = run_cmd(['git', '-C', repo_path, 'log', '-n', '1', '--format=%s', commits[0]])
        if rc == 0 and out.strip():
            s = out.strip().lower()
            s = re.sub(r'^[a-z]+(\([^\)]+\))?:\s*', '', s)
            s = re.sub(r'[^a-z0-9]+', '-', s).strip('-')[:25]
            if s:
                slug = s

    return {
        'status': 'APPROVED',
        'verdict': 'CLEAN: Novel diff, not merged upstream, files modified',
        'issue': issue_num,
        'commits': commits,
        'files': affected_files,
        'slug': slug,
        'exit_code': 0
    }

action = sys.argv[1]

if action == 'test-check-pr':
    issue_num = int(sys.argv[2])
    mock_file = sys.argv[3]
    with open(mock_file) as f:
        mock_prs = json.load(f)
    pr = check_upstream_pr(issue_num, 'mock/repo', mock_prs=mock_prs)
    if pr:
        print('FOUND:' + str(pr.get('number')))
    else:
        print('NOT_FOUND')
    sys.exit(0)

elif action == 'vet':
    candidate = sys.argv[2]
    repo_path = sys.argv[3]
    base_ref = sys.argv[4]
    upstream_repo = sys.argv[5]
    as_json = sys.argv[6] == 'true'
    
    res = vet_candidate(candidate, repo_path, base_ref, upstream_repo)
    if as_json:
        print(json.dumps(res, indent=2))
    else:
        st = res.get('status', 'UNKNOWN')
        vd = res.get('verdict', '')
        print(f'[{st}] {vd}')
        if st == 'APPROVED':
            iss = res.get('issue') or 'N/A'
            cmts = res.get('commits', [])
            fls = res.get('files', [])
            slg = res.get('slug', 'harvest')
            print(f'  Issue: #{iss}')
            print(f'  Commits: {len(cmts)} commits ({cmts[:3]})')
            print(f'  Affected files: {len(fls)} files')
            print(f'  Suggested branch: leshchenko1979/fix/{slg}')
    sys.exit(res['exit_code'])

elif action == 'dispatch':
    issue_arg = sys.argv[2]
    commits_arg = sys.argv[3]
    target_uuid = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] != 'none' else None
    repo_path = sys.argv[5]
    base_ref = sys.argv[6]
    upstream_repo = sys.argv[7]
    ledger_file = sys.argv[8]
    draft_flag = sys.argv[9] == 'true' if len(sys.argv) > 9 else False
    dry_run = sys.argv[10] == 'true' if len(sys.argv) > 10 else False

    # Step 1: Vet candidate
    v = vet_candidate(commits_arg if commits_arg else issue_arg, repo_path, base_ref, upstream_repo, mock_ledger=ledger_file)
    if v['status'] != 'APPROVED':
        st = v.get('status', '')
        vd = v.get('verdict', '')
        print(f'DISPATCH REFUSED: Candidate failed pre-flight vetting.\n  [{st}] {vd}', file=sys.stderr)
        sys.exit(1)

    # Step 2: Capacity check on ledger
    active_claims = get_active_claims(ledger_file)
    selected_worker = None

    if target_uuid:
        busy_uuids = set(c['uuid'] for c in active_claims)
        if target_uuid in busy_uuids:
            print(f'CAPACITY_EXHAUSTED: Target editor {target_uuid} is BUSY with active claim(s)', file=sys.stderr)
            sys.exit(4)
        selected_worker = {'uuid': target_uuid, 'topic_id': 'N/A'}
    else:
        avail = get_available_editors(ledger_file)
        if not avail:
            print('CAPACITY_EXHAUSTED: All registered editor lanes currently have active claims.', file=sys.stderr)
            sys.exit(4)
        selected_worker = avail[0]

    # Step 3: Format wire envelope
    iss_num = v.get('issue')
    iss_str = f'#{iss_num}' if iss_num else issue_arg
    slug = v.get('slug', 'harvest-fix')
    commits_str = ' '.join(v.get('commits', [commits_arg]))
    branch_name = f'leshchenko1979/fix/{slug}'
    
    rc, base_sha, _ = run_cmd(['git', '-C', repo_path, 'rev-parse', base_ref])
    tip_sha = base_sha.strip()[:8] if rc == 0 else base_ref

    draft_line = 'Draft: true (--draft)\n' if draft_flag else ''
    contract_mode = '--draft' if draft_flag else 'ready'
    
    # Check if this candidate carries parent or blocker dependency notices
    dep_notice_lines = []
    if iss_num:
        hier = get_fork_issue_hierarchy(iss_num, repo_path=repo_path)
        if hier:
            parent = hier.get('parent')
            if parent and isinstance(parent, dict) and parent.get('number'):
                p_num = parent.get('number')
                p_pr = check_upstream_pr(p_num, upstream_repo)
                p_ref = f'PR #{p_pr.get(\"number\")}' if p_pr else f'parent issue #{p_num}'
                dep_notice_lines.append(f'> ⚠️ **Dependency Notice**: Depends on unmerged upstream {p_ref}. Please merge first, or review/release together in a single batch.')
            blocked_by = hier.get('blockedBy')
            b_nodes = blocked_by.get('nodes', []) if isinstance(blocked_by, dict) else (blocked_by if isinstance(blocked_by, list) else [])
            for b in b_nodes:
                b_num = b.get('number') if isinstance(b, dict) else b
                if b_num:
                    b_pr = check_upstream_pr(b_num, upstream_repo)
                    b_ref = f'PR #{b_pr.get(\"number\")}' if b_pr else f'blocker issue #{b_num}'
                    dep_notice_lines.append(f'> ⚠️ **Dependency Notice**: Blocked by unmerged upstream {b_ref}. Please merge first, or review/release together in a single batch.')

    dep_section = ('\nPR Dependency Header (inject into PR description):\n' + '\n'.join(dep_notice_lines) + '\n') if dep_notice_lines else ''
    contract_line = f'Contract: AUTO-SHIP on GREEN CI gate. File PR ({contract_mode}) on {upstream_repo}:main citing gate run ID, link fork {iss_str}, include dependency notices if applicable, notify Triage. Note: Under relaxed PR-Freeze Law, PR bodies may be updated with gh pr edit --body-file to add/maintain dependency notices.'

    envelope = f'''[HARVEST DISPATCH: {iss_str}]
Target Issue: {iss_str} ({slug})
{draft_line}Source Commits: {commits_str}
Upstream Base: {base_ref} ({tip_sha})
Target Branch: {branch_name}
{dep_section}Commands:
  1. tools/oc-wt add up-{slug} {branch_name} --create --from {base_ref}
  2. git cherry-pick {commits_str}
  3. tools/oc-harvest-sweep {branch_name} --base {base_ref}
  4. git push origin {branch_name}
  5. tools/oc-prchecks {branch_name}
{contract_line}'''

    w_uuid = selected_worker.get('uuid', '')
    w_top = selected_worker.get('topic_id', 'N/A')
    print(f'Target Editor: {w_uuid} (topic {w_top})')
    print('Wire Payload:')
    print('---')
    print(envelope)
    print('---')

    if dry_run:
        print('[DRY RUN] Dispatch generated successfully without sending.')
        sys.exit(0)

    # Live delivery
    skill_dir = os.environ.get('SKILL_DIR')
    if not skill_dir:
        home_dir = os.environ.get('HOME', '/root')
        skill_dir = os.path.join(home_dir, '.opencrabs/profiles/ops/skills/opencrabs-dev')
    notify_script = os.path.join(skill_dir, 'tools/lib/oc-notify.sh')
    if not os.path.exists(notify_script):
        home_dir = os.environ.get('HOME', '/root')
        notify_script = os.path.join(home_dir, '.opencrabs/profiles/ops/skills/opencrabs-dev/tools/lib/oc-notify.sh')
    
    rc, _, err = run_cmd([notify_script, w_uuid, envelope, f'[HARVEST DISPATCH: {iss_str}]'])
    if rc != 0:
        print(f'NOTIFICATION_FAILED: lib/oc-notify.sh exited {rc}: {err.strip()}', file=sys.stderr)
        sys.exit(3)

    print(f'SUCCESS: Harvest package dispatched to editor {w_uuid}.')
    sys.exit(0)
" "$@"
}

# --- Subcommand Handlers ---

cmd_vet() {
  local candidate="" json_flag="false"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --base) BASE_REF="$2"; shift 2 ;;
      --json) json_flag="true"; shift ;;
      -h|--help) usage 0 ;;
      -*) usage ;;
      *)
        if [ -z "$candidate" ]; then
          candidate="$1"
          shift
        else
          usage
        fi
        ;;
    esac
  done
  if [ -z "$candidate" ]; then
    usage
  fi
  run_engine "vet" "$candidate" "$REPO" "$BASE_REF" "$UPSTREAM_REPO" "$json_flag"
}

cmd_dispatch() {
  local issue="" commits="" to_uuid="none" draft_flag="false" dry_run="false"
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to_uuid="$2"; shift 2 ;;
      --repo) REPO="$2"; shift 2 ;;
      --base) BASE_REF="$2"; shift 2 ;;
      --draft) draft_flag="true"; shift ;;
      --dry-run) dry_run="true"; shift ;;
      -h|--help) usage 0 ;;
      -*) usage ;;
      *)
        if [ -z "$issue" ]; then
          issue="$1"
          shift
        elif [ -z "$commits" ]; then
          commits="$1"
          shift
        else
          usage
        fi
        ;;
    esac
  done
  if [ -z "$issue" ] || [ -z "$commits" ]; then
    usage
  fi
  run_engine "dispatch" "$issue" "$commits" "$to_uuid" "$REPO" "$BASE_REF" "$UPSTREAM_REPO" "$LEDGER_FILE" "$draft_flag" "$dry_run"
}

