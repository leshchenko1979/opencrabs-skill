  echo "Old options" > "$mock_repo/options.rs"
  git -C "$mock_repo" add .
  git -C "$mock_repo" commit -q -m "base commit"
  git -C "$mock_repo" branch adolfousier/main

  # Upstream has merged changes to table.rs
  git -C "$mock_repo" checkout -q adolfousier/main
  echo "Merged table content" > "$mock_repo/table.rs"
  git -C "$mock_repo" add table.rs
  git -C "$mock_repo" commit -q -m "upstream table merge (#95)"

  # Fork main has the identical change to table.rs (so diff vs adolfousier/main is empty!)
  git -C "$mock_repo" checkout -q main
  echo "Merged table content" > "$mock_repo/table.rs"
  git -C "$mock_repo" add table.rs
  git -C "$mock_repo" commit -q -m "fix(table): blank line"
  local commit_95
  commit_95="$(git -C "$mock_repo" rev-parse HEAD)"

  # Commit with novel diff (#83) - old timestamp to pass soak
  echo "Config guard additions" >> "$mock_repo/config.rs"
  mkdir -p "$mock_repo/src/tests"
  echo "pub mod old_test;" > "$mock_repo/src/tests/mod.rs"
  git -C "$mock_repo" add config.rs src/tests/mod.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(config): serde_ignored write guard (#83)"
  local commit_83
  commit_83="$(git -C "$mock_repo" rev-parse HEAD)"

  # Fresh feat commit under 24h soak (#300) - also touches shared src/tests/mod.rs
  echo "Fresh feature" >> "$mock_repo/feat.rs"
  echo "pub mod feat_test;" >> "$mock_repo/src/tests/mod.rs"
  git -C "$mock_repo" add feat.rs src/tests/mod.rs
  GIT_COMMITTER_DATE="2026-09-14T10:00:00Z" GIT_AUTHOR_DATE="2026-09-14T10:00:00Z" git -C "$mock_repo" commit -q -m "feat(new): fresh feature under soak (#300)"
  local commit_300
  commit_300="$(git -C "$mock_repo" rev-parse HEAD)"

  # Commit already merged in upstream (#82) - cut directly on upstream branch
  git -C "$mock_repo" checkout -q adolfousier/main
  echo "Loop guard fix" >> "$mock_repo/loop.rs"
  git -C "$mock_repo" add loop.rs
  git -C "$mock_repo" commit -q -m "fix(loop): numeric args (#82)"
  local commit_82
  commit_82="$(git -C "$mock_repo" rev-parse HEAD)"
  # Also branch on main
  git -C "$mock_repo" checkout -q main
  git -C "$mock_repo" cherry-pick "$commit_82" >/dev/null 2>&1
  local fork_commit_82
  fork_commit_82="$(git -C "$mock_repo" rev-parse HEAD)"

  # Mock ledger with busy and idle editors
  local mock_ledger="$st_dir/workers-ledger.json"
  cat << 'EOF' > "$mock_ledger"
{
  "workers": [
    {
      "uuid": "11111111-1111-1111-1111-111111111111",
      "role": "editor",
      "topic_id": 101
    },
    {
      "uuid": "22222222-2222-2222-2222-222222222222",
      "role": "editor",
      "topic_id": 102
    }
  ],
  "events": [
    {
      "n": 1,
      "kind": "claim",
      "by": "editor 11111111-1111-1111-1111-111111111111",
      "what": "CLAIM #154 — busy working on plan template",
      "files": ["src/busy/file.rs"]
    }
  ]
}
EOF

  local rc=0 out=""

  # 1. Test #95 (empty diff vs adolfousier/main) -> REJECTED (rc 1)
  rc=0
  out="$(run_engine "vet" "$commit_95" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "ALREADY_MERGED_EMPTY_DIFF"; then
    echo "  ok 1 - vet #95 (empty diff) -> REJECTED exit 1"
  else
    echo "  bad 1 - vet #95 expected rc=1 ALREADY_MERGED_EMPTY_DIFF, got rc=$rc ($out)"
    return 1
  fi

  # 2. Test #82 (patch-id / ancestor of upstream) -> REJECTED (rc 1)
  rc=0
  out="$(run_engine "vet" "$fork_commit_82" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "ALREADY_MERGED"; then
    echo "  ok 2 - vet #82 (patch-id match) -> REJECTED exit 1"
  else
    echo "  bad 2 - vet #82 expected rc=1 ALREADY_MERGED, got rc=$rc ($out)"
    return 1
  fi

  # 3. Test #52 (superseded audit) -> REJECTED (rc 1)
  rc=0
  out="$(run_engine "vet" "52" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "SUPERSEDED"; then
    echo "  ok 3 - vet #52 (superseded) -> REJECTED exit 1"
  else
    echo "  bad 3 - vet #52 expected rc=1 SUPERSEDED, got rc=$rc ($out)"
    return 1
  fi

  # 4. Test #83 (novel diff) -> APPROVED (rc 0)
  rc=0
  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"
  export OC_HARVEST_NOW_TS="1789010000"
  out="$(run_engine "vet" "$commit_83" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "APPROVED"; then
    echo "  ok 4 - vet #83 (novel diff) -> APPROVED exit 0"
  else
    echo "  bad 4 - vet #83 expected rc=0 APPROVED, got rc=$rc ($out)"
    return 1
  fi

  # 4b. Test #300 (fresh feat under soak window) -> REJECTED (rc 1)
  rc=0
  export OC_HARVEST_MOCK_DEPLOYED_TS="1789000000"
  export OC_HARVEST_NOW_TS="1789010000"
  out="$(run_engine "vet" "$commit_300" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "SOAK_GATE_VIOLATION"; then
    echo "  ok 4b - vet #300 (fresh feat within soak window) -> REJECTED exit 1"
  else
    echo "  bad 4b - vet #300 expected rc=1 SOAK_GATE_VIOLATION, got rc=$rc ($out)"
    return 1
  fi
  unset OC_HARVEST_MOCK_DEPLOYED_TS

  # 4c/4d. Rebase twin resolution (#276): after a history rewrite, the soak clock must
  # anchor on the swap that first deployed the change's CONTENT (patch-id twin), never
  # collapse every commit onto the newest swap.
  # The fixture deliberately reproduces BOTH live defects, each of which silently
  # disabled the fallback while every assertion still passed:
  #   (a) the twin commit touches TWO files -- with a single-file diff git's default
  #       (unstable) patch-id coincides with --stable, so a mode mismatch stays invisible;
  #       multi-file is where the two disagree and the twin lookup misses.
  #   (b) deployed.meta.json re-records the newest swap a few seconds after the journal
  #       row -- without de-duplication swaps[-2] == swaps[-1], and "is swaps[-2] an
  #       ancestor of newest" answers TRUE for a commit vs itself, so the suffix looks
  #       intact and the twin fallback never runs.
  local rebase_repo="$st_dir/rebase-repo"
  mkdir -p "$rebase_repo"
  git -C "$rebase_repo" init -q -b main
  git -C "$rebase_repo" config user.email "test@example.com"
  git -C "$rebase_repo" config user.name "Test Runner"
  echo "base" > "$rebase_repo/base.txt"
  git -C "$rebase_repo" add .
  git -C "$rebase_repo" commit -q -m "base commit"
  git -C "$rebase_repo" branch adolfousier/main

  # Pre-rebase fork lineage: the feature lands here and is the old swap's tip.
  # TWO files on purpose -- see (a) above.
  echo "twin one" > "$rebase_repo/twin-a.txt"
  echo "twin two" > "$rebase_repo/twin-b.txt"
  git -C "$rebase_repo" add twin-a.txt twin-b.txt
  git -C "$rebase_repo" commit -q -m "feat(twin): original feature (#401)"
  local pre_swap_sha
  pre_swap_sha="$(git -C "$rebase_repo" rev-parse HEAD)"

  # Upstream must ADVANCE after the fork commit, otherwise the replay lands on the same
  # parent and git reproduces the byte-identical commit -- the fixture would then model no
  # rewrite at all (pre_swap_sha == new_twin_sha), the pre-rebase swap stays an ancestor of
  # the newest one, and the twin fallback is legitimately never reached. The self-check
  # below refuses that degenerate fixture.
  git -C "$rebase_repo" checkout -q adolfousier/main
  echo "upstream" > "$rebase_repo/upstream.txt"
  git -C "$rebase_repo" add upstream.txt
  git -C "$rebase_repo" commit -q -m "chore(upstream): advance base"

  # Simulated rebase: the SAME patch replayed onto the upstream base under a NEW sha
  git -C "$rebase_repo" checkout -q -B rebased adolfousier/main
  git -C "$rebase_repo" cherry-pick "$pre_swap_sha" >/dev/null 2>&1
  local new_twin_sha
  new_twin_sha="$(git -C "$rebase_repo" rev-parse HEAD)"

  if [ "$pre_swap_sha" = "$new_twin_sha" ]; then
    echo "  bad 4c - fixture broken: the simulated rebase did not rewrite the sha, so this test would model no rewrite"
    return 1
  fi

  # A genuinely new post-rebase feature (no pre-rebase twin anywhere)
  echo "fresh content" > "$rebase_repo/fresh.txt"
  git -C "$rebase_repo" add fresh.txt
  git -C "$rebase_repo" commit -q -m "feat(fresh): brand new feature (#402)"
  local new_fresh_sha
  new_fresh_sha="$(git -C "$rebase_repo" rev-parse HEAD)"

  # Post-rebase swap marker (so the newest swap sha is not the candidate itself)
  echo "marker" > "$rebase_repo/.swap-marker"
  git -C "$rebase_repo" add .swap-marker
  git -C "$rebase_repo" commit -q -m "release: swap marker for rebased tree"
  local post_swap_sha
  post_swap_sha="$(git -C "$rebase_repo" rev-parse HEAD)"

  # Post-rebase swap marker 2 (tests multiple post-rebase swaps where swaps[-2] is an ancestor of newest)
  echo "marker2" > "$rebase_repo/.swap-marker2"
  git -C "$rebase_repo" add .swap-marker2
  git -C "$rebase_repo" commit -q -m "release: second swap marker for rebased tree"
  local post_swap_sha2
  post_swap_sha2="$(git -C "$rebase_repo" rev-parse HEAD)"

  # Isolated state dir so these fixtures never leak into the other assertions.
  local rebase_state="$st_dir/rebase-state"
  mkdir -p "$rebase_state/oc-deploy/journal"
  printf '{"step":"auto-swap","sha":"%s","ts":"2026-09-10T00:00:00Z"}\n' "$pre_swap_sha" > "$rebase_state/oc-deploy/journal/swap-100.jsonl"
  printf '{"step":"auto-swap","sha":"%s","ts":"2026-09-17T07:31:10Z"}\n' "$post_swap_sha" > "$rebase_state/oc-deploy/journal/swap-200.jsonl"
  printf '{"step":"auto-swap","sha":"%s","ts":"2026-09-17T08:00:00Z"}\n' "$post_swap_sha2" > "$rebase_state/oc-deploy/journal/swap-201.jsonl"
  # (b) the duplicate: deployed.meta.json re-recording the newest swap seconds later.
  printf '{"sha":"%s","swapped_at":"2026-09-17T08:00:10Z"}\n' "$post_swap_sha2" > "$rebase_state/deployed.meta.json"

  export STATE_DIR="$rebase_state"
  export OC_HARVEST_NOW_TS="1789633800"

  rc=0
  out="$(run_engine "vet" "$new_twin_sha" "$rebase_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "APPROVED"; then
    echo "  ok 4c - vet rebased twin -> APPROVED on pre-rebase swap (guards --stable patch-id mode + duplicate-sha dedup)"
  else
    echo "  bad 4c - vet rebased twin expected rc=0 APPROVED via twin fallback (guards patch-id --stable mode AND duplicate-sha dedup), got rc=$rc ($out)"
    return 1
  fi

  rc=0
  out="$(run_engine "vet" "$new_fresh_sha" "$rebase_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "SOAK_GATE_VIOLATION"; then
    echo "  ok 4d - vet genuinely new post-rebase feat -> SOAK_GATE_VIOLATION exit 1"
  else
    echo "  bad 4d - vet new post-rebase feat expected rc=1 SOAK_GATE_VIOLATION (no twin), got rc=$rc ($out)"
    return 1
  fi

  # 4e. Rebase-resilience via smoke-verdicts.log (#292):
  # A rebased feature whose patch-id changed (e.g. modified context or lines) so patch-id twin fails,
  # but has a verified PASS entry in smoke-verdicts.log for its issue number (#403).
  echo "shifted content line 1" > "$rebase_repo/shifted.txt"
  git -C "$rebase_repo" add shifted.txt
  git -C "$rebase_repo" commit -q -m "feat(cron): trigger-gated pipeline (#403)"
  local shifted_sha
  shifted_sha="$(git -C "$rebase_repo" rev-parse HEAD)"

  # Append a historical PASS in smoke-verdicts.log with timestamp 2026-09-10T00:00:00Z (>24h mature)
  printf '2026-09-10T00:00:00Z\tPASS\tissue=#403\tsha=oldsha123\trun=12345\ttarget=live-ops\tevidence="smoke pass"\n' >> "$rebase_state/smoke-verdicts.log"

  rc=0
  out="$(run_engine "vet" "$shifted_sha" "$rebase_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "APPROVED"; then
    echo "  ok 4e - vet rebased feat with changed patch-id -> APPROVED via smoke-verdicts.log issue-ref anchor (#292)"
  else
    echo "  bad 4e - vet rebased feat with changed patch-id expected rc=0 APPROVED via smoke-verdicts.log (#292), got rc=$rc ($out)"
    return 1
  fi
  unset OC_HARVEST_NOW_TS
  unset STATE_DIR

  # 5. Dispatch to busy lane -> CAPACITY_EXHAUSTED (rc 4)
  rc=0
  out="$(run_engine "dispatch" "83" "$commit_83" "11111111-1111-1111-1111-111111111111" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$mock_ledger" "false" "true" 2>&1)" || rc=$?
  if [ "$rc" -eq 4 ] && echo "$out" | grep -q "CAPACITY_EXHAUSTED"; then
    echo "  ok 5 - dispatch to busy lane -> CAPACITY_EXHAUSTED exit 4"
  else
    echo "  bad 5 - dispatch to busy lane expected rc=4 CAPACITY_EXHAUSTED, got rc=$rc ($out)"
    return 1
  fi

  # 6. Dispatch auto-selects idle lane -> SUCCESS (rc 0)
  rc=0
  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"
  out="$(run_engine "dispatch" "83" "$commit_83" "none" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$mock_ledger" "false" "true" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "22222222-2222-2222-2222-222222222222"; then
    echo "  ok 6 - dispatch auto-selects idle lane -> SUCCESS exit 0"
  else
    echo "  bad 6 - dispatch auto-selects idle lane expected rc=0 with idle editor, got rc=$rc ($out)"
    return 1
  fi
  unset OC_HARVEST_MOCK_DEPLOYED_TS

  # 6b. Lane spread (#276): auto-selection rotates across idle lanes instead of pinning
  # every unit of a cycle onto the first available editor.
  local spread_ledger="$st_dir/ledger-spread.json"
  cat << 'EOF' > "$spread_ledger"
{
  "workers": [
    { "uuid": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "role": "editor", "topic_id": 201 },
    { "uuid": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", "role": "editor", "topic_id": 202 }
  ],
  "events": []
}
EOF
  local cursor_file="$st_dir/.oc-harvest-dispatch-lane-cursor"
  rm -f "$cursor_file"
  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"
  out="$(run_engine "dispatch" "83" "$commit_83" "none" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$spread_ledger" "false" "true" 2>&1)"
  if ! echo "$out" | grep -q "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"; then
    echo "  bad 6b - lane spread: no cursor should pick the first ordered lane, got: $out"
    return 1
  fi
  printf 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\n' > "$cursor_file"
  out="$(run_engine "dispatch" "83" "$commit_83" "none" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$spread_ledger" "false" "true" 2>&1)"
  if ! echo "$out" | grep -q "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"; then
    echo "  bad 6b - lane spread: cursor on aaaa should rotate to bbbb, got: $out"
    return 1
  fi
  printf 'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\n' > "$cursor_file"
  out="$(run_engine "dispatch" "83" "$commit_83" "none" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$spread_ledger" "false" "true" 2>&1)"
  if echo "$out" | grep -q "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"; then
    echo "  ok 6b - lane spread rotates across idle lanes (head -> bbbb -> wrap to aaaa)"
  else
    echo "  bad 6b - lane spread: cursor on bbbb should wrap to aaaa, got: $out"
    return 1
  fi
  rm -f "$cursor_file"
  unset OC_HARVEST_MOCK_DEPLOYED_TS

  # 7. Mock PR regex checks
  local mock_prs_file="$st_dir/mock_prs.json"
  cat << 'EOF' > "$mock_prs_file"
[
  {
    "number": 1500,
    "state": "OPEN",
    "title": "feat: auxiliary files",
    "headRefName": "harvest/216-compaction",
    "body": "Original issue: leshchenko1979/opencrabs#216"
  },
  {
    "number": 1499,
    "state": "MERGED",
    "title": "fix(flow): metrics bar in flow card (#232)",
    "headRefName": "fix/232-metrics",
    "body": "Follow-up to #999"
  }
]
EOF

  out="$(run_engine "test-check-pr" "216" "$mock_prs_file")"
  if [ "$out" = "FOUND:1500" ]; then
    echo "  ok 7 - check_upstream_pr matches real issue #216 PR -> exit 0"
  else
    echo "  bad 7 - check_upstream_pr #216 expected FOUND:1500, got ($out)"
    return 1
  fi

  out="$(run_engine "test-check-pr" "999" "$mock_prs_file")"
  if [ "$out" = "NOT_FOUND" ]; then
    echo "  ok 8 - check_upstream_pr ignores prose follow-up to #999 -> exit 0"
  else
    echo "  bad 8 - check_upstream_pr #999 expected NOT_FOUND, got ($out)"
    return 1
  fi

  # 8b. Test Native Sub-Issues (parent) and Dependencies (blockedBy) (Issue #255)
  local mock_hier_file="$st_dir/mock_hier.json"
  cat << 'EOF' > "$mock_hier_file"
{
  "501": {
    "number": 501,
    "title": "Child issue with unharvested parent",
    "state": "OPEN",
    "parent": {"number": 500, "title": "Parent issue", "state": "OPEN"},
    "blockedBy": {"nodes": [], "totalCount": 0}
  },
  "502": {
    "number": 502,
    "title": "Blocked issue",
    "state": "OPEN",
    "parent": null,
    "blockedBy": {"nodes": [{"number": 450, "title": "Blocker", "state": "OPEN"}], "totalCount": 1}
  },
  "503": {
    "number": 503,
    "title": "Clean issue with merged parent",
    "state": "OPEN",
    "parent": {"number": 95, "title": "Merged parent", "state": "CLOSED"},
    "blockedBy": {"nodes": [{"number": 95, "title": "Merged blocker", "state": "CLOSED"}], "totalCount": 1}
  }
}
EOF

  # Commit for 501
  echo "Child issue content" >> "$mock_repo/child.rs"
  git -C "$mock_repo" add child.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(child): sub-issue (#501)"
  local commit_501
  commit_501="$(git -C "$mock_repo" rev-parse HEAD)"

  # Commit for 502
  echo "Blocked issue content" >> "$mock_repo/blocked.rs"
  git -C "$mock_repo" add blocked.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(blocked): dependency (#502)"
  local commit_502
  commit_502="$(git -C "$mock_repo" rev-parse HEAD)"

  # Commit for 503
  echo "Clean issue content" >> "$mock_repo/clean.rs"
  git -C "$mock_repo" add clean.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(clean): resolved hierarchy (#503)"
  local commit_503
  commit_503="$(git -C "$mock_repo" rev-parse HEAD)"

  export OC_HARVEST_MOCK_HIERARCHY="$mock_hier_file"
  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"

  rc=0
  out="$(run_engine "vet" "$commit_501" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "HELD_PARENT_UNHARVESTED"; then
    echo "  ok 8b - vet #501 (unharvested parent) -> REJECTED HELD_PARENT_UNHARVESTED exit 1"
  else
    echo "  bad 8b - vet #501 expected rc=1 HELD_PARENT_UNHARVESTED, got rc=$rc ($out)"
    return 1
  fi

  rc=0
  out="$(run_engine "vet" "$commit_502" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "HELD_BLOCKED_BY_DEPENDENCY"; then
    echo "  ok 8c - vet #502 (unharvested blocker) -> REJECTED HELD_BLOCKED_BY_DEPENDENCY exit 1"
  else
    echo "  bad 8c - vet #502 expected rc=1 HELD_BLOCKED_BY_DEPENDENCY, got rc=$rc ($out)"
    return 1
  fi

  rc=0
  out="$(run_engine "vet" "$commit_503" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "APPROVED"; then
    echo "  ok 8d - vet #503 (merged parent/blocker) -> APPROVED exit 0"
  else
    echo "  bad 8d - vet #503 expected rc=0 APPROVED, got rc=$rc ($out)"
    return 1
  fi

  # 8e. Test dispatch with --draft flag
  rc=0
  out="$(run_engine "dispatch" "503" "$commit_503" "none" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "$mock_ledger" "true" "true" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Draft: true (--draft)"; then
    echo "  ok 8e - dispatch with --draft -> envelope carries Draft: true exit 0"
  else
    echo "  bad 8e - dispatch with --draft expected Draft: true in envelope, got rc=$rc ($out)"
    return 1
  fi

  # 8f. Test deletion/modification of path absent upstream (UPSTREAM_VOID / provenance gate)
  # Create a commit that deletes an upstream-void path introduced on fork
  echo "temp-void" > "$mock_repo/void-script.sh"
  git -C "$mock_repo" add void-script.sh
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "feat(infra): introduce void script (#126)"
  git -C "$mock_repo" rm -q void-script.sh
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" git -C "$mock_repo" commit -q -m "fix(infra): remove void script (#188)"
  local commit_188
  commit_188="$(git -C "$mock_repo" rev-parse HEAD)"

  rc=0
  out="$(run_engine "vet" "$commit_188" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && echo "$out" | grep -q "HELD_PARENT_UNHARVESTED"; then
    echo "  ok 8f - vet #188 (deleting path introduced by unharvested fork commit #126) -> REJECTED HELD_PARENT_UNHARVESTED exit 1"
  else
    echo "  bad 8f - vet #188 expected rc=1 HELD_PARENT_UNHARVESTED, got rc=$rc ($out)"
    return 1
  fi

  unset OC_HARVEST_MOCK_HIERARCHY
  unset OC_HARVEST_MOCK_DEPLOYED_TS

  # 9. --help exit 0
  rc=0
  bash "$0" --help >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "  ok 9 - --help -> exit 0"
  else
    echo "  bad 9 - --help expected rc=0, got rc=$rc"
    return 1
  fi

  # 10. missing args exit 2
  rc=0
  bash "$0" vet >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "  ok 10 - missing args -> exit 2"
  else
    echo "  bad 10 - missing args expected rc=2, got rc=$rc"
    return 1
  fi

  echo "selftest: 19/19 OK"
  return 0
}

# --- Main Dispatcher ---
case "${1:-}" in
  vet) shift; cmd_vet "$@" ;;
  dispatch) shift; cmd_dispatch "$@" ;;
  --selftest) cmd_selftest ;;
  -h|--help) usage 0 ;;
  *) usage ;;
esac
