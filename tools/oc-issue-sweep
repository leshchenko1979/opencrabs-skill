#!/usr/bin/env bash
# =============================================================================
# oc-issue-sweep — uniqueness-gate sweep in one call: search the fork
# (open + closed) and the upstream (closed) for candidate issues matching a
# query, harvest each candidate's close-reason line from its comments
# (paginated), print a deduped TSV table. The human "does one of these fit"
# judgment stays OUT (skill rule — report-only).
#
# Usage:
#   oc-issue-sweep '<query>' [--fork leshchenko1979/opencrabs]
#                            [--upstream adolfousier/opencrabs] [--limit N(=20)]
#   oc-issue-sweep --selftest
#
# Exit codes: 0 no candidates · 1 candidates listed · 2 usage · 3 API failure
# Env: OC_SWEEP_GH (gh override — offline selftest shim), OC_TOOLS_LOG
# Output (TSV): repo <TAB> # <TAB> state <TAB> title <TAB> close-reason
# =============================================================================
set -u
_OC_LIB="$(cd "$(dirname "$0")" && pwd)/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-issue-sweep" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

usage() { echo "usage: $0 '<query>' [--fork R] [--upstream R] [--limit N] | --selftest" >&2; exit 2; }
die() { echo "oc-issue-sweep: $2" >&2; exit "$1"; }

FORK="leshchenko1979/opencrabs"; UPSTREAM="adolfousier/opencrabs"; LIMIT=20; QUERY=""; SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --fork) FORK="${2:-}"; shift ;;
    --upstream) UPSTREAM="${2:-}"; shift ;;
    --limit) LIMIT="${2:-}"; shift ;;
    --selftest) SELFTEST=1 ;;
    -h|--help) usage ;;
    *) [ -z "$QUERY" ] && QUERY="$1" || usage ;;
  esac
  shift
done
echo "$LIMIT" | grep -Eq '^[0-9]+$' || usage

if [ "$SELFTEST" -eq 1 ]; then
  d="$(mktemp -d)" || exit 3
  trap '_rc=$?; rm -rf "$d"; oc_log_finish "$_rc"' EXIT
  cat > "$d/gh" <<'SHIM'
#!/usr/bin/env bash
# offline gh shim: repo/state-driven canned search results + comments
repo=""; state=""; q=""; prev=""
for a in "$@"; do
  case "$prev" in
    --repo) repo="$a"; prev="" ;;
    --state) state="$a"; prev="" ;;
    --limit) prev="" ;;
    *) [ "$prev" = "issues" ] && q="$a"; prev="$a" ;;
  esac
done
case "$q" in *nothing*) echo '[]'; exit 0 ;; esac
case "$*" in
  *comments*)
    case "$1" in
      *issues/102/comments*) echo '[{"body":"close-reason: duplicate of #101"}]' ;;
      *) echo '[]' ;;
    esac ;;
  *)
    case "$repo:$state" in
      "leshchenko1979/opencrabs:open")   echo '[{"number":101,"title":"gate probe","state":"OPEN","state_reason":null}]' ;;
      "leshchenko1979/opencrabs:closed") echo '[{"number":102,"title":"dup candidate","state":"CLOSED","state_reason":"duplicate"}]' ;;
      "adolfousier/opencrabs:closed")    echo '[{"number":7,"title":"upstream closed","state":"CLOSED","state_reason":"completed"}]' ;;
      *) echo '[]' ;;
    esac ;;
esac
SHIM
  chmod +x "$d/gh"
  OUT="$(OC_SWEEP_GH="$d/gh" "$0" "gate" --limit 5)" || [ $? -eq 1 ] || { echo "selftest: candidates rc != 1" >&2; exit 1; }
  printf '%s\n' "$OUT" | grep -q "leshchenko1979/opencrabs	101	open	gate probe	-" || { echo "selftest: row 101 wrong: $OUT" >&2; exit 1; }
  printf '%s\n' "$OUT" | grep -q "close-reason: duplicate of #101" || printf '%s\n' "$OUT" | grep -q "duplicate" || { echo "selftest: close-reason not harvested: $OUT" >&2; exit 1; }
  printf '%s\n' "$OUT" | grep -q "adolfousier/opencrabs	7	closed	upstream closed	completed" || { echo "selftest: upstream fallback row wrong: $OUT" >&2; exit 1; }
  [ "$(printf '%s\n' "$OUT" | grep -c .)" -eq 3 ] || { echo "selftest: row count $([ $(printf '%s\n' "$OUT" | grep -c .) ] && echo n) != 3: $OUT" >&2; exit 1; }
  OC_SWEEP_GH="$d/gh" "$0" "zzz-nothing" >/dev/null 2>&1; [ $? -eq 0 ] || { echo "selftest: no-candidates rc != 0" >&2; exit 1; }
  "$0" >/dev/null 2>&1; [ $? -eq 2 ] || { echo "selftest: no-args != 2" >&2; exit 1; }
  echo "selftest OK"; exit 0
fi

[ -n "$QUERY" ] || usage
GH="${OC_SWEEP_GH:-gh}"

# 1. three searches: fork open+closed, upstream closed
TMP="$(mktemp)" || exit 3
trap '_rc=$?; rm -f "$TMP"; oc_log_finish "$_rc"' EXIT
for spec in "$FORK:open" "$FORK:closed" "$UPSTREAM:closed"; do
  R="${spec%:*}"; S="${spec##*:}"
  "$GH" search issues "$QUERY" --repo "$R" --state "$S" --limit "$LIMIT" \
    --json number,title,state,state_reason,html_url > "$TMP.raw" 2>/dev/null \
    || die 3 "gh search failed (repo=$R state=$S)"
  jq -c --arg repo "$R" '.[] | {repo:$repo,number,title,state:(.state|ascii_downcase),reason:(.state_reason//"-"),html_url}' "$TMP.raw" >> "$TMP"
done

# 2. per candidate: close-reason line from paginated comments (state_reason fallback)
while IFS= read -r item; do
  R="$(printf '%s' "$item" | jq -r .repo)"
  N="$(printf '%s' "$item" | jq -r .number)"
  BODIES="$("$GH" api --paginate "repos/$R/issues/$N/comments?per_page=100" 2>/dev/null | jq -r '.[] | .body // empty' 2>/dev/null)"
  REASON="$(printf '%s\n' "$BODIES" | sed -n 's/^[Cc]lose[- ]reason:[[:space:]]*//p' | head -1)"
  [ -n "$REASON" ] || REASON="$(printf '%s' "$item" | jq -r '.reason')"
  [ "$REASON" = "-" ] || [ -n "$REASON" ] || REASON="-"
  printf '%s\t%s\t%s\t%s\t%s\n' "$R" "$N" \
    "$(printf '%s' "$item" | jq -r .state)" \
    "$(printf '%s' "$item" | jq -r .title)" "$REASON"
done < "$TMP" | LC_ALL=C sort -t$'\t' -k1,1 -k2,2n > "$TMP.sorted"

# 3. dedupe by repo#num (belt-and-braces — searches are disjoint, but cheap)
awk -F'\t' '!seen[$1"#"$2]++' "$TMP.sorted" > "$TMP.final"

NROWS="$(grep -c . "$TMP.final")"
if [ "$NROWS" -gt 0 ]; then
  cat "$TMP.final"
  exit 1
fi
exit 0