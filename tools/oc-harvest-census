# --- Gate-4 subject-predicate fixture (#365) ---------------------------------
# Builds a REAL git repo whose upstream ref (`adolfousier/main`) and fork range
# (`adolfousier/main..origin/main`) exercise gate 4 end to end. The offline
# selftest's synthetic commit dicts cannot: gate 4 derives symbols from real
# diffs, so a fixture that only fakes commit metadata would test nothing.
#
# Shape (target #901, orphan path src/orphan.rs introduced by #900):
#   A  base commit            src/base.rs  -> upstream copy (adolfousier/main)
#   B  add src/orphan.rs      Issue-Ref #900   (the orphan's provenance)
#   C  parent #900's work     mode=harvested   -> inside fn base_fn  (upstream-present symbol)
#                             mode=unharvested -> inside fn orphan_fn (fork-only symbol)
#   D  target #901's fix      inside fn base_fn AND src/orphan.rs (M) -> gate 4's file loop
#
# `$1` = repo dir, `$2` = harvested|unharvested.
build_gate4_fixture() {
  _fx_dir="$1"
  _fx_mode="$2"
  mkdir -p "$_fx_dir/src"
  git -C "$_fx_dir" init -q
  git -C "$_fx_dir" config user.name fixture
  git -C "$_fx_dir" config user.email fixture@example.invalid
  git -C "$_fx_dir" config commit.gpgsign false

  printf 'pub fn base_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/base.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "base"
  _fx_a="$(git -C "$_fx_dir" rev-parse HEAD)"
  git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$_fx_a"

  printf 'pub fn orphan_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/orphan.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "add fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

  if [ "$_fx_mode" = "harvested" ]; then
    # Parent work lands in an upstream-present symbol -> parent HARVESTED.
    printf 'pub fn base_fn() -> u8 {\n    3\n}\n' > "$_fx_dir/src/base.rs"
  else
    # Parent work lands only in the fork-only symbol -> parent UNHARVESTED.
    printf 'pub fn orphan_fn() -> u8 {\n    4\n}\n' > "$_fx_dir/src/orphan.rs"
  fi
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "parent work" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

  # Target's own fix: one upstream-present symbol (so class 3 passes) plus a
  # modification to the orphan path (so gate 4's file loop reaches class 2).
  printf 'pub fn base_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/base.rs"
  printf 'pub fn orphan_fn() -> u8 {\n    6\n}\n' > "$_fx_dir/src/orphan.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#901"

  git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
}

