#!/usr/bin/env bash
# =============================================================================
# oc-harvest-census — mechanized harvest inventory, gate verification, and settling
#
# Settling authority is the upstream GitHub PR API (adolfousier/opencrabs),
# cross-referenced with fork commit trailers (Issue-Ref: leshchenko1979/opencrabs#N)
# and branch names.
#
# Subcommands:
#   scan [--repo <path>] [--upstream <repo>] [--json]
#       Scans upstream PRs and local ahead commits, outputting classified census.
#   check <issue-or-slug> [--repo <path>]
#       Pre-flight gate:
#       - Exits 1 (REFUSED) if matching unit is already MERGED or IN_FLIGHT.
#       - Exits 1 (REFUSED) if matching unit is within 24h feature soak window.
#       - Exits 1 (REFUSED) if matching unit touches files of an unharvested/soaking feature (HELD_DEPENDENT_SOAK).
#       - Exits 1 (REFUSED) if matching unit touches files of an active in-flight lane (HELD_IN_FLIGHT_LANE).
#       - Exits 0 (ELIGIBLE) if unit is confirmed UNHARVESTED.
#       - Exits 2 on usage / bad arguments.
#       - Exits 3 on API/git failure.
#   record --unit <slug> --pr <number> [--issue <N>] [--repo <path>]
#       Records a newly filed PR in the harvest registry.
#   sync [--repo <path>] [--state-file <path>]
#       Fetches live upstream PRs, resolves against git DAG, updates harvest-registry.json.
#   --help | -h
#       Prints usage and exits 0 (RC-CONTRACT rule).
#   --selftest
#       Offline unit test battery (mock git/data, no network).
# =============================================================================
set -u
set -o pipefail

_OC_LIB="$(cd "$(dirname "$0")" && pwd)/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then
  source "$_OC_LIB"
  oc_log_init "oc-harvest-census" "$@"
else
  oc_log_finish() { :; }
fi
trap 'oc_log_finish $?' EXIT

PROG="$(basename "$0")"
REPO="${HOME}/opencrabs"
UPSTREAM_REPO="adolfousier/opencrabs"
STATE_DIR="${HOME}/.opencrabs/profiles/ops/opencrabs-dev"
REGISTRY_FILE="${STATE_DIR}/harvest-registry.json"

usage() {
  cat <<EOF
Usage:
  $PROG scan [--repo <path>] [--upstream <owner/repo>] [--json]
  $PROG check <issue-number-or-slug> [--repo <path>]
  $PROG record --unit <slug> --pr <number> [--issue <N>]
  $PROG sync [--repo <path>] [--state-file <path>]
  $PROG --help | -h
  $PROG --selftest

Exit codes:
  0: ELIGIBLE / Clean / Success / --help
  1: REFUSED (already MERGED, IN_FLIGHT upstream, SOAK, HELD_DEPENDENT_SOAK, HELD_IN_FLIGHT_LANE) / Finding
  2: Usage error
  3: Git or GitHub API failure
EOF
  exit "${1:-2}"
}

# --- Core Python Engine (Deterministic Parsing & Matching) ---
run_engine() {
  python3 -c "
import sys, os, json, re, subprocess, argparse, time, datetime, glob

def parse_iso_ts(ts_str):
    if not ts_str: return 0
    try:
        if ts_str.endswith('Z'):
            ts_str = ts_str[:-1] + '+00:00'
        return int(datetime.datetime.fromisoformat(ts_str).timestamp())
    except Exception:
        return 0

def load_swap_history(state_dir):
    swaps = []
    if not state_dir or not os.path.exists(state_dir):
        return swaps
    journals = glob.glob(os.path.join(state_dir, 'oc-deploy', 'journal', 'swap-*.jsonl'))
    for jf in journals:
        try:
            with open(jf) as f:
                for line in f:
                    if not line.strip(): continue
                    data = json.loads(line)
                    if data.get('step') == 'auto-swap' and data.get('sha') and data.get('ts'):
                        ts_val = parse_iso_ts(data['ts'])
                        if ts_val > 0:
                            swaps.append((data['sha'], ts_val))
                        break
        except Exception:
            pass
    meta_path = os.path.join(state_dir, 'deployed.meta.json')
    if os.path.exists(meta_path):
        try:
            with open(meta_path) as f:
                data = json.load(f)
                ts_str = data.get('swapped_at') or data.get('ts')
                sha = data.get('sha')
                ts_val = parse_iso_ts(ts_str)
                if sha and ts_val > 0:
                    swaps.append((sha, ts_val))
        except Exception:
            pass
    swaps.sort(key=lambda x: x[1])
    dedup = {}
    for s_sha, s_ts in swaps:
        if s_sha not in dedup or s_ts < dedup[s_sha]:
            dedup[s_sha] = s_ts
    return sorted(dedup.items(), key=lambda x: x[1])

_SWAP_LINEAGE_CACHE = {}
_TWIN_SCAN_CACHE = {}

def check_ancestor(commit, base_ref, repo_path):
    rc = subprocess.run(['git', '-C', repo_path, 'merge-base', '--is-ancestor', commit, base_ref], capture_output=True).returncode
    return rc == 0

def _swap_suffix_start(repo_path, swaps):
    if len(swaps) < 2:
        return 0
    newest = swaps[-1][0]
    i = len(swaps) - 1
    while i > 0 and check_ancestor(swaps[i - 1][0], newest, repo_path):
        i -= 1
    return i

def swap_suffix_start_cached(repo_path, swaps):
    key = (repo_path, tuple(s for s, _ in swaps))
    if key not in _SWAP_LINEAGE_CACHE:
        _SWAP_LINEAGE_CACHE[key] = _swap_suffix_start(repo_path, swaps)
    return _SWAP_LINEAGE_CACHE[key]

def get_patch_id(commit, repo_path):
    res = subprocess.run(['git', '-C', repo_path, 'show', commit], capture_output=True, text=True)
    if res.returncode != 0:
        return None
    p = subprocess.run(['git', 'patch-id', '--stable'], input=res.stdout, text=True, capture_output=True)
    if p.returncode == 0 and p.stdout:
        return p.stdout.strip().split()[0]
    return None

def range_patch_ids(repo_path, base_sha, tip_sha):
    rng = f'{base_sha}..{tip_sha}' if base_sha else tip_sha
    res = subprocess.run(['git', '-C', repo_path, 'log', '-p', '--no-merges',
                          '--format=commit %H', rng], capture_output=True, text=True)
    if res.returncode != 0 or not res.stdout:
        return
    pid = subprocess.run(['git', 'patch-id', '--stable'], input=res.stdout,
                         capture_output=True, text=True)
    for line in pid.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            yield parts[0], parts[1]

def twin_deploy_ts(commit_sha, repo_path, swaps, before_idx):
    if before_idx <= 0:
        return 0
    target = get_patch_id(commit_sha, repo_path)
    if not target:
        return 0
    key = (repo_path, tuple(s for s, _ in swaps))
    state = _TWIN_SCAN_CACHE.setdefault(key, {'next_idx': 0, 'pid_ts': {}})
    pid_ts = state['pid_ts']
    if target in pid_ts:
        return pid_ts[target]
    while state['next_idx'] < before_idx:
        i = state['next_idx']
        state['next_idx'] += 1
        base = swaps[i - 1][0] if i > 0 else None
        for pid, _sha in range_patch_ids(repo_path, base, swaps[i][0]):
            pid_ts.setdefault(pid, swaps[i][1])
        if target in pid_ts:
            return pid_ts[target]
    return pid_ts.get(target, 0)

def get_commit_deploy_ts(commit_sha, repo_path, swaps, mock_deployed_ts=None):
    if mock_deployed_ts is not None and int(mock_deployed_ts) > 0:
        return int(mock_deployed_ts)
    mock_env = os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS')
    if mock_env and mock_env.isdigit() and int(mock_env) > 0:
        return int(mock_env)
    if not swaps:
        return 0
    for s_sha, s_ts in swaps:
        if commit_sha == s_sha or commit_sha.startswith(s_sha) or s_sha.startswith(commit_sha):
            return s_ts
    if not os.path.isdir(repo_path):
        return 0
    latest_sha = swaps[-1][0]
    suffix_start = swap_suffix_start_cached(repo_path, swaps)
    ts = 0
    if check_ancestor(commit_sha, latest_sha, repo_path):
        low = suffix_start
        high = len(swaps) - 1
        earliest_idx = high
        while low <= high:
            mid = (low + high) // 2
            mid_sha = swaps[mid][0]
            if check_ancestor(commit_sha, mid_sha, repo_path):
                earliest_idx = mid
                high = mid - 1
            else:
                low = mid + 1
        ts = swaps[earliest_idx][1]
    if suffix_start > 0:
        twin_ts = twin_deploy_ts(commit_sha, repo_path, swaps, suffix_start)
        if twin_ts and (ts == 0 or twin_ts < ts):
            return twin_ts
    return ts

def get_prs(upstream_repo, mock_prs_file=None):
    if mock_prs_file and os.path.exists(mock_prs_file):
        with open(mock_prs_file) as f:
            return json.load(f)
    cmd = [
        'gh', 'pr', 'list', '--repo', upstream_repo,
        '--state', 'all', '--limit', '150',
        '--json', 'number,title,state,headRefName,mergedAt,body'
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        raise RuntimeError(f'gh pr list failed: {res.stderr.strip()}')
    return json.loads(res.stdout)

def get_squashed_upstream_prs(repo_path, mock_squashed_file=None):
    if mock_squashed_file and os.path.exists(mock_squashed_file):
        try:
            with open(mock_squashed_file) as f:
                loaded = json.load(f)
                return {int(k): v for k, v in loaded.items()}
        except Exception:
            return {}
    if not os.path.isdir(repo_path):
        return {}
    cmd = ['git', '-C', repo_path, 'rev-parse', '--verify', 'adolfousier/main']
    ref = 'adolfousier/main' if subprocess.run(cmd, capture_output=True).returncode == 0 else 'HEAD'
    cmd = [
        'git', '-C', repo_path, 'log', '-n', '1000',
        '--format=%H%x1f%h%x1f%s%x1f%b%x1e', ref
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        return {}
    squashed = {}
    for r in res.stdout.split('\x1e'):
        if not r.strip(): continue
        parts = r.split('\x1f')
        if len(parts) < 4: continue
        full_sha, short_sha, subj, body = parts[0].strip(), parts[1].strip(), parts[2].strip(), parts[3]
        for m in re.finditer(r'(?:Squashed from PR|Closes)\s+#(\d+)', body, re.IGNORECASE):
            pr_num = int(m.group(1))
            if pr_num not in squashed:
                squashed[pr_num] = {
                    'sha': full_sha,
                    'short_sha': short_sha,
                    'subject': subj
                }
    return squashed

def get_ahead_commits(repo_path, mock_commits_file=None):
    if mock_commits_file and os.path.exists(mock_commits_file):
        with open(mock_commits_file) as f:
            return json.load(f)
    if not os.path.isdir(repo_path):
        return []
    cmd = [
        'git', '-C', repo_path, 'log', 'adolfousier/main..origin/main',
        '--format=%H%x1f%h%x1f%s%x1f%(trailers:key=Issue-Ref,valueonly,separator=)%x1f%ct'
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        return []
    commits = []
    for line in res.stdout.strip().split('\n'):
        if not line: continue
        parts = line.split('\x1f')
        if len(parts) < 5: continue
        full_sha = parts[0]
        short_sha = parts[1] if len(parts) > 1 else full_sha[:7]
        subject = parts[2] if len(parts) > 2 else ''
        trailer = parts[3].strip() if len(parts) > 3 else ''
        commit_ts = int(parts[4]) if len(parts) > 4 and parts[4].strip().isdigit() else 0
        commits.append({
            'sha': full_sha, 'short_sha': short_sha,
            'subject': subject, 'trailer': trailer,
            'commit_ts': commit_ts
        })
    return commits

def parse_issue_map(prs):
    issue_map = {}
    pr_entries = []
    for p in prs:
        num = p['number']
        state = p['state']
        title = p.get('title', '')
        body = p.get('body', '') or ''
        head = p.get('headRefName', '') or ''
        merged_at = p.get('mergedAt')
        
        issues = set()
        for m in re.finditer(r'leshchenko1979/opencrabs#(?:issues/)?(\d+)', body):
            issues.add(int(m.group(1)))
        for m in re.finditer(r'leshchenko1979/opencrabs/issues/(\d+)', body):
            issues.add(int(m.group(1)))
        for m in re.finditer(r'(?:fix|feat|up|harvest)[/-](\d+)', head):
            issues.add(int(m.group(1)))
        for m in re.finditer(r'/(\d+)-', head):
            issues.add(int(m.group(1)))
        for m in re.finditer(r'\(#(\d{1,3})\)', title):
            if 'leshchenko1979' in body or 'leshchenko1979' in head:
                issues.add(int(m.group(1)))
        for m in re.finditer(r'leshchenko1979/opencrabs#(\d+)', title):
            issues.add(int(m.group(1)))
        
        entry = {
            'pr': num,
            'state': state,
            'title': title,
            'head': head,
            'merged_at': merged_at,
            'issues': sorted(list(issues))
        }
        pr_entries.append(entry)
        
        for iss in issues:
            cur = issue_map.get(iss)
            if not cur:
                issue_map[iss] = entry
            elif state == 'MERGED':
                issue_map[iss] = entry
            elif state == 'OPEN' and cur['state'] == 'CLOSED':
                issue_map[iss] = entry

    return issue_map, pr_entries

SHARED_DECLARATION_REGISTRIES = {
    'src/tests/mod.rs',
    'src/brain/tools/mod.rs',
    'src/channels/telegram/mod.rs',
    'src/channels/telegram/rich/mod.rs',
    'src/db/repository/mod.rs',
    'src/memory/mod.rs',
    'src/services/mod.rs',
    'src/utils/mod.rs',
    'src/brain/mod.rs',
    'src/cron/mod.rs',
}

def filter_substantive_overlap(overlap_set):
    return {f for f in overlap_set if f not in SHARED_DECLARATION_REGISTRIES}

def get_affected_files_for_commits(commits_list, repo_path):
    files = set()
    for c in commits_list:
        if isinstance(c, dict):
            if 'files' in c and isinstance(c['files'], list):
                for f in c['files']:
                    if f.strip(): files.add(f.strip())
                continue
            sha = c.get('sha', '')
        else:
            sha = str(c)
        if sha and os.path.isdir(repo_path):
            res = subprocess.run(['git', '-C', repo_path, 'diff-tree', '--no-commit-id', '--name-only', '-r', sha], capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.strip():
                for f in res.stdout.strip().split('\n'):
                    if f.strip(): files.add(f.strip())
    return sorted(list(files))

def get_affected_file_actions_for_commits(commits_list, repo_path):
    file_actions = {}
    for c in commits_list:
        sha = c.get('sha', '') if isinstance(c, dict) else str(c)
        if sha and os.path.isdir(repo_path):
            res = subprocess.run(['git', '-C', repo_path, 'diff-tree', '--no-commit-id', '--name-status', '-r', sha], capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.strip():
                for line in res.stdout.strip().split('\n'):
                    if not line.strip(): continue
                    parts = line.split('\t')
                    action = parts[0][0] if parts[0] else 'M'
                    f_path = parts[-1].strip()
                    if f_path:
                        file_actions.setdefault(f_path, set()).add(action)
    return file_actions

def check_upstream_file_existence(path, base_ref, repo_path):
    res = subprocess.run(['git', '-C', repo_path, 'cat-file', '-e', f'{base_ref}:{path}'], capture_output=True, text=True)
    return res.returncode == 0

def check_fork_path_provenance(path, repo_path):
    range_arg = 'adolfousier/main..origin/main'
    rc_rev = subprocess.run(['git', '-C', repo_path, 'rev-parse', '--verify', 'origin/main'], capture_output=True).returncode
    if rc_rev != 0:
        range_arg = 'adolfousier/main..HEAD'
    res = subprocess.run([
        'git', '-C', repo_path, 'log', '--diff-filter=A',
        '--format=%H%x09%s%x09%(trailers:key=Issue-Ref,valueonly)',
        '-1', range_arg, '--', path
    ], capture_output=True, text=True)
    if res.returncode == 0 and res.stdout.strip():
        parts = res.stdout.strip().split('\t')
        intro_sha = parts[0]
        intro_subj = parts[1] if len(parts) > 1 else ''
        intro_tr = parts[2] if len(parts) > 2 else ''
        m = re.search(r'#(\d+)', intro_tr) or re.search(r'#(\d+)', intro_subj)
        intro_iss = int(m.group(1)) if m else None
        return intro_sha, intro_iss, intro_subj
    return None, None, None

def get_active_claims(ledger_file, repo_path=None):
    if not os.path.exists(ledger_file):
        return []
    try:
        with open(ledger_file) as f:
            data = json.load(f)
    except Exception:
        return []
    events = data.get('events', [])
    claims = []
    for idx, ev in enumerate(events):
        if ev.get('kind') == 'claim':
            by = ev.get('by', '')
            m_uuid = re.search(r'([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})', by)
            uuid = m_uuid.group(1) if m_uuid else by
            what = ev.get('what', '')
            m_iss = re.search(r'#(\d+)', what) or re.search(r'issue\s*=?\s*(\d+)', what, re.IGNORECASE)
            iss = int(m_iss.group(1)) if m_iss else None
            closed = False
            for later_ev in events[idx+1:]:
                later_by = later_ev.get('by', '')
                if (uuid in later_by or (iss and f'#{iss}' in later_ev.get('what', ''))) and later_ev.get('kind') in ['close', 'confirm', 'reject', 'done', 'unclaim']:
                    closed = True
                    break
            if not closed:
                files = []
                if 'files' in ev and isinstance(ev['files'], list):
                    files = ev['files']
                elif iss and repo_path and os.path.isdir(repo_path):
                    res = subprocess.run(['git', '-C', repo_path, 'log', '-n', '10', f'--grep=#{iss}', '--format=%H'], capture_output=True, text=True)
                    if res.returncode == 0 and res.stdout.strip():
                        c_shas = [s.strip() for s in res.stdout.strip().split('\n') if s.strip()]
                        files = get_affected_files_for_commits(c_shas, repo_path)
                claims.append({
                    'uuid': uuid,
                    'issue': iss,
                    'what': what,
                    'files': files
                })
    return claims

action = sys.argv[1]
upstream_repo = sys.argv[2]
repo_path = sys.argv[3]
registry_file = sys.argv[4]
target = sys.argv[5] if len(sys.argv) > 5 else ''
mock_prs = os.environ.get('OC_HARVEST_MOCK_PRS')
mock_commits = os.environ.get('OC_HARVEST_MOCK_COMMITS')
mock_ledger = os.environ.get('OC_HARVEST_MOCK_LEDGER')
mock_squashed = os.environ.get('OC_HARVEST_MOCK_SQUASHED')

try:
    prs = get_prs(upstream_repo, mock_prs)
except Exception as e:
    if os.path.exists(registry_file) and action == 'check':
        with open(registry_file) as f:
            cached = json.load(f)
        prs = cached.get('prs', [])
    else:
        sys.stderr.write(f'oc-harvest-census error: {e}\n')
        sys.exit(3)

squashed_prs = get_squashed_upstream_prs(repo_path, mock_squashed)
for p in prs:
    num = p.get('number')
    if p.get('state') == 'CLOSED' and num in squashed_prs:
        p['state'] = 'MERGED'
        p['squashed_commit'] = squashed_prs[num]

issue_map, pr_entries = parse_issue_map(prs)

if action == 'check':
    m_iss = re.fullmatch(r'#?(\d+)', target) or re.fullmatch(r'issue-?(\d+)', target, re.IGNORECASE)
    target_iss = int(m_iss.group(1)) if m_iss else None
    
    match = None
    if target_iss and target_iss in issue_map:
        match = issue_map[target_iss]
    elif not target_iss:
        for p in pr_entries:
            if target.lower() in p['head'].lower() or target.lower() in p['title'].lower():
                match = p
                break

    closed_match = None
    if match:
        st = match['state']
        num = match['pr']
        ti = match['title']
        if st == 'MERGED':
            print(f'REFUSED: Target {target} is already MERGED upstream in PR #{num}: {ti}')
            sys.exit(1)
        elif st == 'OPEN':
            print(f'REFUSED: Target {target} is currently IN_FLIGHT upstream in PR #{num}: {ti}')
            sys.exit(1)
        elif st == 'CLOSED':
            closed_match = match
    
    manual = []
    if os.path.exists(registry_file):
        try:
            with open(registry_file) as f:
                manual = json.load(f).get('manual_records', []) or []
        except Exception:
            manual = []
    for r in manual:
        by_issue = target_iss is not None and r.get('issue') == target_iss
        by_unit = bool(r.get('unit')) and str(r['unit']).lower() == target.lower()
        if by_issue or by_unit:
            print('REFUSED: Target %s is manually recorded as filed in PR #%s (unit %s)' % (target, r.get('pr'), r.get('unit')))
            sys.exit(1)

    commits = get_ahead_commits(repo_path, mock_commits)
    matching_commits = []
    other_commits = []
    for c in commits:
        tr = c.get('trailer', '')
        m_tr = re.search(r'#?(\d+)', tr)
        iss_c = int(m_tr.group(1)) if m_tr else None
        if not iss_c:
            m_sb = re.search(r'#?(\d+)', c.get('subject', ''))
            iss_c = int(m_sb.group(1)) if m_sb else None
        c_sha = c.get('sha', '')
        c_short = c.get('short_sha', '')
        matches_sha = bool(target and (c_sha.lower().startswith(target.lower()) or c_short.lower().startswith(target.lower())))
        matches_iss = bool(target_iss is not None and iss_c == target_iss)
        matches_subj = bool(target.lower() in c.get('subject', '').lower())
        if matches_iss or matches_subj or matches_sha:
            matching_commits.append(c)
        else:
            other_commits.append(c)

    now_ts = int(os.environ.get('OC_HARVEST_NOW_TS') or time.time())
    st_dir = os.path.dirname(registry_file) if registry_file else os.environ.get('STATE_DIR', '')
    swaps = load_swap_history(st_dir)
    
    # 1. 24H FEATURE SOAK GATE FOR TARGET ITSELF
    for mc in matching_commits:
        subj = mc.get('subject', '')
        c_sha = mc.get('sha', '')
        is_feat = subj.startswith('feat') or 'feat/' in target.lower()
        if is_feat:
            d_ts = mc.get('deployed_ts') or get_commit_deploy_ts(c_sha, repo_path, swaps, mc.get('deployed_ts'))
            if not d_ts and not swaps and not os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS'):
                d_ts = mc.get('commit_ts', 0)
            if d_ts > 0:
                age_hours = (now_ts - d_ts) / 3600.0
            else:
                age_hours = 0.0
            if age_hours < 24.0:
                print('REFUSED: Target %s is within 24h feature soak window (age: %.1fh < 24h, commit %s: %s)' % (target, max(0.0, age_hours), mc.get('short_sha', '')[:7], subj[:50]))
                sys.exit(1)

    # 2. SUBSYSTEM COHESION & DEPENDENT SOAK CHECK (HELD_DEPENDENT_SOAK)
    # Check if target touches files of an unharvested feat/* currently in soak window
    target_files = set(get_affected_files_for_commits(matching_commits, repo_path))
    if target_files:
        for oc in other_commits:
            oc_subj = oc.get('subject', '')
            oc_sha = oc.get('sha', '')
            if oc_subj.startswith('feat'):
                # Check if this other feat is in soak window
                oc_d_ts = oc.get('deployed_ts') or get_commit_deploy_ts(oc_sha, repo_path, swaps, oc.get('deployed_ts'))
                if not oc_d_ts and not swaps and not os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS'):
                    oc_d_ts = oc.get('commit_ts', 0)
                oc_age_hours = (now_ts - oc_d_ts) / 3600.0 if oc_d_ts > 0 else 0.0
                if oc_age_hours < 24.0:
                    # Check file overlap
                    oc_files = set(get_affected_files_for_commits([oc], repo_path))
                    overlap = target_files.intersection(oc_files)
                    substantive_overlap = filter_substantive_overlap(overlap)
                    if substantive_overlap:
                        overlap_sample = ', '.join(sorted(list(substantive_overlap))[:3])
                        print('REFUSED: Target %s touches files of soaking feature %s (age: %.1fh < 24h) [HELD_DEPENDENT_SOAK: %s]' % (target, oc.get('short_sha', '')[:7], max(0.0, oc_age_hours), overlap_sample))
                        sys.exit(1)

    # 3. IN-FLIGHT LANE FENCING (HELD_IN_FLIGHT_LANE)
    # Check if target touches files belonging to an active lane with an open claim
    ledger_path = mock_ledger or os.path.join(st_dir, 'workers-ledger.json')
    active_claims = get_active_claims(ledger_path, repo_path)
    if target_files and active_claims:
        for claim in active_claims:
            c_iss = claim.get('issue')
            if target_iss is not None and c_iss == target_iss:
                continue # own claim is not a foreign conflict
            c_files = set(claim.get('files', []))
            if not c_files and c_iss and repo_path:
                c_files = set(get_affected_files_for_commits(resolve_issue_commits(c_iss, repo_path) if 'resolve_issue_commits' in locals() else [], repo_path))
            overlap = target_files.intersection(c_files)
            if overlap:
                overlap_sample = ', '.join(sorted(list(overlap))[:3])
                c_uuid = claim.get('uuid', '')[:8]
                print('REFUSED: Target %s touches files of active lane %s claim #%s [HELD_IN_FLIGHT_LANE: %s]' % (target, c_uuid, c_iss or '?', overlap_sample))
                sys.exit(1)

    # 4. UPSTREAM FILE EXISTENCE & FORK PROVENANCE (UPSTREAM-VOID / HELD_PARENT_UNHARVESTED)
    if target_files and repo_path and os.path.isdir(repo_path):
        base_ref = 'adolfousier/main'
        file_actions = get_affected_file_actions_for_commits(matching_commits, repo_path)
        for f_path, actions in file_actions.items():
            if any(a in ('D', 'M') for a in actions):
                exists_upstream = check_upstream_file_existence(f_path, base_ref, repo_path)
                if not exists_upstream:
                    intro_sha, intro_iss, intro_subj = check_fork_path_provenance(f_path, repo_path)
                    if intro_iss and target_iss is not None and intro_iss != target_iss:
                        print('REFUSED: Target %s path %s was introduced by unharvested fork issue #%s (%s) and does not exist in %s [HELD_PARENT_UNHARVESTED]' % (target, f_path, intro_iss, intro_sha[:8] if intro_sha else '?', base_ref))
                        sys.exit(1)
                    print('REFUSED: Target %s path %s does not exist in %s [UPSTREAM_VOID]' % (target, f_path, base_ref))
                    sys.exit(1)

    if closed_match:
        num = closed_match['pr']
        ti = closed_match['title']
        print(f'ELIGIBLE_REWORK: Target {target} had PR #{num} CLOSED without merge: {ti}')
        sys.exit(0)

    print(f'ELIGIBLE: Target {target} is confirmed UNHARVESTED (clean to branch and gate)')
    sys.exit(0)

elif action in ('scan', 'sync'):
    as_json = '--json' in sys.argv
    commits = get_ahead_commits(repo_path, mock_commits)
    
    unharvested = []
    covered = []
    for c in commits:
        tr = c['trailer']
        m = re.search(r'#?(\d+)', tr)
        iss = int(m.group(1)) if m else None
        if not iss:
            m = re.search(r'#?(\d+)', c['subject'])
            iss = int(m.group(1)) if m else None
        
        pr_info = issue_map.get(iss) if iss else None
        if pr_info:
            c['upstream_pr'] = pr_info['pr']
            c['upstream_state'] = pr_info['state']
            covered.append(c)
        else:
            unharvested.append(c)
            
    summary = {
        'upstream_open_prs': [p for p in pr_entries if p['state'] == 'OPEN'],
        'upstream_merged_prs': [p for p in pr_entries if p['state'] == 'MERGED'],
        'unharvested_commits': unharvested,
        'covered_commits': covered,
        'mapped_issues': len(issue_map)
    }

    if action == 'sync' or (action == 'scan' and registry_file):
        os.makedirs(os.path.dirname(os.path.abspath(registry_file)), exist_ok=True)
        merged = {}
        if os.path.exists(registry_file):
            try:
                with open(registry_file) as f:
                    loaded = json.load(f)
                if isinstance(loaded, dict):
                    merged = loaded
            except Exception:
                merged = {}
        merged['prs'] = prs
        merged['summary'] = summary
        with open(registry_file, 'w') as f:
            json.dump(merged, f, indent=2)

    if as_json:
        print(json.dumps(summary, indent=2))
    else:
        open_prs = summary['upstream_open_prs']
        print(f'=== Upstream In-Flight PRs ({len(open_prs)} open) ===')
        for p in open_prs:
            iss_first = p['issues'][0] if p['issues'] else None
            issues_str = f' [#{iss_first}]' if iss_first is not None else ''
            pr_num = p['pr']
            head_ref = p['head']
            title_part = p['title'][:50]
            print(f'  PR #{pr_num:<4d} {head_ref:<40s}{issues_str} - {title_part}')
        
        print(f'\n=== Ahead Commits Classification ===')
        print(f'  Total Ahead: {len(commits)} commits')
        print(f'  Covered by PRs: {len(covered)} commits')
        print(f'  Unharvested: {len(unharvested)} commits')
        
        if unharvested:
            print('\n=== Unharvested Ahead Candidates (sample) ===')
            for c in unharvested[:10]:
                c_sha = c['short_sha']
                c_sub = c['subject'][:65]
                print(f'  {c_sha} {c_sub}')
    sys.exit(0)
" "$@"
}

# --- Subcommand Handlers ---

cmd_scan() {
  local json_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --upstream) UPSTREAM_REPO="$2"; shift 2 ;;
      --json) json_flag="--json"; shift ;;
      *) usage ;;
    esac
  done
  run_engine "scan" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" "" $json_flag
}

cmd_check() {
  local target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      -h|--help) usage 0 ;;
      -*) usage ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
          shift
        else
          usage
        fi
        ;;
    esac
  done
  if [ -z "$target" ]; then
    usage
  fi
  run_engine "check" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" "$target"
}

cmd_record() {
  local unit="" pr="" issue=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --unit) unit="$2"; shift 2 ;;
      --pr) pr="$2"; shift 2 ;;
      --issue) issue="$2"; shift 2 ;;
      --repo) REPO="$2"; shift 2 ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  if [ -z "$unit" ] || [ -z "$pr" ]; then
    usage
  fi
  if [ -f "$REGISTRY_FILE" ]; then
    python3 -c '
import sys, json, os, datetime
reg_file, unit, pr, issue = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
with open(reg_file) as f:
    data = json.load(f)
records = data.setdefault("manual_records", [])
records.append({
    "unit": unit,
    "pr": int(pr),
    "issue": int(issue) if issue else None,
    "recorded_at": datetime.datetime.now(datetime.timezone.utc).isoformat()
})
with open(reg_file, "w") as f:
    json.dump(data, f, indent=2)
print(f"Recorded Unit {unit} -> PR #{pr} in {reg_file}")
' "$REGISTRY_FILE" "$unit" "$pr" "$issue"
  else
    echo "Recorded Unit $unit -> PR #$pr (registry uninitialized)"
  fi
  exit 0
}

cmd_sync() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --upstream) UPSTREAM_REPO="$2"; shift 2 ;;
      --state-file) REGISTRY_FILE="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  run_engine "sync" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" ""
}

