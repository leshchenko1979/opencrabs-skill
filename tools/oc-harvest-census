cmd_record() {
  local unit="" pr="" issue="" issues_str=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --unit) unit="$2"; shift 2 ;;
      --state-file) REGISTRY_FILE="$2"; shift 2 ;;
      --pr) pr="$2"; shift 2 ;;
      --issue) issue="$2"; shift 2 ;;
      --issues) issues_str="$2"; shift 2 ;;
      --repo) REPO="$2"; shift 2 ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  if [ -z "$unit" ] || [ -z "$pr" ]; then
    usage
  fi
  if [ -f "$REGISTRY_FILE" ]; then
    python3 -c '
import sys, json, os, datetime, re
reg_file, unit, pr, issue, issues_str = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
with open(reg_file) as f:
    data = json.load(f)
records = data.setdefault("manual_records", [])
all_issues = set()
if issue:
    all_issues.add(int(issue))
if issues_str:
    for m in re.finditer(r"\d+", issues_str):
        all_issues.add(int(m.group(0)))

record_entry = {
    "unit": unit,
    "pr": int(pr),
    "issue": int(issue) if issue else (sorted(list(all_issues))[0] if all_issues else None),
    "issues": sorted(list(all_issues)),
    "recorded_at": datetime.datetime.now(datetime.timezone.utc).isoformat()
}
# Idempotent upsert keyed on (unit, pr, issue): re-recording the same unit
# updates the existing entry instead of appending a duplicate (#325).
key = (record_entry["unit"], record_entry["pr"], record_entry["issue"])
replaced = 0
for i, existing in enumerate(records):
    if (existing.get("unit"), existing.get("pr"), existing.get("issue")) == key:
        records[i] = record_entry
        replaced = 1
        break
if not replaced:
    records.append(record_entry)
with open(reg_file, "w") as f:
    json.dump(data, f, indent=2)
verb = "Updated" if replaced else "Recorded"
print(f"{verb} Unit {unit} -> PR #{pr} (issues: {sorted(list(all_issues))}) in {reg_file}")
' "$REGISTRY_FILE" "$unit" "$pr" "$issue" "$issues_str"
  else
    echo "Recorded Unit $unit -> PR #$pr (registry uninitialized)"
  fi
  exit 0
}

