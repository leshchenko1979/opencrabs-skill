#!/usr/bin/env python3
"""
tools/oc-issue-dispatch — mechanized fork issue vetting, lane selection, and dispatch.

Usage:
  oc-issue-dispatch --auto [--dry-run] [--repo <path>] [--ledger <file>]
  oc-issue-dispatch <issue-number> [--to <session-uuid>] [--dry-run] [--repo <path>] [--ledger <file>]
  oc-issue-dispatch --selftest
  oc-issue-dispatch --help

Exit codes:
  0: Success / Approved / Dispatched
  1: Rejected / Vetting failed
  2: Invalid arguments / CLI error
  3: Delivery / session_notify failed
  4: Capacity exhausted / No available idle lane
"""

import os
import sys
import json
import re
import argparse
import subprocess
import shutil
import sqlite3
import time
import datetime
import tempfile
import fcntl
import signal

TOOL_DIR = os.path.dirname(os.path.abspath(__file__))
